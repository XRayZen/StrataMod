#include "roles.hpp"
#include <cstring>
#include <stdexcept>
namespace strata_ext::device {
namespace {
void need(bool b,const char* s){if(!b)throw std::runtime_error(s);}
void hip(hipError_t e){if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));}
struct On {int previous=-1;explicit On(int d){hip(hipGetDevice(&previous));hip(hipSetDevice(d));}~On(){if(previous>=0)hipSetDevice(previous);} };
std::string hex(const char* p,size_t n){static const char* d="0123456789abcdef";std::string s;for(size_t i=0;i<n;++i){auto b=static_cast<unsigned char>(p[i]);s+=d[b>>4];s+=d[b&15];}return s;}
void endpoint(const Endpoint& e){need(e.pointer&&e.capacity&&e.stream&&e.slot&&e.owner&&e.slot->owner==e.owner&&e.slot->address==reinterpret_cast<uintptr_t>(e.pointer)&&e.capacity<=e.slot->capacity&&e.generation==e.slot->generation,"endpoint ownership/extent/generation");On on(e.device);hipDeviceptr_t base=nullptr;size_t allocated=0;hip(hipMemGetAddressRange(&base,&allocated,reinterpret_cast<hipDeviceptr_t>(e.pointer)));auto address=reinterpret_cast<uintptr_t>(e.pointer),start=reinterpret_cast<uintptr_t>(base);need(address>=start&&address-start<=allocated&&e.capacity<=allocated-(address-start),"actual endpoint allocation extent");hipPointerAttribute_t a{};hip(hipPointerGetAttributes(&a,e.pointer));int d=-1;hip(hipStreamGetDevice(e.stream,&d));need(a.type==hipMemoryTypeDevice&&a.device==e.device&&d==e.device,"endpoint device/stream mismatch");}
}
ReturnDisposition return_disposition(int recorded,int drained){return recorded==0?ReturnDisposition::Recorded:drained==0?ReturnDisposition::Drained:ReturnDisposition::Retain;}
void check_extent(uint64_t n,uint64_t capacity){need(n<=capacity,"transfer exceeds capacity");}
std::vector<Physical> inventory(){int n=0;hip(hipGetDeviceCount(&n));std::vector<Physical> out;for(int i=0;i<n;++i){Physical p;p.ordinal=i;char pci[64]{};hip(hipDeviceGetPCIBusId(pci,sizeof(pci),i));p.pci=pci;hipDeviceProp_t a{};p.property_status=int(hipGetDeviceProperties(&a,i));if(!p.property_status){p.name=a.name;p.arch=a.gcnArchName;}else hipGetLastError();hipUUID u{};p.uuid_status=int(hipDeviceGetUuid(&u,i));if(!p.uuid_status)p.uuid=hex(u.bytes,sizeof(u.bytes));else hipGetLastError();char luid[8]{};unsigned mask=0;p.luid_status=int(hipDeviceGetLuid(luid,&mask,i));if(!p.luid_status)p.luid=hex(luid,sizeof(luid));else hipGetLastError();out.push_back(p);}return out;}
Roles resolve(const std::vector<Physical>& devices,const std::string& primary,const std::optional<std::string>& secondary){auto find=[&](const std::string& id){const Physical* found=nullptr;for(auto& p:devices)if(p.pci==id){need(!found,"ambiguous physical identity");found=&p;}need(found,"physical identity absent");return *found;};Roles r{find(primary),{}};if(secondary){need(*secondary!=primary,"same physical device in both roles");r.secondary=find(*secondary);need(r.secondary->ordinal!=r.primary.ordinal,"same device ordinal in both roles");}return r;}
struct CopyTask::Impl {
 Endpoint source,destination;void* bounce;uint64_t bounce_capacity;Policy policy;
 cache::ResidentLease reader,writer,output_reader;hipEvent_t copied=nullptr,consumed=nullptr;
 TransferStats count;Phase state=Phase::Idle;bool closed=false;
 Impl(Endpoint s,Endpoint d,void* b,uint64_t c,Policy p):source(s),destination(d),bounce(b),bounce_capacity(c),policy(p){endpoint(s);endpoint(d);need(s.slot!=d.slot,"distinct source and destination regions");On on(d.device);hip(hipEventCreateWithFlags(&copied,hipEventDisableTiming));try{hip(hipEventCreateWithFlags(&consumed,hipEventDisableTiming));}catch(...){hipEventDestroy(copied);throw;}}
 void current(){int d=-1;hip(hipGetDevice(&d));need(d==destination.device,"copy current device mismatch");}
 bool event(hipEvent_t e){auto x=hipEventQuery(e);if(x==hipErrorNotReady)return false;hip(x);return true;}
 bool drain(){On s(source.device);auto a=hipStreamSynchronize(source.stream);On d(destination.device);auto b=hipStreamSynchronize(destination.stream);return a==hipSuccess&&b==hipSuccess;}
 void release_failed(){if(drain()){if(reader.active)cache::complete_resident(reader,source.owner,true,false);if(writer.active)cache::complete_resident(writer,destination.owner,true,false);if(output_reader.active)cache::complete_resident(output_reader,destination.owner,true,false);state=Phase::Done;}else{if(reader.active)cache::quarantine_resident(reader,source.owner);if(writer.active)cache::quarantine_resident(writer,destination.owner);if(output_reader.active)cache::quarantine_resident(output_reader,destination.owner);state=Phase::Quarantined;}}
 void bounce_copy(uint64_t n){need(bounce&&n<=bounce_capacity,"host bounce capacity");{On s(source.device);hip(hipMemcpyAsync(bounce,source.pointer,n,hipMemcpyDeviceToHost,source.stream));hip(hipStreamSynchronize(source.stream));count.bounce_d2h+=n;}hip(hipMemcpyAsync(destination.pointer,bounce,n,hipMemcpyHostToDevice,destination.stream));count.bounce_h2d+=n;count.path="host-bounce";}
 bool close(){if(closed)return true;if(state!=Phase::Idle&&state!=Phase::Done)return false;On on(destination.device);if(count.owned_enable){auto result=hipDeviceDisablePeerAccess(source.device);count.disable_status=int(result);hip(result);count.owned_enable=false;}hip(hipEventDestroy(copied));hip(hipEventDestroy(consumed));closed=true;return true;}
};
CopyTask::CopyTask(Endpoint s,Endpoint d,void* b,uint64_t c,Policy p):p_(std::make_unique<Impl>(s,d,b,c,p)){}
CopyTask::~CopyTask(){if(p_&&!p_->closed&&!try_close())std::terminate();}
void CopyTask::submit(uint64_t n){auto& p=*p_;p.current();need(p.state==Phase::Idle,"one active transfer per task");check_extent(n,p.source.capacity);check_extent(n,p.destination.capacity);if(p.source.device==p.destination.device&&n){auto a=reinterpret_cast<uintptr_t>(p.source.pointer),b=reinterpret_cast<uintptr_t>(p.destination.pointer);need((a<=b?b-a:a-b)>=n,"overlapping transfer byte regions");}need(p.source.generation==p.source.slot->generation&&p.destination.generation==p.destination.slot->generation,"endpoint generation changed");p.count.bytes=n;if(!n){p.state=Phase::Done;return;}auto r=cache::borrow_resident(*p.source.slot,p.source.owner);need(bool(r),"source reader unavailable");p.reader=std::move(*r);auto w=cache::reserve_fill(*p.destination.slot,p.destination.owner,n);if(!w){cache::complete_resident(p.reader,p.source.owner,true,false);throw std::runtime_error("destination writer unavailable");}p.writer=std::move(*w);
 try{if(p.source.device==p.destination.device){hip(hipMemcpyAsync(p.destination.pointer,p.source.pointer,n,hipMemcpyDeviceToDevice,p.destination.stream));p.count.local_d2d=n;p.count.path="local";}else if(p.policy==Policy::HostBounce){p.bounce_copy(n);}else{
  int can=-1;p.count.capability_status=int(hipDeviceCanAccessPeer(&can,p.destination.device,p.source.device));if(!p.count.capability_status)p.count.can_access=can;else hipGetLastError();
  bool peer=false;if(p.count.capability_status==0&&can){auto e=hipDeviceEnablePeerAccess(p.source.device,0);p.count.enable_status=int(e);p.count.owned_enable=e==hipSuccess;peer=e==hipSuccess||e==hipErrorPeerAccessAlreadyEnabled;if(e!=hipSuccess)hipGetLastError();}
  if(peer){On source(p.source.device);hip(hipStreamSynchronize(p.source.stream));On destination(p.destination.device);auto e=hipMemcpyPeerAsync(p.destination.pointer,p.destination.device,p.source.pointer,p.source.device,n,p.destination.stream);p.count.peer_copy_status=int(e);if(e==hipSuccess){p.count.peer_bytes=n;p.count.path="peer";}else{hipGetLastError();need(p.drain(),"failed peer copy not drained");p.bounce_copy(n);}}
  else p.bounce_copy(n);
 }hip(hipEventRecord(p.copied,p.destination.stream));p.state=Phase::CopyPending;}catch(...){p.count.cancelled=true;p.release_failed();throw;}}
void CopyTask::poll(){auto& p=*p_;p.current();if(p.state==Phase::CopyPending&&p.event(p.copied)){need(p.reader.generation==p.source.slot->generation&&p.writer.generation==p.destination.slot->generation,"copy completion generation");cache::complete_resident(p.reader,p.source.owner,true,false);cache::complete_resident(p.writer,p.destination.owner,true,!p.count.cancelled);if(p.count.cancelled)p.state=Phase::Done;else{auto held=cache::borrow_resident(*p.destination.slot,p.destination.owner);need(bool(held),"destination last-use reader");p.output_reader=std::move(*held);p.state=Phase::Ready;}}if(p.state==Phase::ConsumerPending&&p.event(p.consumed)){cache::complete_resident(p.output_reader,p.destination.owner,true,!p.count.cancelled);p.state=Phase::Done;}}
void CopyTask::consumer_done_on(hipStream_t stream){auto& p=*p_;p.current();need(p.state==Phase::Ready&&p.output_reader.active,"destination not ready/already returned");int d=-1;hip(hipStreamGetDevice(stream,&d));need(d==p.destination.device,"consumer stream device mismatch");auto recorded=hipEventRecord(p.consumed,stream);p.count.return_record_status=int(recorded);if(return_disposition(int(recorded),-1)==ReturnDisposition::Recorded){p.state=Phase::ConsumerPending;return;}p.count.cancelled=true;auto drained=hipStreamSynchronize(stream);p.count.return_drain_status=int(drained);if(return_disposition(int(recorded),int(drained))==ReturnDisposition::Drained){cache::complete_resident(p.output_reader,p.destination.owner,true,false);p.state=Phase::Done;}else{cache::quarantine_resident(p.output_reader,p.destination.owner);p.state=Phase::Quarantined;}hip(recorded);}
void CopyTask::cancel(){auto& p=*p_;p.current();p.count.cancelled=true;if(p.state==Phase::Idle)p.state=Phase::Done;/* Ready retains output_reader until the caller returns its actual last-use stream. */}
bool CopyTask::try_close(){return p_->close();}
Phase CopyTask::phase()const{return p_->state;}
TransferStats CopyTask::stats()const{return p_->count;}
uint64_t CopyTask::metadata_bytes(){return sizeof(CopyTask)+sizeof(Impl);}
}
