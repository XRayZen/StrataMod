#include "kv.hpp"
#include "../../native/quant/quant.hpp"
#include <hip/hip_runtime.h>
#include <algorithm>
#include <cmath>
#include <cstring>
#include <limits>
#include <cstdio>
#include <cstdlib>
namespace strata_ext::deepseek41 {
namespace {
void check(hipError_t e){if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));}
thread_local uint64_t live=0,peak=0;thread_local bool failed=false;
struct Buffer {void*p=nullptr;size_t bytes;explicit Buffer(size_t n):bytes(n){if(!n)throw std::runtime_error("empty KV device allocation");check(hipMalloc(&p,n));live+=n;peak=std::max(peak,live);}~Buffer(){if(p){auto e=hipFree(p);if(e==hipSuccess)live-=bytes;else failed=true;}}};
void begin(){if(live)throw std::runtime_error("KV previous cleanup unknown");peak=0;failed=false;}
void finish(KvTrace&t){t.scratch_peak=peak;t.cleanup_unknown=failed||live;if(t.cleanup_unknown)throw std::runtime_error("KV cleanup unknown");}
void done(){check(hipGetLastError());check(hipDeviceSynchronize());}
void finite(const std::vector<float>&v){for(float x:v)if(!std::isfinite(x))throw std::runtime_error("nonfinite KV input");}
template<class T>void put(KvTrace&t,const std::string&name,const std::vector<T>&v,uint64_t rows,uint64_t columns,const char*dtype){if(!columns||rows>SIZE_MAX/columns||rows*columns!=v.size()||t.stages.count(name))throw std::runtime_error("KV trace geometry");KvStage s;s.dtype=dtype;s.rows=rows;s.columns=columns;s.bytes.resize(v.size()*sizeof(T));if(!v.empty())std::memcpy(s.bytes.data(),v.data(),s.bytes.size());t.stages.emplace(name,std::move(s));}
void putf(KvTrace&t,const std::string&n,const std::vector<float>&v,uint64_t r,uint64_t c){put(t,n,v,r,c,"<f4");}
template<class T>std::vector<T> values(const KvStage&s){if(s.bytes.size()%sizeof(T))throw std::runtime_error("KV stage type");std::vector<T>v(s.bytes.size()/sizeof(T));if(!v.empty())std::memcpy(v.data(),s.bytes.data(),s.bytes.size());return v;}
__device__ float bf(float x){auto u=__float_as_uint(x);return __uint_as_float(((u+0x7fff+((u>>16)&1))>>16)<<16);}
__global__ void bf_kernel(const float*x,float*y,size_t n){size_t i=blockIdx.x*blockDim.x+threadIdx.x;if(i<n)y[i]=bf(x[i]);}
std::vector<float> bf_gpu(const std::vector<float>&x){if(x.empty())return {};finite(x);Buffer in(x.size()*4),out(x.size()*4);if(std::getenv("T14_DIAGNOSTIC"))std::fprintf(stderr,"bf-allocated\n");check(hipMemcpy(in.p,x.data(),in.bytes,hipMemcpyHostToDevice));if(std::getenv("T14_DIAGNOSTIC"))std::fprintf(stderr,"bf-uploaded\n");bf_kernel<<<(x.size()+255)/256,256>>>((float*)in.p,(float*)out.p,x.size());if(std::getenv("T14_DIAGNOSTIC"))std::fprintf(stderr,"bf-launched\n");done();if(std::getenv("T14_DIAGNOSTIC"))std::fprintf(stderr,"bf-done\n");std::vector<float>y(x.size());check(hipMemcpy(y.data(),out.p,out.bytes,hipMemcpyDeviceToHost));return y;}
__device__ float e4(unsigned code){unsigned e=code>>3,m=code&7;return e?ldexpf(1.f+float(m)/8.f,int(e)-7):float(m)/512.f;}
__device__ float e2(unsigned code){const float t[8]={0,.5f,1,1.5f,2,3,4,6};return t[code];}
__device__ unsigned narrow(float x,bool fp4){float a=fminf(fabsf(x),fp4?6.f:448.f);unsigned last=fp4?7:126,lo=0,hi=last;while(lo<hi){unsigned mid=(lo+hi)/2;if((fp4?e2(mid):e4(mid))<a)lo=mid+1;else hi=mid;}unsigned high=lo,low=high?high-1:0;float dh=(fp4?e2(high):e4(high))-a,dl=a-(fp4?e2(low):e4(low));unsigned code=(dh<dl||(dh==dl&&!(high&1)))?high:low;return code|(signbit(x)?(fp4?8:128):0);}
__global__ void quantize_kernel(const float*x,float*y,uint8_t*codes,uint8_t*scales,uint8_t*packed,size_t groups,bool fp4){size_t g=blockIdx.x*blockDim.x+threadIdx.x;if(g>=groups)return;unsigned width=fp4?16:32;uint8_t local[32];float a=0.f;for(unsigned j=0;j<width;++j)a=fmaxf(a,fabsf(bf(x[g*width+j])));float scale;
 if(fp4){a=fmaxf(a,6.f/512.f);unsigned code=narrow(a/6.f,false);if(scales)scales[g]=code;scale=e4(code);}
 else{a=fmaxf(a,1.e-4f);float n=a*(1.f/448.f);unsigned u=__float_as_uint(n);int exponent=int((u>>23)&255)-127+((u&0x7fffff)!=0);scale=ldexpf(1.f,exponent);if(scales)scales[g]=exponent+127;}
 for(unsigned j=0;j<width;++j){float v=fminf(fmaxf(bf(x[g*width+j])/scale,fp4?-6.f:-448.f),fp4?6.f:448.f);unsigned c=narrow(v,fp4);local[j]=c;if(codes)codes[g*width+j]=c;float decoded=fp4?e2(c&7):e4(c&127);if(c&(fp4?8:128))decoded=-decoded;y[g*width+j]=bf(decoded*scale);}
 if(fp4&&packed)for(unsigned j=0;j<8;++j)packed[g*8+j]=local[2*j]|(local[2*j+1]<<4);
}
struct Narrow {std::vector<float>decoded;std::vector<uint8_t>codes,scales,packed;};
Narrow quantize(const std::vector<float>&x,unsigned width,bool fp4){if(!width||x.size()%width||width%(fp4?16:32))throw std::runtime_error("KV quant geometry");finite(x);Narrow y;y.decoded.resize(x.size());y.codes.resize(x.size());y.scales.resize(x.size()/(fp4?16:32));if(fp4)y.packed.resize(x.size()/2);if(x.empty())return y;Buffer in(x.size()*4),out(x.size()*4),codes(x.size()),scales(y.scales.size()),packed(fp4?x.size()/2:1);check(hipMemcpy(in.p,x.data(),in.bytes,hipMemcpyHostToDevice));quantize_kernel<<<(y.scales.size()+63)/64,64>>>((float*)in.p,(float*)out.p,(uint8_t*)codes.p,(uint8_t*)scales.p,(uint8_t*)packed.p,y.scales.size(),fp4);done();check(hipMemcpy(y.decoded.data(),out.p,out.bytes,hipMemcpyDeviceToHost));check(hipMemcpy(y.codes.data(),codes.p,codes.bytes,hipMemcpyDeviceToHost));check(hipMemcpy(y.scales.data(),scales.p,scales.bytes,hipMemcpyDeviceToHost));if(fp4)check(hipMemcpy(y.packed.data(),packed.p,packed.bytes,hipMemcpyDeviceToHost));return y;}
void putq(KvTrace&t,const std::string&prefix,const Narrow&v,unsigned rows,unsigned width,bool fp4){putf(t,prefix+"decoded",v.decoded,rows,width);put(t,prefix+"codes",v.codes,rows,width,"|u1");put(t,prefix+"scales",v.scales,rows,width/(fp4?16:32),"|u1");if(fp4)put(t,prefix+"packed",v.packed,rows,width/2,"|u1");}
__global__ void norm_kernel(const float*x,const float*w,float*y,float*inv,unsigned rows){unsigned r=blockIdx.x*blockDim.x+threadIdx.x;if(r>=rows)return;float sum=0.f;for(unsigned j=0;j<512;++j){float v=x[size_t(r)*512+j];float square=v*v;sum=sum+square;}float inverse=1.f/sqrtf(sum/512.f+1.e-20f);if(inv)inv[r]=inverse;for(unsigned j=0;j<512;++j){float v=x[size_t(r)*512+j]*inverse;y[size_t(r)*512+j]=bf(v*w[j]);}}
std::pair<std::vector<float>,std::vector<float>> norm(const std::vector<float>&x,const std::vector<float>&w){if(x.size()%512||w.size()!=512)throw std::runtime_error("KV norm geometry");finite(x);finite(w);std::vector<float>y(x.size()),inv(x.size()/512);if(x.empty())return {y,inv};Buffer in(x.size()*4),weight(2048),out(x.size()*4),iv(inv.size()*4);check(hipMemcpy(in.p,x.data(),in.bytes,hipMemcpyHostToDevice));check(hipMemcpy(weight.p,w.data(),weight.bytes,hipMemcpyHostToDevice));norm_kernel<<<(inv.size()+63)/64,64>>>((float*)in.p,(float*)weight.p,(float*)out.p,(float*)iv.p,inv.size());done();check(hipMemcpy(y.data(),out.p,out.bytes,hipMemcpyDeviceToHost));check(hipMemcpy(inv.data(),iv.p,iv.bytes,hipMemcpyDeviceToHost));return {y,inv};}
__global__ void pool_kernel(const float*kv,const float*score,float*y,size_t n){size_t k=blockIdx.x*blockDim.x+threadIdx.x;if(k>=n)return;size_t r=k/512,j=k%512;float a=score[r*1024+j],b=score[r*1024+512+j],m=fmaxf(a,b);float ea=float(exp(double(a-m))),eb=float(exp(double(b-m))),den=ea+eb;float p0=kv[r*1024+j]*(ea/den),p1=kv[r*1024+512+j]*(eb/den);y[k]=(0.f+p0)+p1;}
std::vector<float> pool(const std::vector<float>&kv,const std::vector<float>&score){if(kv.size()%1024||kv.size()!=score.size())throw std::runtime_error("KV pool geometry");finite(kv);finite(score);std::vector<float>y(kv.size()/2);if(y.empty())return y;Buffer k(kv.size()*4),s(score.size()*4),out(y.size()*4);check(hipMemcpy(k.p,kv.data(),k.bytes,hipMemcpyHostToDevice));check(hipMemcpy(s.p,score.data(),s.bytes,hipMemcpyHostToDevice));pool_kernel<<<(y.size()+255)/256,256>>>((float*)k.p,(float*)s.p,(float*)out.p,y.size());done();check(hipMemcpy(y.data(),out.p,out.bytes,hipMemcpyDeviceToHost));return y;}
__global__ void frequency_kernel(float*out,int ratio){unsigned j=threadIdx.x;if(j>=32)return;float theta=ratio?160000.f:10000.f;float exponent=float(j*2)/64.f;float power=float(pow(double(theta),double(exponent)));float f=1.f/power;if(ratio){double low0=floor(64.*log(65536./(32.*2.*3.141592653589793))/(2.*log(160000.)));double high0=ceil(64.*log(65536./(1.*2.*3.141592653589793))/(2.*log(160000.)));float low=float(fmax(low0,0.)),high=float(fmin(high0,63.));float ramp=fminf(fmaxf((float(j)-low)/fmaxf(high-low,.001f),0.f),1.f);float smooth=1.f-ramp;f=(f/16.f)*(1.f-smooth)+f*smooth;}out[j]=f;}
__global__ void rope_kernel(const float*x,const int64_t*positions,const float*freq,float*y,size_t n,bool inverse){size_t k=blockIdx.x*blockDim.x+threadIdx.x;if(k>=n)return;unsigned d=k%512,r=k/512;if(d<448){y[k]=bf(x[k]);return;}unsigned j=(d-448)/2;float angle=float(positions[r])*freq[j],c=float(cos(double(angle))),s=float(sin(double(angle)));if(inverse)s=-s;float a=bf(x[size_t(r)*512+448+j*2]),b=bf(x[size_t(r)*512+449+j*2]);if(!(d&1)){float p=a*c,q=b*s;y[k]=bf(p-q);}else{float p=a*s,q=b*c;y[k]=bf(p+q);}}
std::pair<std::vector<float>,std::vector<float>> rotate(const std::vector<float>&x,const std::vector<int64_t>&positions,int ratio,bool inverse=false){if(x.size()!=positions.size()*512||(ratio!=0&&ratio!=1&&ratio!=2)||std::any_of(positions.begin(),positions.end(),[](int64_t p){return p<0;}))throw std::runtime_error("KV rotary geometry");finite(x);Buffer f(128);frequency_kernel<<<1,32>>>((float*)f.p,ratio);done();std::vector<float>freq(32),y(x.size());check(hipMemcpy(freq.data(),f.p,128,hipMemcpyDeviceToHost));if(x.empty())return {y,freq};Buffer in(x.size()*4),pos(positions.size()*8),out(x.size()*4);check(hipMemcpy(in.p,x.data(),in.bytes,hipMemcpyHostToDevice));check(hipMemcpy(pos.p,positions.data(),pos.bytes,hipMemcpyHostToDevice));rope_kernel<<<(x.size()+255)/256,256>>>((float*)in.p,(int64_t*)pos.p,(float*)f.p,(float*)out.p,x.size(),inverse);done();check(hipMemcpy(y.data(),out.p,out.bytes,hipMemcpyDeviceToHost));return {y,freq};}
std::vector<float> weight_float(const KvWeights&w,const std::string&name){const auto&v=w.at(name);if(v.original.span.type_id!=0||v.packed.size()!=2048)throw std::runtime_error("KV norm weight");std::vector<float>out(512);std::memcpy(out.data(),v.packed.data(),2048);return out;}
std::vector<float> project(const KvWeights&w,const std::string&name,const std::vector<float>&x,unsigned batch,KvTrace&t,const measurement::Identity&id,const std::string&device){const auto&a=w.at(name);if(a.original.span.type_id!=8||a.original.span.dims_ggml!=std::vector<uint64_t>{5120,512}||a.packed.size()!=2785280)throw std::runtime_error("KV matrix source/shape/type");auto y=quant::project(a.packed,8,512,5120,batch,x);uint64_t bytes=a.packed.size()+x.size()*4+y.size()*4;measurement::LedgerSnapshot ledger;ledger.identity=id;ledger.owned_host=bytes;ledger.devices.push_back({device,bytes});(void)measurement::owned_total(ledger);t.primitive_peak=std::max(t.primitive_peak,bytes);return y;}
const std::array<int,4> writers={2,8,14,20};
unsigned wi(int s){auto it=std::find(writers.begin(),writers.end(),s);if(it==writers.end())throw std::runtime_error("KV unknown writer");return unsigned(it-writers.begin());}
int source(int layer){if(layer<0||layer>=40)throw std::runtime_error("KV layer range");if(layer<2)return -1;int s=2;for(int v:writers)if(v<=layer)s=v;return s;}
std::vector<int32_t> indices(uint64_t count,uint64_t start){if(!count||(start&&count!=1)||count>SIZE_MAX/128||start>INT32_MAX||count>INT32_MAX)throw std::runtime_error("KV window index geometry");std::vector<int32_t>v(count*std::min<uint64_t>(count,128));if(!start){unsigned width=std::min<uint64_t>(count,128);for(uint64_t p=0;p<count;++p)for(unsigned j=0;j<width;++j){int64_t k=std::max<int64_t>(int64_t(p)-127,0)+j;v[p*width+j]=k>int64_t(p)?-1:int32_t(k);}}else{v.resize(128);unsigned oldest=start%128+1;for(unsigned j=0;j<128;++j){unsigned k=(oldest+j)%128;v[j]=k>start?-1:k;}}return v;}
}
KvTrace kv_project(const std::vector<float>&input,uint32_t batch,const KvWeights&w,const measurement::Identity&id,const std::string&device){if(!batch||input.size()!=size_t(batch)*5120)throw std::runtime_error("KV projection geometry");finite(input);begin();KvTrace t;auto mark=[](const char*s){if(std::getenv("T14_DIAGNOSTIC"))std::fprintf(stderr,"%s\n",s);};mark("bf-begin");auto x=bf_gpu(input);mark("bf-ready");auto q=quantize(x,5120,false);mark("quant-ready");putf(t,"window__input",x,batch,5120);putf(t,"window__input_qdq",q.decoded,batch,5120);put(t,"window__input_codes",q.codes,batch,5120,"|u1");put(t,"window__input_scales",q.scales,batch,160,"|u1");mark("matrix-begin");auto dot=project(w,"blk.0.attn_kv.weight",q.decoded,batch,t,id,device);mark("matrix-ready");putf(t,"window__dot",dot,batch,512);auto bf=bf_gpu(dot);putf(t,"window__bf",bf,batch,512);auto normalized=norm(bf,weight_float(w,"blk.0.attn_kv_a_norm.weight"));putf(t,"window__norm",normalized.first,batch,512);putf(t,"window__inv",normalized.second,batch,1);
 for(int layer:writers){auto p="source"+std::to_string(layer)+"__",name="blk."+std::to_string(layer)+".attn_compressor_";putf(t,p+"input",x,batch,5120);auto kv=project(w,name+"kv.weight",x,batch,t,id,device);putf(t,p+"kv_dot",kv,batch,512);if(layer==20)putf(t,p+"kv_bf",bf_gpu(kv),batch,512);else putf(t,p+"score",project(w,name+"gate.weight",x,batch,t,id,device),batch,512);}
 finish(t);return t;}
KvTrace kv_temporal(const KvTrace&base,uint64_t length,uint32_t phase,const KvWeights&w){if(!length||length>SIZE_MAX/512||phase>=8)throw std::runtime_error("KV temporal geometry");auto select=[&](const std::string&name){const auto&s=base.stages.at(name);if(s.rows!=8||s.columns!=512||s.dtype!="<f4")throw std::runtime_error("actual projection8 required");auto raw=values<float>(s);std::vector<float>v(length*512);for(uint64_t r=0;r<length;++r)std::copy_n(raw.data()+((r+phase)%8)*512,512,v.data()+r*512);return v;};begin();KvTrace t;auto window=select("window__norm");std::vector<int64_t>positions(length);for(uint64_t p=0;p<length;++p)positions[p]=p;auto rotated=rotate(window,positions,0).first;auto q=quantize(rotated,512,false);putf(t,"window_pre_rope",window,length,512);putf(t,"window_post_rope",rotated,length,512);putq(t,"window_",q,length,512,false);auto ix=indices(length,0);put(t,"window_indices",ix,length,std::min<uint64_t>(length,128),"<i4");std::vector<uint8_t>rc(128*512,0),rs(128*16,0);std::vector<int64_t>rp(128,-1);for(uint64_t p=0;p<length;++p){std::copy_n(q.codes.data()+p*512,512,rc.data()+(p%128)*512);std::copy_n(q.scales.data()+p*16,16,rs.data()+(p%128)*16);rp[p%128]=p;}put(t,"ring_codes",rc,128,512,"|u1");put(t,"ring_scales",rs,128,16,"|u1");put(t,"ring_positions",rp,1,128,"<i8");
 for(int layer:writers){int ratio=layer==20?1:2;uint64_t rows=length/ratio;auto name="source"+std::to_string(layer)+"__",p="s"+std::to_string(layer)+"_";auto kv=select(name+"kv_dot");std::vector<float>before;if(ratio==2){auto score=select(name+"score");std::vector<float>k(kv.begin(),kv.begin()+rows*1024),s(score.begin(),score.begin()+rows*1024);before=bf_gpu(pool(k,s));putf(t,p+"partial_kv",std::vector<float>(kv.begin()+rows*1024,kv.end()),length%2,512);putf(t,p+"partial_score",std::vector<float>(score.begin()+rows*1024,score.end()),length%2,512);}else before=bf_gpu(kv);auto normalized=norm(before,weight_float(w,"blk."+std::to_string(layer)+".attn_compressor_norm.weight"));putf(t,p+"pre_rope",normalized.first,rows,512);putf(t,p+"inv",normalized.second,rows,1);std::vector<int64_t>pos(rows);for(uint64_t j=0;j<rows;++j)pos[j]=j*ratio;auto post=rotate(normalized.first,pos,ratio).first;putf(t,p+"post_rope",post,rows,512);putq(t,p,quantize(post,512,true),rows,512,true);std::vector<int64_t>visible(length);for(uint64_t j=0;j<length;++j)visible[j]=(j+1)/ratio;put(t,p+"visible",visible,length,1,"<i8");}
 std::vector<int64_t>events;for(int layer=0;layer<40;++layer){int s=source(layer);if(s<0)continue;uint64_t rows=length/(s==20?1:2);if(layer==s){for(int kind:{1,2}){events.insert(events.end(),{kind,layer,int64_t(rows),0,1});}}events.insert(events.end(),{3,layer,int64_t(rows),0,1});}put(t,"shared_events",events,events.size()/5,5,"<i8");finish(t);return t;}
KvTrace kv_control(const std::string&kind,const KvFloats&in,const std::vector<int64_t>&positions){begin();KvTrace t;if(kind.rfind("pool-",0)==0){putf(t,"pooled",pool(in.at("kv"),in.at("score")),1,512);}else if(kind.rfind("norm-",0)==0){auto n=norm(in.at("input"),std::vector<float>(512,1));putf(t,"output",n.first,1,512);putf(t,"inv",n.second,1,1);}else if(kind.rfind("rope",0)==0){int ratio=kind=="rope0"?0:2;auto r=rotate(in.at("input"),positions,ratio);putf(t,"output",r.first,positions.size(),512);putf(t,"inverse",rotate(in.at("input"),positions,ratio,true).first,positions.size(),512);putf(t,"frequencies",r.second,1,32);}else{bool fp4=kind.rfind("window-",0)!=0;putq(t,"",quantize(in.at("input"),512,fp4),1,512,fp4);}finish(t);return t;}
KvTrace kv_append_replay(const KvTrace&base,uint64_t length,uint32_t phase,const KvWeights&w){
 if(!length||phase>=8)throw std::runtime_error("KV append replay geometry");begin();KvTrace t;KvSequence state;state.reset(1);
 auto row=[&](const std::string&name,uint64_t p){const auto&s=base.stages.at(name);if(s.rows!=8||s.columns!=512||s.dtype!="<f4")throw std::runtime_error("KV append actual projection8");auto v=values<float>(s);return std::vector<float>(v.begin()+((p+phase)%8)*512,v.begin()+(((p+phase)%8)+1)*512);};
 auto append=[&](const std::string&name,const KvStage&s){auto it=t.stages.find(name);if(it==t.stages.end()){t.stages.emplace(name,s);return;}auto&d=it->second;if(d.dtype!=s.dtype||d.columns!=s.columns)throw std::runtime_error("KV append trace type");d.bytes.insert(d.bytes.end(),s.bytes.begin(),s.bytes.end());d.rows+=s.rows;};
 auto one=[&](const std::string&name,const std::vector<float>&v,unsigned cols){KvTrace item;putf(item,name,v,v.size()/cols,cols);append(name,item.stages.at(name));};
 std::vector<uint8_t>ring_codes(128*512,0),ring_scales(128*16,0);std::vector<int64_t>ring_positions(128,-1);std::array<std::vector<float>,3>pending_kv,pending_score;std::vector<int32_t>decode_indices;
 for(uint64_t p=0;p<length;++p){auto view=p?state.append(p,1):state.prefill(1,1);if((p&&view.kind!=KvWindowView::Kind::DecodeRing)||(!p&&view.kind!=KvWindowView::Kind::PrefillChunk))throw std::runtime_error("KV append view kind");auto ix=view.indices;ix.resize(128,-1);decode_indices.insert(decode_indices.end(),ix.begin(),ix.end());auto pre=row("window__norm",p),post=rotate(pre,{int64_t(p)},0).first;auto q=quantize(post,512,false);one("window_pre_rope",pre,512);one("window_post_rope",post,512);KvTrace narrow;putq(narrow,"window_",q,1,512,false);for(auto&[name,s]:narrow.stages)append(name,s);std::copy(q.codes.begin(),q.codes.end(),ring_codes.begin()+(p%128)*512);std::copy(q.scales.begin(),q.scales.end(),ring_scales.begin()+(p%128)*16);ring_positions[p%128]=p;
  for(unsigned i=0;i<4;++i){int layer=writers[i],ratio=i==3?1:2;auto prefix="s"+std::to_string(layer)+"_",name="source"+std::to_string(layer)+"__";auto k=row(name+"kv_dot",p);std::vector<float>before;
   if(ratio==2){auto score=row(name+"score",p);if(!(p%2)){pending_kv[i]=std::move(k);pending_score[i]=std::move(score);}else{auto a=std::move(pending_kv[i]),b=std::move(pending_score[i]);a.insert(a.end(),k.begin(),k.end());b.insert(b.end(),score.begin(),score.end());before=bf_gpu(pool(a,b));pending_kv[i].clear();pending_score[i].clear();}}
   else before=bf_gpu(k);
   if(!before.empty()){auto normalized=norm(before,weight_float(w,"blk."+std::to_string(layer)+".attn_compressor_norm.weight"));one(prefix+"pre_rope",normalized.first,512);one(prefix+"inv",normalized.second,1);int64_t pos=int64_t((p+1)/ratio-1)*ratio;auto r=rotate(normalized.first,{pos},ratio).first;one(prefix+"post_rope",r,512);KvTrace item;putq(item,prefix,quantize(r,512,true),1,512,true);for(auto&[n,s]:item.stages)append(n,s);}
   state.publish(layer,state.rows(layer),1);for(int consumer=layer;consumer<(i==3?40:writers[i+1]);++consumer)if(state.read(consumer,1)!=state.rows(layer))throw std::runtime_error("KV append alias rows");
  }
 }
 for(unsigned i=0;i<4;++i){int layer=writers[i],ratio=i==3?1:2;auto prefix="s"+std::to_string(layer)+"_";if(i<3){putf(t,prefix+"partial_kv",pending_kv[i],length%2,512);putf(t,prefix+"partial_score",pending_score[i],length%2,512);}if(length<2&&i<3){putf(t,prefix+"pre_rope",{},0,512);putf(t,prefix+"post_rope",{},0,512);putf(t,prefix+"inv",{},0,1);putq(t,prefix,Narrow{},0,512,true);}std::vector<int64_t>visible(length);for(uint64_t p=0;p<length;++p)visible[p]=(p+1)/ratio;put(t,prefix+"visible",visible,length,1,"<i8");}
 put(t,"append_decode_indices",decode_indices,length,128,"<i4");put(t,"ring_codes",ring_codes,128,512,"|u1");put(t,"ring_scales",ring_scales,128,16,"|u1");put(t,"ring_positions",ring_positions,1,128,"<i8");auto ix=indices(length,0);put(t,"window_indices",ix,length,std::min<uint64_t>(length,128),"<i4");
 // Audit records describe the final per-layer alias view, independently of
 // incremental execution order. No payload is copied by shared readers.
 std::vector<int64_t>events;for(int layer=0;layer<40;++layer){int s=source(layer);if(s<0)continue;uint64_t rows=length/(s==20?1:2);if(layer==s)for(int kind:{1,2})events.insert(events.end(),{kind,layer,int64_t(rows),0,1});events.insert(events.end(),{3,layer,int64_t(rows),0,1});}put(t,"shared_events",events,events.size()/5,5,"<i8");finish(t);return t;
}
void KvSequence::reset(uint64_t e){if(!e)throw std::runtime_error("KV epoch zero");epoch_=e;position_=0;active_=true;rows_.fill(0);pending_.fill(false);writer_=-1;published_=0;}
KvWindowView KvSequence::prefill(uint64_t count,uint64_t e){if(!active_||e!=epoch_||position_||!count)throw std::runtime_error("KV prefill state");auto ix=indices(count,0);position_=count;for(unsigned i=0;i<4;++i)rows_[i]=count/(i==3?1:2);pending_.fill(count%2);writer_=-1;return {KvWindowView::Kind::PrefillChunk,0,count,std::move(ix)};}
KvWindowView KvSequence::append(uint64_t p,uint64_t e){if(!active_||e!=epoch_||p!=position_||p==UINT64_MAX)throw std::runtime_error("KV append state");auto ix=indices(1,p);++position_;for(unsigned i=0;i<4;++i)rows_[i]=position_/(i==3?1:2);pending_.fill(position_%2);writer_=-1;return {KvWindowView::Kind::DecodeRing,p,128,std::move(ix)};}
void KvSequence::publish(int writer,uint64_t rows,uint64_t e){unsigned i=wi(writer);if(!active_||e!=epoch_||rows!=rows_[i])throw std::runtime_error("KV publish stale/source/rows");writer_=writer;published_=rows;}
uint64_t KvSequence::read(int layer,uint64_t e)const{int s=source(layer);if(!active_||e!=epoch_||s<0||writer_!=s)throw std::runtime_error("KV stale/wrong shared source");return published_;}
void KvSequence::cancel(uint64_t e){if(!active_||e!=epoch_)throw std::runtime_error("KV cancel epoch");active_=false;writer_=-1;pending_.fill(false);}
void KvSequence::reuse_exact_prefix(uint64_t e){if(!active_||e<=epoch_)throw std::runtime_error("KV exact prefix reuse epoch");epoch_=e;writer_=-1;}
uint64_t KvSequence::rows(int s)const{return rows_[wi(s)];}bool KvSequence::pending(int s)const{unsigned i=wi(s);if(i==3)return false;return pending_[i];}
namespace {
void kdv(const DeviceView&v,int device,uint64_t rows,uint64_t cols,DeviceScalar type){validate_device_view(v,device);if(v.rows!=rows||v.columns!=cols||v.scalar!=type)throw std::runtime_error("KV device scalar/geometry");}
void kfloat(const DeviceView&v,int device,uint64_t rows,uint64_t cols){validate_device_view(v,device);if(v.rows!=rows||v.columns!=cols||(v.scalar!=DeviceScalar::Float32&&v.scalar!=DeviceScalar::Bfloat16InFloat32))throw std::runtime_error("KV device float geometry");}
hipStream_t ks(void*s,int d){check_device_stream(s,d);return reinterpret_cast<hipStream_t>(s);}
}
void kv_quantize_device(const DeviceView&x,const DeviceView&out,bool fp4,void*stream,DeviceView*scales,DeviceView*codes,DeviceView*packed){auto b=x.rows,w=x.columns;unsigned block=fp4?16:32;kfloat(x,x.device,b,w);kdv(out,x.device,b,w,DeviceScalar::Bfloat16InFloat32);if(w%block)throw std::runtime_error("KV activation block row geometry");if(scales)kdv(*scales,x.device,b,w/block,DeviceScalar::UInt8);if(codes)kdv(*codes,x.device,b,w,DeviceScalar::UInt8);if(packed){if(!fp4)throw std::runtime_error("FP8 has no nibble packed view");kdv(*packed,x.device,b,w/2,DeviceScalar::UInt8);}auto n=b*w/block;quantize_kernel<<<(n+63)/64,64,0,ks(stream,x.device)>>>((float*)x.data,(float*)out.data,codes?(uint8_t*)codes->data:nullptr,scales?(uint8_t*)scales->data:nullptr,packed?(uint8_t*)packed->data:nullptr,n,fp4);check(hipGetLastError());}
void kv_norm_device(const DeviceView&x,const DeviceView&w,const DeviceView&out,void*stream,DeviceView*inverse){kfloat(x,x.device,x.rows,512);kdv(w,x.device,1,512,DeviceScalar::Float32);kdv(out,x.device,x.rows,512,DeviceScalar::Bfloat16InFloat32);if(inverse)kdv(*inverse,x.device,x.rows,1,DeviceScalar::Float32);if(x.rows>UINT32_MAX)throw std::runtime_error("KV norm launch wave");norm_kernel<<<(x.rows+63)/64,64,0,ks(stream,x.device)>>>((float*)x.data,(float*)w.data,(float*)out.data,inverse?(float*)inverse->data:nullptr,unsigned(x.rows));check(hipGetLastError());}
void kv_pool_device(const DeviceView&kv,const DeviceView&score,const DeviceView&out,void*stream){kfloat(kv,kv.device,kv.rows,1024);kfloat(score,kv.device,kv.rows,1024);kdv(out,kv.device,kv.rows,512,DeviceScalar::Float32);auto n=kv.rows*512;pool_kernel<<<(n+255)/256,256,0,ks(stream,kv.device)>>>((float*)kv.data,(float*)score.data,(float*)out.data,n);check(hipGetLastError());}
void kv_frequency_device(const DeviceView&out,bool compressed,void*stream){kdv(out,out.device,1,32,DeviceScalar::Float32);frequency_kernel<<<1,32,0,ks(stream,out.device)>>>((float*)out.data,compressed?2:0);check(hipGetLastError());}
void kv_rope_device(const DeviceView&x,const DeviceView&pos,const DeviceView&freq,const DeviceView&out,bool inverse,void*stream){kfloat(x,x.device,x.rows,512);kdv(pos,x.device,x.rows,1,DeviceScalar::Int64);kdv(freq,x.device,1,32,DeviceScalar::Float32);kdv(out,x.device,x.rows,512,DeviceScalar::Bfloat16InFloat32);auto n=x.rows*512;rope_kernel<<<(n+255)/256,256,0,ks(stream,x.device)>>>((float*)x.data,(int64_t*)pos.data,(float*)freq.data,(float*)out.data,n,inverse);check(hipGetLastError());}

}
