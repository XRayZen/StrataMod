#include "attention.hpp"
#include "../../native/quant/quant.hpp"
#include <hip/hip_runtime.h>
#include <algorithm>
#include <cmath>
#include <cstring>
#include <limits>
namespace strata_ext::deepseek41 {
namespace {
void ck(hipError_t s){if(s!=hipSuccess)throw std::runtime_error(hipGetErrorString(s));}
thread_local uint64_t live=0,peak=0;
struct Memory {
 void*p=nullptr;size_t n;explicit Memory(size_t bytes):n(bytes){if(!n)throw std::runtime_error("empty attention allocation");ck(hipMalloc(&p,n));live+=n;peak=std::max(peak,live);}
 Memory(const Memory&)=delete;Memory&operator=(const Memory&)=delete;
 ~Memory(){if(p&&hipFree(p)==hipSuccess)live-=n;}
 void upload(const void*source){ck(hipMemcpy(p,source,n,hipMemcpyHostToDevice));}
 void download(void*destination){ck(hipMemcpy(destination,p,n,hipMemcpyDeviceToHost));}
};
void done(){ck(hipGetLastError());ck(hipDeviceSynchronize());}
void start(){if(live)throw std::runtime_error("previous attention allocation not released");peak=0;}
void finish(KvTrace&t){t.scratch_peak=std::max(t.scratch_peak,peak);t.cleanup_unknown=live!=0;if(t.cleanup_unknown)throw std::runtime_error("attention cleanup unknown");}
template<class T>void put(KvTrace&t,const std::string&name,const std::vector<T>&v,uint64_t r,uint64_t c,const char*d){if((c&&r>SIZE_MAX/c)||r*c!=v.size()||t.stages.count(name))throw std::runtime_error("attention trace geometry");KvStage s;s.rows=r;s.columns=c;s.dtype=d;s.bytes.resize(v.size()*sizeof(T));if(!v.empty())std::memcpy(s.bytes.data(),v.data(),s.bytes.size());t.stages.emplace(name,std::move(s));}
void pf(KvTrace&t,const std::string&n,const std::vector<float>&v,uint64_t r,uint64_t c){put(t,n,v,r,c,"<f4");}
template<class T>std::vector<T> data(const KvStage&s){if(s.bytes.size()%sizeof(T))throw std::runtime_error("attention scalar type");std::vector<T>v(s.bytes.size()/sizeof(T));if(!v.empty())std::memcpy(v.data(),s.bytes.data(),s.bytes.size());return v;}
void finite(const std::vector<float>&v){for(float x:v)if(!std::isfinite(x))throw std::runtime_error("nonfinite attention input");}
__device__ float bf(float x){unsigned u=__float_as_uint(x);return __uint_as_float(((u+0x7fff+((u>>16)&1))>>16)<<16);}
__global__ void bf_kernel(const float*x,float*y,size_t n,float scale){size_t i=size_t(blockIdx.x)*blockDim.x+threadIdx.x;if(i<n)y[i]=bf(x[i]*scale);}
std::vector<float> cast(const std::vector<float>&x,float scale=1.f){finite(x);std::vector<float>v(x.size());if(x.empty())return v;Memory a(x.size()*4),b(x.size()*4);a.upload(x.data());bf_kernel<<<(x.size()+255)/256,256>>>((float*)a.p,(float*)b.p,x.size(),scale);done();b.download(v.data());return v;}
__global__ void rms_kernel(const float*x,const float*w,float*y,float*inv,size_t rows,size_t width){size_t r=size_t(blockIdx.x)*blockDim.x+threadIdx.x;if(r>=rows)return;float sum=0;for(size_t d=0;d<width;++d){float z=x[r*width+d];sum=sum+z*z;}float inverse=1.f/sqrtf(sum/float(width)+1.e-20f);if(inv)inv[r]=inverse;for(size_t d=0;d<width;++d)y[r*width+d]=bf((x[r*width+d]*inverse)*w[d]);}
std::pair<std::vector<float>,std::vector<float>> rms(const std::vector<float>&x,const std::vector<float>&w){if(w.empty()||x.size()%w.size())throw std::runtime_error("attention RMS geometry");finite(x);finite(w);std::vector<float>v(x.size()),iv(x.size()/w.size());if(x.empty())return {v,iv};Memory a(x.size()*4),b(x.size()*4),c(w.size()*4),d(iv.size()*4);a.upload(x.data());c.upload(w.data());rms_kernel<<<(iv.size()+63)/64,64>>>((float*)a.p,(float*)c.p,(float*)b.p,(float*)d.p,iv.size(),w.size());done();b.download(v.data());d.download(iv.data());return {v,iv};}
__device__ float e2(unsigned c){const float values[8]={0,.5f,1,1.5f,2,3,4,6};return values[c];}
__device__ unsigned e2_code(float x){float a=fminf(fabsf(x),6.f);unsigned best=0;float distance=a;for(unsigned i=1;i<8;++i){float z=fabsf(a-e2(i));if(z<distance||(z==distance&&!(i&1))){best=i;distance=z;}}return best|(signbit(x)?8:0);}
__global__ void fp4_kernel(const float*x,float*y,uint8_t*codes,uint8_t*scales,size_t groups){size_t g=size_t(blockIdx.x)*blockDim.x+threadIdx.x;if(g>=groups)return;float a=0;for(unsigned i=0;i<32;++i)a=fmaxf(a,fabsf(bf(x[g*32+i])));a=fmaxf(a,ldexpf(6.f,-126));float p=a*(1.f/6.f);unsigned u=__float_as_uint(p);int exponent=int((u>>23)&255)-127+((u&0x7fffff)!=0);float scale=ldexpf(1.f,exponent);if(scales)scales[g]=exponent+127;for(unsigned i=0;i<32;++i){unsigned c=e2_code(bf(x[g*32+i])/scale);if(codes)codes[g*32+i]=c;float v=e2(c&7);if(c&8)v=-v;y[g*32+i]=bf(v*scale);}}
struct Narrow {std::vector<float>decoded;std::vector<uint8_t>codes,scales;};
Narrow fp4(const std::vector<float>&x){if(x.size()%32)throw std::runtime_error("index block32");finite(x);Narrow n;n.decoded.resize(x.size());n.codes.resize(x.size());n.scales.resize(x.size()/32);if(x.empty())return n;Memory a(x.size()*4),b(x.size()*4),c(x.size()),d(n.scales.size());a.upload(x.data());fp4_kernel<<<(n.scales.size()+63)/64,64>>>((float*)a.p,(float*)b.p,(uint8_t*)c.p,(uint8_t*)d.p,n.scales.size());done();b.download(n.decoded.data());c.download(n.codes.data());d.download(n.scales.data());return n;}
// Reuse the qualified FP8 and YaRN kernels without widening their public API.
// Every block is independent, so zero-padding a final 512-row chunk introduces
// no cross-block reduction and is removed from the resulting view.
Narrow fp8(const std::vector<float>&x){if(x.size()%32)throw std::runtime_error("activation block32");Narrow out;for(size_t begin=0;begin<x.size();begin+=512){size_t count=std::min<size_t>(512,x.size()-begin);std::vector<float>chunk(512);std::copy_n(x.data()+begin,count,chunk.data());auto trace=kv_control("window-attention",{{"input",chunk}},{});auto y=data<float>(trace.stages.at("decoded"));auto c=data<uint8_t>(trace.stages.at("codes"));auto s=data<uint8_t>(trace.stages.at("scales"));out.decoded.insert(out.decoded.end(),y.begin(),y.begin()+count);out.codes.insert(out.codes.end(),c.begin(),c.begin()+count);out.scales.insert(out.scales.end(),s.begin(),s.begin()+count/32);peak=std::max(peak,trace.scratch_peak);}return out;}
std::vector<float> rotate(const std::vector<float>&x,size_t width,const std::vector<int64_t>&positions,bool inverse=false){if((width!=128&&width!=512)||x.size()!=positions.size()*width)throw std::runtime_error("attention rotary view");if(x.empty())return {};std::vector<float>padded(positions.size()*512);for(size_t r=0;r<positions.size();++r)std::copy_n(x.data()+r*width,width,padded.data()+r*512+512-width);auto t=kv_control("rope2",{{"input",padded}},positions);peak=std::max(peak,t.scratch_peak);auto v=data<float>(t.stages.at(inverse?"inverse":"output"));std::vector<float>out(x.size());for(size_t r=0;r<positions.size();++r)std::copy_n(v.data()+r*512+512-width,width,out.data()+r*width);return out;}
__global__ void index_kernel(const float*q,const float*k,const float*w,float*raw,float*dot,float*relu,float*weighted,float*sum,float*score,size_t rows,size_t positions){size_t i=size_t(blockIdx.x)*blockDim.x+threadIdx.x;if(i>=rows*positions)return;size_t r=i/positions,p=i%positions;float total=0;for(unsigned h=0;h<32;++h){float acc=0;for(unsigned d=0;d<128;++d){float product=bf(q[(r*32+h)*128+d])*bf(k[p*128+d]);acc=acc+product;}size_t j=(r*32+h)*positions+p;if(raw)raw[j]=acc;float b=bf(acc),v=fmaxf(b,0.f),z=bf(v*bf(w[r*32+h]));if(dot)dot[j]=b;if(relu)relu[j]=v;if(weighted)weighted[j]=z;total=total+z;}if(sum)sum[i]=total;score[i]=bf(total);}
KvTrace index(const std::vector<float>&q,const std::vector<float>&k,const std::vector<float>&w,size_t rows){if(!rows||q.size()!=rows*4096||k.size()%128||w.size()!=rows*32)throw std::runtime_error("index geometry");finite(q);finite(k);finite(w);KvTrace t;size_t n=k.size()/128,count=rows*32*n;std::vector<float>raw(count),dot(count),relu(count),weighted(count),sum(rows*n),score(rows*n);if(n){Memory a(q.size()*4),b(k.size()*4),c(w.size()*4),d(count*4),e(count*4),f(count*4),g(count*4),h(rows*n*4),j(rows*n*4);a.upload(q.data());b.upload(k.data());c.upload(w.data());index_kernel<<<(rows*n+63)/64,64>>>((float*)a.p,(float*)b.p,(float*)c.p,(float*)d.p,(float*)e.p,(float*)f.p,(float*)g.p,(float*)h.p,(float*)j.p,rows,n);done();d.download(raw.data());e.download(dot.data());f.download(relu.data());g.download(weighted.data());h.download(sum.data());j.download(score.data());}pf(t,"dot",raw,rows,32*n);pf(t,"dot_bf16",dot,rows,32*n);pf(t,"relu",relu,rows,32*n);pf(t,"weighted",weighted,rows,32*n);pf(t,"reduced",sum,rows,n);pf(t,"score",score,rows,n);return t;}
}
bool index_candidate_pruning(int writer){if(writer!=2&&writer!=8&&writer!=14&&writer!=20)throw std::runtime_error("unknown index key writer");return writer==20;}
void AttentionIndexView::validate(int consumer,uint64_t e)const{int source=consumer>=24?20:consumer;if(!e||epoch!=e||writer!=source||(writer!=2&&writer!=8&&writer!=14&&writer!=20)||ratio!=(writer==20?1:2)||positions>SIZE_MAX/128||decoded.size()!=positions*128)throw std::runtime_error("index borrowed writer/epoch/shape");}
void AttentionCandidates::validate(uint64_t e)const{if(!e||epoch!=e||writer!=20||(positions&&queries>SIZE_MAX/positions)||mask.size()!=queries*positions||visible.size()!=queries)throw std::runtime_error("candidate borrowed writer/epoch/shape");for(auto v:visible)if(v<0||uint64_t(v)>positions)throw std::runtime_error("candidate visibility");for(auto v:mask)if(v>1)throw std::runtime_error("candidate bool");}

namespace {
__global__ void online_kernel(const float*q,const float*kv,const int64_t*ids,const float*sinks,float*out,float*scores,float*maxima,float*alphas,float*probs,float*casts,float*sums,float*accs,float*denominator,size_t heads,size_t nindices,size_t blocks,size_t kv_rows=SIZE_MAX,int*error=nullptr,const float*second=nullptr,size_t first_rows=SIZE_MAX){
 size_t h=blockIdx.x*blockDim.x+threadIdx.x;if(h>=heads)return;float maximum=-1.e30f,den=0,acc[512];for(unsigned d=0;d<512;++d)acc[d]=0;
 for(size_t b=0;b<blocks;++b){float score[64],prob[64],castp[64],newmax=maximum;
  for(unsigned j=0;j<64;++j){size_t slot=b*64+j;int64_t id=slot<nindices?ids[slot]:-1;if(id< -1||(id>=0&&uint64_t(id)>=kv_rows)){if(error)atomicOr(error,1);id=-1;}float z=-INFINITY;if(id>=0){float dot=0;for(unsigned d=0;d<512;++d){float product=bf(q[h*512+d])*bf((second&&size_t(id)>=first_rows?second[(size_t(id)-first_rows)*512+d]:kv[size_t(id)*512+d]));dot=dot+product;}z=dot*float(1./sqrt(512.));}score[j]=z;newmax=fmaxf(newmax,z);}
  float alpha=float(exp(double(maximum-newmax))),sum=0;
  for(unsigned j=0;j<64;++j){prob[j]=float(exp(double(score[j]-newmax)));castp[j]=bf(prob[j]);sum=sum+prob[j];size_t k=(b*heads+h)*64+j;if(scores)scores[k]=score[j];if(probs)probs[k]=prob[j];if(casts)casts[k]=castp[j];}
  den=den*alpha+sum;for(unsigned d=0;d<512;++d){float a=acc[d]*alpha;for(unsigned j=0;j<64;++j){size_t slot=b*64+j;int64_t id=slot<nindices?ids[slot]:-1;if(id< -1||(id>=0&&uint64_t(id)>=kv_rows)){if(error)atomicOr(error,1);id=-1;}float value=id>=0?bf((second&&size_t(id)>=first_rows?second[(size_t(id)-first_rows)*512+d]:kv[size_t(id)*512+d])):0;float product=castp[j]*value;a=a+product;}acc[d]=a;if(accs)accs[(b*heads+h)*512+d]=a;}
  maximum=newmax;if(maxima)maxima[b*heads+h]=maximum;if(alphas)alphas[b*heads+h]=alpha;if(sums)sums[b*heads+h]=den;
 }
 den=den+float(exp(double(sinks[h]-maximum)));if(denominator)denominator[h]=den;for(unsigned d=0;d<512;++d)out[h*512+d]=bf(acc[d]/den);
}
KvTrace online(const std::vector<float>&q,const std::vector<float>&kv,const std::vector<int64_t>&ids,const std::vector<float>&sinks){
 if(q.empty()||q.size()%512||kv.size()%512||sinks.size()!=q.size()/512)throw std::runtime_error("online geometry");finite(q);finite(kv);finite(sinks);for(auto id:ids)if(id<-1||(id>=0&&uint64_t(id)>=kv.size()/512))throw std::runtime_error("online index bounds");
 size_t heads=sinks.size(),blocks=(ids.size()+63)/64;KvTrace t;std::vector<float>out(q.size()),score(blocks*heads*64),maxima(blocks*heads),alpha(blocks*heads),prob(score.size()),casts(score.size()),sums(maxima.size()),acc(blocks*q.size()),den(heads);
 {Memory a(q.size()*4),b(std::max<size_t>(4,kv.size()*4)),c(std::max<size_t>(8,ids.size()*8)),d(sinks.size()*4),e(out.size()*4),f(std::max<size_t>(4,score.size()*4)),g(std::max<size_t>(4,maxima.size()*4)),h(std::max<size_t>(4,alpha.size()*4)),i(std::max<size_t>(4,prob.size()*4)),j(std::max<size_t>(4,casts.size()*4)),k(std::max<size_t>(4,sums.size()*4)),l(std::max<size_t>(4,acc.size()*4)),m(den.size()*4);a.upload(q.data());if(!kv.empty())b.upload(kv.data());if(!ids.empty())c.upload(ids.data());d.upload(sinks.data());online_kernel<<<(heads+31)/32,32>>>((float*)a.p,(float*)b.p,(int64_t*)c.p,(float*)d.p,(float*)e.p,(float*)f.p,(float*)g.p,(float*)h.p,(float*)i.p,(float*)j.p,(float*)k.p,(float*)l.p,(float*)m.p,heads,ids.size(),blocks);done();e.download(out.data());if(blocks){f.download(score.data());g.download(maxima.data());h.download(alpha.data());i.download(prob.data());j.download(casts.data());k.download(sums.data());l.download(acc.data());}m.download(den.data());}
 pf(t,"output",out,heads,512);pf(t,"denominator",den,heads,1);
 auto slice=[&](const std::vector<float>&v,size_t b,size_t width){return std::vector<float>(v.begin()+b*heads*width,v.begin()+(b+1)*heads*width);};
 for(size_t b=0;b<blocks;++b){auto prefix="block"+std::to_string(b)+"_";pf(t,prefix+"score",slice(score,b,64),heads,64);pf(t,prefix+"max",slice(maxima,b,1),heads,1);pf(t,prefix+"alpha",slice(alpha,b,1),heads,1);pf(t,prefix+"prob",slice(prob,b,64),heads,64);pf(t,prefix+"prob_bf16",slice(casts,b,64),heads,64);pf(t,prefix+"sum",slice(sums,b,1),heads,1);pf(t,prefix+"acc",slice(acc,b,512),heads,512);}return t;
}
__global__ void select_kernel(const float*source,const float*scores,const int64_t*visible,uint8_t*mask,int32_t*selected,float*blockscore,int32_t*work,size_t rows,size_t n,int offset,bool prune,int*error=nullptr){
 size_t r=blockIdx.x*blockDim.x+threadIdx.x;if(r>=rows)return;size_t blocks=(n+7)/8,k=n<512?n:512;int64_t count=visible[r];if(count<0||uint64_t(count)>n){if(error)atomicOr(error,2);count=0;}
 for(size_t b=0;b<blocks;++b){float value=-INFINITY;for(size_t p=b*8;p<(b+1)*8&&p<n&&p<size_t(count);++p)value=fmaxf(value,source[r*n+p]);if(count&&b==size_t((count-1)/8))value=INFINITY;blockscore[r*blocks+b]=value;}
 for(size_t b=0;b<blocks;++b){float value=blockscore[r*blocks+b];unsigned rank=0;for(size_t j=0;j<blocks;++j){float z=blockscore[r*blocks+j];if(z>value||(z==value&&j<b))++rank;}bool keep=!prune||(value>-INFINITY&&rank<2048);for(size_t p=b*8;p<(b+1)*8&&p<n;++p)mask[r*n+p]=keep;}
 for(size_t j=0;j<k;++j)work[r*k+j]=-1;
 for(size_t p=0;p<size_t(count);++p){if(!mask[r*n+p])continue;float value=scores[r*n+p];size_t at=0;for(;at<k;++at){int old=work[r*k+at];if(old<0||value>scores[r*n+old]||(value==scores[r*n+old]&&p<size_t(old)))break;}if(at<k){for(size_t j=k-1;j>at;--j)work[r*k+j]=work[r*k+j-1];work[r*k+at]=int(p);}}
 // Position order, followed by unavailable -1 entries.
 for(size_t j=0;j<k;++j){int value=work[r*k+j];if(value<0){selected[r*k+j]=-1;continue;}size_t rank=0;for(size_t a=0;a<k;++a)if(work[r*k+a]>=0&&work[r*k+a]<value)++rank;selected[r*k+rank]=value+offset;}
}
KvTrace selection(const std::vector<float>&source,const std::vector<float>&score,const std::vector<int64_t>&visible,size_t n,int offset,bool prune=true){
 if(!n||source.size()!=score.size()||source.size()!=visible.size()*n||offset<0||n>size_t(INT32_MAX-offset))throw std::runtime_error("selection geometry");finite(source);finite(score);for(auto v:visible)if(v<0||uint64_t(v)>n)throw std::runtime_error("selection visible");size_t rows=visible.size(),k=std::min<size_t>(512,n),blocks=(n+7)/8;KvTrace t;std::vector<uint8_t>mask(rows*n);std::vector<int32_t>selected(rows*k);
 {Memory a(source.size()*4),b(score.size()*4),c(visible.size()*8),d(mask.size()),e(selected.size()*4),f(rows*blocks*4),g(selected.size()*4);a.upload(source.data());b.upload(score.data());c.upload(visible.data());select_kernel<<<(rows+31)/32,32>>>((float*)a.p,(float*)b.p,(int64_t*)c.p,(uint8_t*)d.p,(int32_t*)e.p,(float*)f.p,(int32_t*)g.p,rows,n,offset,prune);done();d.download(mask.data());e.download(selected.data());}put(t,"candidate_mask",mask,rows,n,"|u1");put(t,"selected",selected,rows,k,"<i4");return t;
}
}


namespace {
std::vector<int32_t> prefill_indices(size_t length){if(!length||length>INT32_MAX||length>SIZE_MAX/std::min<size_t>(128,length))throw std::runtime_error("prefill source coordinate overflow");size_t width=std::min<size_t>(128,length);std::vector<int32_t>out(length*width,-1);for(size_t query=0;query<length;++query){size_t first=query>127?query-127:0;for(size_t j=0;j<width;++j){size_t p=first+j;if(p<=query)out[query*width+j]=int32_t(p);}}return out;}
KvTrace prefill_control(const KvFloats&in){size_t length=in.at("keys").size()/512;if(!length||length>SIZE_MAX/length)throw std::runtime_error("prefill mask overflow");auto indices=prefill_indices(length);size_t width=std::min<size_t>(128,length);std::vector<int64_t>last(indices.end()-width,indices.end());auto t=online(in.at("query"),in.at("keys"),last,in.at("sinks"));put(t,"window_indices",indices,length,width,"<i4");std::vector<uint8_t>mask(length*length,0);for(size_t q=0;q<length;++q)for(size_t j=0;j<width;++j){auto p=indices[q*width+j];if(p>=0)mask[q*length+p]=1;}put(t,"causal_mask",mask,length,length,"|u1");return t;}
}

KvTrace attention_primitive(const std::string&kind,const KvFloats&in,const std::map<std::string,std::vector<int64_t>>&integers,uint64_t rows,uint64_t columns){start();KvTrace t;if(kind=="fp4"||kind=="fp8"){auto x=kind=="fp4"?fp4(in.at("input")):fp8(in.at("input"));pf(t,"decoded",x.decoded,rows,columns);put(t,"codes",x.codes,rows,columns,"|u1");put(t,"scales",x.scales,rows,columns/32,"|u1");}else if(kind=="norm"){auto n=rms(in.at("input"),in.at("weight"));pf(t,"output",n.first,rows,columns);pf(t,"inv",n.second,rows,1);}else if(kind=="rope"){pf(t,"output",rotate(in.at("input"),columns,integers.at("positions")),rows,columns);pf(t,"inverse",rotate(in.at("input"),columns,integers.at("positions"),true),rows,columns);}else if(kind=="index")t=index(in.at("query"),in.at("keys"),in.at("weights"),rows);else if(kind=="online")t=online(in.at("query"),in.at("keys"),integers.at("indices"),in.at("sinks"));else if(kind=="prefill")t=prefill_control(in);else if(kind=="select")t=selection(in.at("source_score"),in.at("score"),integers.at("visible"),columns,128);else throw std::runtime_error("unimplemented attention primitive");finish(t);return t;}
namespace {
void merge(KvTrace&to,const KvTrace&from,const std::string&prefix=""){for(const auto&[name,value]:from.stages)if(!to.stages.emplace(prefix+name,value).second)throw std::runtime_error("duplicate attention stage");to.scratch_peak=std::max(to.scratch_peak,from.scratch_peak);to.primitive_peak=std::max(to.primitive_peak,from.primitive_peak);if(from.cleanup_unknown)throw std::runtime_error("dependency cleanup unknown");}
std::vector<float> norm_weight(const KvWeights&w,const std::string&name){auto&v=w.at(name);auto&s=v.original.span;if(s.type_id!=0||v.packed.size()%4)throw std::runtime_error("F32 norm source");std::vector<float>x(v.packed.size()/4);std::memcpy(x.data(),v.packed.data(),v.packed.size());return x;}
std::vector<float> projected(KvTrace&t,const KvWeight&w,const std::vector<float>&x,size_t batch,size_t k,size_t out,const std::string&prefix,bool activation=true,const std::vector<uint8_t>*slice=nullptr){
 if(!batch||x.size()!=batch*k)throw std::runtime_error("attention projection shape");auto input=cast(x);pf(t,prefix+"input",input,batch,k);auto packed=slice?*slice:w.packed;std::vector<float>in=input;
 if(activation){auto n=fp8(input);pf(t,prefix+"input_qdq",n.decoded,batch,k);put(t,prefix+"input_codes",n.codes,batch,k,"|u1");put(t,prefix+"input_scales",n.scales,batch,k/32,"|u1");in=std::move(n.decoded);}
 std::vector<float>dot;for(size_t first=0;first<batch;){size_t count=std::min<size_t>(8,batch-first);while(count&(count-1))--count;std::vector<float>part(in.begin()+first*k,in.begin()+(first+count)*k);auto v=quant::project(packed,w.original.span.type_id,out,k,count,part);dot.insert(dot.end(),v.begin(),v.end());t.primitive_peak=std::max<uint64_t>(t.primitive_peak,packed.size()+(count*k+count*out)*4);first+=count;}
 pf(t,prefix+"dot",dot,batch,out);auto result=cast(dot);pf(t,prefix+"output",result,batch,out);return result;
}
KvTrace project_all(const std::vector<float>&input,size_t batch,const KvWeights&w){KvTrace t;
 for(int layer:{2,20,24}){auto p="layer"+std::to_string(layer)+"__",base="blk."+std::to_string(layer)+".";auto qa=projected(t,w.at(base+"attn_q_a.weight"),input,batch,5120,1280,p+"qa_");auto n=rms(qa,norm_weight(w,base+"attn_q_a_norm.weight"));pf(t,p+"qr",n.first,batch,1280);pf(t,p+"qr_inv",n.second,batch,1);projected(t,w.at(base+"indexer.attn_q_b.weight"),n.first,batch,1280,4096,p+"index_q_");auto weight=projected(t,w.at(base+"indexer.proj.weight"),input,batch,5120,32,p+"index_weight_",false);pf(t,p+"index_weight_scaled",cast(weight,1.f/64.f),batch,32);
 if(layer!=24){projected(t,w.at(base+"attn_q_b.weight"),n.first,batch,1280,32768,p+"q_");auto kv=projected(t,w.at(base+"attn_kv.weight"),input,batch,5120,512,p+"kv_");auto norm=rms(kv,norm_weight(w,base+"attn_kv_a_norm.weight"));pf(t,p+"kv_norm",norm.first,batch,512);pf(t,p+"kv_inv",norm.second,batch,1);}}
 return t;
}
std::vector<float> selected_rows(const KvTrace&t,const std::string&name,size_t length,unsigned phase){const auto&s=t.stages.at(name);if(s.rows!=8||s.dtype!="<f4")throw std::runtime_error("periodic actual projection8");auto values=data<float>(s);std::vector<float>out(length*s.columns);for(size_t r=0;r<length;++r)std::copy_n(values.data()+((r+phase)%8)*s.columns,s.columns,out.data()+r*s.columns);return out;}
void narrow_stages(KvTrace&t,const std::string&prefix,const Narrow&n,size_t rows,size_t columns){pf(t,prefix+"decoded",n.decoded,rows,columns);put(t,prefix+"codes",n.codes,rows,columns,"|u1");put(t,prefix+"scales",n.scales,rows,columns/32,"|u1");}
}
KvTrace attention_projection(const std::vector<float>&input,uint32_t batch,const KvWeights&w,const measurement::Identity&,const std::string&){start();auto t=project_all(input,batch,w);finish(t);return t;}
KvTrace attention_short(const std::vector<float>&input8,uint64_t length,uint32_t phase,const KvWeights&w,const KvWeights&compression,const measurement::Identity&id,const std::string&device){
 if(input8.size()!=8*5120||!length||phase>=8)throw std::runtime_error("short input geometry");start();auto base=project_all(input8,8,w);auto compression8=kv_project(input8,8,compression,id,device);auto temporal=kv_temporal(compression8,length,phase,compression);KvTrace t;t.primitive_peak=std::max(base.primitive_peak,compression8.primitive_peak);t.scratch_peak=std::max(compression8.scratch_peak,temporal.scratch_peak);std::vector<float>owner20score;std::vector<int64_t>positions(length);for(size_t r=0;r<length;++r)positions[r]=r;
 struct Owner {std::vector<float>keys,compressed;size_t ratio;int writer;};std::map<int,Owner>owners;
 for(int layer:{2,20}){auto p="layer"+std::to_string(layer)+"__",prefix="blk."+std::to_string(layer)+".";size_t ratio=layer==2?2:1;auto latent=data<float>(temporal.stages.at("s"+std::to_string(layer)+"_pre_rope"));size_t n=latent.size()/512;std::vector<float>dot;
 if(n)dot=projected(t,w.at(prefix+"indexer.attn_k.weight"),latent,n,512,128,p+"key_",false);else{pf(t,p+"key_input",{},0,512);pf(t,p+"key_dot",{},0,128);pf(t,p+"key_output",{},0,128);}
 auto norm=rms(dot,norm_weight(w,prefix+"indexer.k_norm.weight"));pf(t,p+"key_norm",norm.first,n,128);pf(t,p+"key_inv",norm.second,n,1);std::vector<int64_t>pos(n);for(size_t j=0;j<n;++j)pos[j]=j*ratio;auto rot=rotate(norm.first,128,pos);pf(t,p+"key_rotated",rot,n,128);auto decoded=fp4(rot);narrow_stages(t,p+"key_",decoded,n,128);owners.emplace(layer,Owner{decoded.decoded,data<float>(temporal.stages.at("s"+std::to_string(layer)+"_decoded")),ratio,layer});}
 for(int layer:{2,20,24}){auto p="layer"+std::to_string(layer)+"__",prefix="blk."+std::to_string(layer)+".";auto&owner=owners.at(layer==2?2:20);size_t n=owner.keys.size()/128;auto query=selected_rows(base,p+"index_q_output",length,phase);std::vector<int64_t>qpos(length*32);for(size_t r=0;r<length;++r)for(unsigned h=0;h<32;++h)qpos[r*32+h]=r;auto rot=rotate(query,128,qpos);pf(t,p+"index_query_rotated",rot,length,4096);auto q=fp4(rot);narrow_stages(t,p+"index_query_",q,length,4096);auto weight=selected_rows(base,p+"index_weight_scaled",length,phase);pf(t,p+"index_query_weights",weight,length,32);std::vector<int32_t>selected;
 if(n){auto scores=index(q.decoded,owner.keys,weight,length);merge(t,scores,p+"index_score_");auto score=data<float>(scores.stages.at("score"));std::vector<int64_t>visible(length);for(size_t r=0;r<length;++r)visible[r]=(r+1)/owner.ratio;auto choice=selection(layer==24?owner20score:score,score,visible,n,int(length),index_candidate_pruning(owner.writer));if(layer==20)owner20score=score;merge(t,choice,p+"index_");selected=data<int32_t>(choice.stages.at("selected"));}else{pf(t,p+"index_score_score",{},length,0);put<uint8_t>(t,p+"index_candidate_mask",{},length,0,"|u1");put<int32_t>(t,p+"index_selected",{},length,0,"<i4");}
 if(layer==24)continue;
 auto fullquery=selected_rows(base,p+"q_output",length,phase);std::vector<int64_t>attnpos(length*64);for(size_t r=0;r<length;++r)for(unsigned h=0;h<64;++h)attnpos[r*64+h]=r;auto qrot=rotate(fullquery,512,attnpos);pf(t,p+"q_rotated",qrot,length,32768);auto windowpre=selected_rows(base,p+"kv_norm",length,phase);auto windowpost=rotate(windowpre,512,positions);auto window=fp8(windowpost);pf(t,p+"window_pre_rope",windowpre,length,512);pf(t,p+"window_post_rope",windowpost,length,512);narrow_stages(t,p+"window_",window,length,512);std::vector<float>payload=window.decoded;payload.insert(payload.end(),owner.compressed.begin(),owner.compressed.end());size_t windowcount=std::min<size_t>(128,length),chosen=std::min<size_t>(512,n);std::vector<int32_t>combined(length*(windowcount+chosen),-1);auto prefill=prefill_indices(length);std::vector<float>attn;
 for(size_t r=0;r<length;++r){std::vector<int64_t>ix;for(size_t j=0;j<windowcount;++j){int32_t v=prefill[r*windowcount+j];combined[r*(windowcount+chosen)+j]=v;ix.push_back(v);}for(size_t j=0;j<chosen;++j){auto v=selected[r*chosen+j];combined[r*(windowcount+chosen)+windowcount+j]=v;ix.push_back(v);}std::vector<float>qr(qrot.begin()+r*32768,qrot.begin()+(r+1)*32768);auto online_trace=online(qr,payload,ix,norm_weight(w,prefix+"attn_sinks.weight"));auto output=data<float>(online_trace.stages.at("output"));attn.insert(attn.end(),output.begin(),output.end());online_trace.stages.erase("output");merge(t,online_trace,p+"attention_p"+std::to_string(r)+"_");}
 put(t,p+"selected_combined",combined,length,windowcount+chosen,"<i4");pf(t,p+"attention_output",attn,length,32768);auto inverse=rotate(attn,512,attnpos,true);pf(t,p+"attention_inverse",inverse,length,32768);auto ia=fp8(inverse);pf(t,p+"outa_input_qdq",ia.decoded,length,32768);put(t,p+"outa_input_codes",ia.codes,length,32768,"|u1");put(t,p+"outa_input_scales",ia.scales,length,1024,"|u1");auto&wa=w.at(prefix+"attn_output_a.weight");std::vector<float>alldot(length*8192),allout(length*8192);
 for(size_t g=0;g<8;++g){std::vector<uint8_t>packed(wa.packed.begin()+g*4456448,wa.packed.begin()+(g+1)*4456448);std::vector<float>group(length*4096);for(size_t r=0;r<length;++r)std::copy_n(ia.decoded.data()+(r*8+g)*4096,4096,group.data()+r*4096);std::vector<float>dot;for(size_t first=0;first<length;){size_t count=std::min<size_t>(8,length-first);while(count&(count-1))--count;std::vector<float>x(group.begin()+first*4096,group.begin()+(first+count)*4096);auto d=quant::project(packed,wa.original.span.type_id,1024,4096,count,x);dot.insert(dot.end(),d.begin(),d.end());t.primitive_peak=std::max<uint64_t>(t.primitive_peak,packed.size()+count*(4096+1024)*4);first+=count;}auto out=cast(dot);for(size_t r=0;r<length;++r){std::copy_n(dot.data()+r*1024,1024,alldot.data()+r*8192+g*1024);std::copy_n(out.data()+r*1024,1024,allout.data()+r*8192+g*1024);}}
 pf(t,p+"outa_dot",alldot,length,8192);pf(t,p+"outa_output",allout,length,8192);projected(t,w.at(prefix+"attn_output_b.weight"),allout,length,8192,5120,p+"outb_");
 }
 finish(t);return t;
}

KvTrace attention_long(const KvFloats&in,const std::vector<int64_t>&visible){
 start();if(visible.size()!=3)throw std::runtime_error("controlled long query count");KvTrace t;size_t n=in.at("keys").size()/128;auto q=fp4(in.at("query")),key=fp4(in.at("keys")),consumer=fp4(in.at("consumer_query"));narrow_stages(t,"query_",q,3,4096);narrow_stages(t,"key_",key,n,128);narrow_stages(t,"consumer_query_",consumer,3,4096);auto score=index(q.decoded,key.decoded,in.at("weights"),3);merge(t,score,"score_");auto cs=index(consumer.decoded,key.decoded,in.at("weights"),3);merge(t,cs,"consumer_score_");auto source=data<float>(score.stages.at("score"));auto select=selection(source,source,visible,n,128);merge(t,select);auto consumerselect=selection(source,data<float>(cs.stages.at("score")),visible,n,128);t.stages.emplace("consumer_selected",consumerselect.stages.at("selected"));auto ids=data<int32_t>(select.stages.at("selected")),cids=data<int32_t>(consumerselect.stages.at("selected"));size_t chosen=std::min<size_t>(512,n);std::vector<int32_t>window(3*128),combined(3*(128+chosen)),combined24(combined.size());
 for(size_t r=0;r<3;++r){int64_t p=visible[r]-1;if(p<128)throw std::runtime_error("long ring position");std::vector<int64_t>row;for(size_t j=0;j<128;++j){int32_t slot=int32_t((p%128+1+j)%128);window[r*128+j]=slot;combined[r*(128+chosen)+j]=slot;combined24[r*(128+chosen)+j]=slot;row.push_back(slot);}for(size_t j=0;j<chosen;++j){combined[r*(128+chosen)+128+j]=ids[r*chosen+j];combined24[r*(128+chosen)+128+j]=cids[r*chosen+j];row.push_back(ids[r*chosen+j]);}auto a=online(in.at("attention_query"),in.at("attention_kv"),row,in.at("sinks"));merge(t,a,"attention"+std::to_string(r)+"_");}
 put(t,"window_indices",window,3,128,"<i4");put(t,"combined_indices",combined,3,128+chosen,"<i4");put(t,"consumer_combined_indices",combined24,3,128+chosen,"<i4");finish(t);return t;
}

namespace {
void adv(const DeviceView&v,int d,uint64_t r,uint64_t c,DeviceScalar type){validate_device_view(v,d);if(v.rows!=r||v.columns!=c||v.scalar!=type)throw std::runtime_error("attention device scalar/geometry");}
void afv(const DeviceView&v,int d,uint64_t r,uint64_t c){validate_device_view(v,d);if(v.rows!=r||v.columns!=c||(v.scalar!=DeviceScalar::Float32&&v.scalar!=DeviceScalar::Bfloat16InFloat32))throw std::runtime_error("attention floating view geometry");}
hipStream_t as(void*s,int d){check_device_stream(s,d);return reinterpret_cast<hipStream_t>(s);}
}
void attention_bf16_device(const DeviceView&x,const DeviceView&out,float scale,void*stream){afv(x,x.device,x.rows,x.columns);adv(out,x.device,x.rows,x.columns,DeviceScalar::Bfloat16InFloat32);if(!std::isfinite(scale))throw std::runtime_error("attention cast scale");auto n=x.rows*x.columns;bf_kernel<<<(n+255)/256,256,0,as(stream,x.device)>>>((float*)x.data,(float*)out.data,n,scale);ck(hipGetLastError());}
void attention_rms_device(const DeviceView&x,const DeviceView&w,const DeviceView&out,void*stream,DeviceView*inv){afv(x,x.device,x.rows,x.columns);adv(w,x.device,1,x.columns,DeviceScalar::Float32);adv(out,x.device,x.rows,x.columns,DeviceScalar::Bfloat16InFloat32);if(inv)adv(*inv,x.device,x.rows,1,DeviceScalar::Float32);rms_kernel<<<(x.rows+63)/64,64,0,as(stream,x.device)>>>((float*)x.data,(float*)w.data,(float*)out.data,inv?(float*)inv->data:nullptr,x.rows,x.columns);ck(hipGetLastError());}
void attention_fp4_device(const DeviceView&x,const DeviceView&out,void*stream,DeviceView*scales,DeviceView*codes){afv(x,x.device,x.rows,x.columns);adv(out,x.device,x.rows,x.columns,DeviceScalar::Bfloat16InFloat32);if(x.columns%32)throw std::runtime_error("index FP4 block32");if(scales)adv(*scales,x.device,x.rows,x.columns/32,DeviceScalar::UInt8);if(codes)adv(*codes,x.device,x.rows,x.columns,DeviceScalar::UInt8);auto groups=x.rows*x.columns/32;fp4_kernel<<<(groups+63)/64,64,0,as(stream,x.device)>>>((float*)x.data,(float*)out.data,codes?(uint8_t*)codes->data:nullptr,scales?(uint8_t*)scales->data:nullptr,groups);ck(hipGetLastError());}
void attention_index_device(const DeviceView&q,const DeviceView&k,const DeviceView&w,const DeviceView&score,void*stream,IndexAuditViews*a){auto b=q.rows,n=k.rows;afv(q,q.device,b,4096);afv(k,q.device,n,128);afv(w,q.device,b,32);adv(score,q.device,b,n,DeviceScalar::Bfloat16InFloat32);if(a){adv(a->raw,q.device,b,32*n,DeviceScalar::Float32);adv(a->dot,q.device,b,32*n,DeviceScalar::Bfloat16InFloat32);adv(a->relu,q.device,b,32*n,DeviceScalar::Float32);adv(a->weighted,q.device,b,32*n,DeviceScalar::Bfloat16InFloat32);adv(a->reduced,q.device,b,n,DeviceScalar::Float32);}index_kernel<<<(b*n+63)/64,64,0,as(stream,q.device)>>>((float*)q.data,(float*)k.data,(float*)w.data,a?(float*)a->raw.data:nullptr,a?(float*)a->dot.data:nullptr,a?(float*)a->relu.data:nullptr,a?(float*)a->weighted.data:nullptr,a?(float*)a->reduced.data:nullptr,(float*)score.data,b,n);ck(hipGetLastError());}
void attention_select_device(const DeviceView&source,const DeviceView&scores,const DeviceView&visible,const DeviceView&mask,const DeviceView&selected,const DeviceView&blocks,const DeviceView&work,const DeviceView&error,int writer,int offset,void*stream){auto b=source.rows,n=source.columns,k=std::min<uint64_t>(n,512);afv(source,source.device,b,n);afv(scores,source.device,b,n);adv(visible,source.device,b,1,DeviceScalar::Int64);adv(mask,source.device,b,n,DeviceScalar::UInt8);adv(selected,source.device,b,k,DeviceScalar::Int32);adv(blocks,source.device,b,(n+7)/8,DeviceScalar::Float32);adv(work,source.device,b,k,DeviceScalar::Int32);adv(error,source.device,1,1,DeviceScalar::UInt32);if(offset<0||n>uint64_t(INT32_MAX-offset))throw std::runtime_error("candidate output index range");select_kernel<<<(b+31)/32,32,0,as(stream,source.device)>>>((float*)source.data,(float*)scores.data,(int64_t*)visible.data,(uint8_t*)mask.data,(int32_t*)selected.data,(float*)blocks.data,(int32_t*)work.data,b,n,offset,index_candidate_pruning(writer),(int*)error.data);ck(hipGetLastError());}
void attention_online_device(const DeviceView&q,const DeviceView&kv,const DeviceView&ids,const DeviceView&sink,const DeviceView&out,const DeviceView&error,void*stream,OnlineAuditViews*a){auto h=q.rows,n=ids.columns,b=(n+63)/64;afv(q,q.device,h,512);afv(kv,q.device,kv.rows,512);adv(ids,q.device,1,n,DeviceScalar::Int64);adv(sink,q.device,1,h,DeviceScalar::Float32);adv(out,q.device,h,512,DeviceScalar::Bfloat16InFloat32);adv(error,q.device,1,1,DeviceScalar::UInt32);if(a){adv(a->score,q.device,b*h,64,DeviceScalar::Float32);adv(a->maximum,q.device,b*h,1,DeviceScalar::Float32);adv(a->alpha,q.device,b*h,1,DeviceScalar::Float32);adv(a->probability,q.device,b*h,64,DeviceScalar::Float32);adv(a->prob_bf16,q.device,b*h,64,DeviceScalar::Bfloat16InFloat32);adv(a->sum,q.device,b*h,1,DeviceScalar::Float32);adv(a->accumulator,q.device,b*h,512,DeviceScalar::Float32);adv(a->denominator,q.device,h,1,DeviceScalar::Float32);}online_kernel<<<(h+31)/32,32,0,as(stream,q.device)>>>((float*)q.data,(float*)kv.data,(int64_t*)ids.data,(float*)sink.data,(float*)out.data,a?(float*)a->score.data:nullptr,a?(float*)a->maximum.data:nullptr,a?(float*)a->alpha.data:nullptr,a?(float*)a->probability.data:nullptr,a?(float*)a->prob_bf16.data:nullptr,a?(float*)a->sum.data:nullptr,a?(float*)a->accumulator.data:nullptr,a?(float*)a->denominator.data:nullptr,h,n,b,kv.rows,(int*)error.data);ck(hipGetLastError());}

void attention_online_split_device(const DeviceView&q,const DeviceView&window,const DeviceView&compressed,const DeviceView&ids,const DeviceView&sink,const DeviceView&out,const DeviceView&error,void*stream,OnlineAuditViews*a){
 auto heads=q.rows,n=ids.columns,blocks=(n+63)/64;afv(q,q.device,heads,512);afv(window,q.device,window.rows,512);afv(compressed,q.device,compressed.rows,512);adv(ids,q.device,1,n,DeviceScalar::Int64);adv(sink,q.device,1,heads,DeviceScalar::Float32);adv(out,q.device,heads,512,DeviceScalar::Bfloat16InFloat32);adv(error,q.device,1,1,DeviceScalar::UInt32);if(compressed.rows>SIZE_MAX-window.rows)throw std::runtime_error("combined KV rows overflow");
 if(a){adv(a->score,q.device,blocks*heads,64,DeviceScalar::Float32);adv(a->maximum,q.device,blocks*heads,1,DeviceScalar::Float32);adv(a->alpha,q.device,blocks*heads,1,DeviceScalar::Float32);adv(a->probability,q.device,blocks*heads,64,DeviceScalar::Float32);adv(a->prob_bf16,q.device,blocks*heads,64,DeviceScalar::Bfloat16InFloat32);adv(a->sum,q.device,blocks*heads,1,DeviceScalar::Float32);adv(a->accumulator,q.device,blocks*heads,512,DeviceScalar::Float32);adv(a->denominator,q.device,heads,1,DeviceScalar::Float32);}
 online_kernel<<<(heads+31)/32,32,0,as(stream,q.device)>>>((float*)q.data,(float*)window.data,(int64_t*)ids.data,(float*)sink.data,(float*)out.data,a?(float*)a->score.data:nullptr,a?(float*)a->maximum.data:nullptr,a?(float*)a->alpha.data:nullptr,a?(float*)a->probability.data:nullptr,a?(float*)a->prob_bf16.data:nullptr,a?(float*)a->sum.data:nullptr,a?(float*)a->accumulator.data:nullptr,a?(float*)a->denominator.data:nullptr,heads,n,blocks,window.rows+compressed.rows,(int*)error.data,(const float*)compressed.data,window.rows);ck(hipGetLastError());
}

}
