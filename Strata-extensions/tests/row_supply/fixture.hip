#include "../../native/cache/row_supply.hpp"
#include "../../native/io/span_provider.hpp"
#include <hip/hip_runtime.h>
#include <windows.h>
#include <psapi.h>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <sstream>
#include <cstring>
#include <chrono>
#include <thread>
using namespace strata_ext;
namespace fs=std::filesystem;
namespace {
unsigned assertions=0;
void need(bool x,const char* m){++assertions;if(!x)throw std::runtime_error(m);}
void hip(hipError_t e){if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));}
template<class F>void rejects(F f){bool bad=false;try{f();}catch(const std::exception&){bad=true;}need(bad,"negative accepted");}
template<class T>std::vector<T> read(const fs::path& p){std::ifstream f(p,std::ios::binary|std::ios::ate);need(bool(f),"input absent");auto n=f.tellg();need(n>=0&&n%sizeof(T)==0,"exact element bytes");std::vector<T> a(size_t(n)/sizeof(T));f.seekg(0);f.read(reinterpret_cast<char*>(a.data()),n);need(bool(f),"input short");return a;}
template<class T>void write(const fs::path& p,const std::vector<T>& a){std::ofstream f(p,std::ios::binary);f.write(reinterpret_cast<const char*>(a.data()),a.size()*sizeof(T));need(bool(f),"output short");}
std::vector<std::string> fields(std::string line){std::istringstream f(line);std::string x;std::vector<std::string> a;while(std::getline(f,x,'\t'))a.push_back(x);return a;}
std::string quote(const std::string&s){std::string o="\"";for(auto c:s){if(c=='\\'||c=='"')o+='\\';o+=c;}return o+'"';}
std::string modules(){HMODULE h[2048];DWORD n=0;need(EnumProcessModules(GetCurrentProcess(),h,sizeof(h),&n)&&n<=sizeof(h),"module list");std::string s="[";for(size_t i=0;i<n/sizeof(HMODULE);++i){char p[32768];need(GetModuleFileNameA(h[i],p,sizeof(p))!=0,"module path");if(i)s+=',';s+=quote(p);}return s+"]";}
measurement::Identity identity(const std::string& h){measurement::Identity i;i.request_id="T19-fixture";i.epoch=1;i.phase=measurement::Phase::Startup;i.fixture_sha256=h;i.asset_sha256=h;i.bundle_sha256=h;return i;}
struct Data {
 deepseek41::SourceSet sources;std::unique_ptr<deepseek41::Artifact> artifact;
 std::vector<cache::RowLookup> lookups;std::vector<cache::RowBinding> bindings;
 explicit Data(const fs::path& input){std::string line;std::ifstream f(input/"sources.tsv");while(std::getline(f,line)){auto a=fields(line);sources.files.push_back({uint32_t(std::stoul(a[0])),fs::u8path(a[4]),std::stoull(a[1]),a[3],a[2]});if(sources.root.empty())sources.root=fs::u8path(a[4]).parent_path();}
 std::vector<artifact::PrefixIndex> prefixes;std::ifstream pf(input/"prefixes.tsv");fs::path first;while(std::getline(pf,line)){auto a=fields(line);if(first.empty())first=fs::u8path(a[1]);prefixes.push_back(artifact::inspect_prefix(fs::u8path(a[1]),std::stoull(a[0])));}artifact=std::make_unique<deepseek41::Artifact>(artifact::merge_prefixes(prefixes),deepseek41::inspect_metadata(first),sources);
 std::ifstream rows(input/"rows.tsv");while(std::getline(rows,line)){auto a=fields(line);need(a.size()==7,"row source columns");cache::RowLookup lookup{uint32_t(std::stoul(a[1])),uint32_t(std::stoul(a[2])),std::stoull(a[3])};auto slice=artifact->engram_row(lookup.layer,lookup.head,lookup.row);need(slice.absolute_offset==std::stoull(a[5])&&slice.bytes==264&&slice.original.source.shard_index==8,"T10 original row identity");lookups.push_back(lookup);bindings.push_back({slice,{fs::u8path(a[6]),slice.absolute_offset,264}});}need(lookups.size()==96,"96 source rows");
 }
};
template<class S>uint64_t heap_probe(const S& x){auto p=reinterpret_cast<uintptr_t>(x.data()),a=reinterpret_cast<uintptr_t>(&x);return p>=a&&p<a+sizeof(x)?0:(x.capacity()+1)*sizeof(typename S::value_type);}
uint64_t id_heap(const measurement::Identity& x){return heap_probe(x.request_id)+heap_probe(x.fixture_sha256)+heap_probe(x.asset_sha256)+heap_probe(x.bundle_sha256);}
uint64_t binding_heap_probe(const cache::RowBinding& x){return heap_probe(x.physical.path.native())+heap_probe(x.logical.original.source.original_path.native())+heap_probe(x.logical.original.source.revision)+heap_probe(x.logical.original.source.lfs_sha256)+heap_probe(x.logical.original.span.name)+x.logical.original.span.dims_ggml.capacity()*8+x.logical.dims_ggml.capacity()*8;}
void host(const fs::path& input,const fs::path& output,const std::string& hash){Data d(input);auto id=identity(hash);std::vector<artifact::FixtureView> sources;std::vector<io::Span> spans;std::vector<uint8_t> expected;for(auto b:d.bindings){sources.push_back(b.physical);spans.push_back({uint32_t(sources.size()-1),b.logical.absolute_offset,264,uint64_t(expected.size())});auto bytes=read<uint8_t>(b.physical.path);need(bytes.size()==264,"real raw row length");expected.insert(expected.end(),bytes.begin(),bytes.end());}
 void* a=_aligned_malloc(4096,4096);void* b=_aligned_malloc(4096,4096);std::vector<io::Buffer> buffers{{a,4096},{b,4096}};std::ostringstream paths;
 for(unsigned mode=0;mode<3;++mode){io::Config c;c.path=io::PathMode(mode);c.max_chunk=4096;c.max_outstanding=1;c.max_outstanding_bytes=4096;std::vector<uint8_t> actual(expected.size());io::SpanProvider p(sources,buffers,c);auto t=p.enqueue(spans,{actual.data(),actual.size()},id);need(bool(t),"host row admission");unsigned steps=0;while(!p.done(*t)){need(++steps<20000,"finite host read");p.issue();p.poll(10);}auto result=p.take(*t,id);need(result.ok&&actual==expected&&p.try_close(),"host native rows exact");write(output/("rows-path"+std::to_string(mode)+".bin"),actual);if(mode)paths<<',';paths<<p.stats().logical_delivered;}
 {auto shortpath=output/"test-owned-short.bin";auto bytes=expected;bytes.resize(263);write(shortpath,bytes);std::vector<artifact::FixtureView> shortviews{{shortpath,0,264}};rejects([&]{io::SpanProvider short_provider(shortviews,buffers,{});});}

 {cache::ResidentSlot synthetic{4096,264,123};auto w=cache::reserve_fill(synthetic,123,264);need(bool(w),"synthetic quarantine reserve");cache::quarantine_resident(*w,123);need(synthetic.writer&&synthetic.quarantined&&!cache::reserve_fill(synthetic,123,264)&&!cache::borrow_resident(synthetic,123),"synthetic undrained slot capacity retained");}
 _aligned_free(a);_aligned_free(b);auto layout=cache::RowSupply::metadata_layout();auto copied=d.bindings;uint64_t heap=0;for(auto& x:copied)heap+=binding_heap_probe(x);measurement::Identity first,second;first=id;auto all_identity=id_heap(first);auto longid=id;longid.request_id="first-owned-storage";first=longid;first=id;longid.request_id="remaining-waiter";second=longid;auto shared_identity=id_heap(first)+id_heap(second);
 std::cout<<"{\"source_id\":"<<quote(T19_SOURCE_ID)<<",\"assertions\":"<<assertions<<",\"paths_logical\":["<<paths.str()<<"],\"layout\":[";for(size_t i=0;i<layout.size();++i){if(i)std::cout<<',';std::cout<<layout[i];}std::cout<<"],\"binding_heap\":"<<heap<<",\"all_identity_heap\":"<<all_identity<<",\"shared_identity_heap\":"<<shared_identity<<",\"GPU_used\":false}";
}
struct OwnedRow {
 std::unique_ptr<cache::RowSupply> p;int device;
 OwnedRow(cache::RowConfig c,const deepseek41::Artifact&a,std::vector<cache::RowBinding>b):p(std::make_unique<cache::RowSupply>(c,a,std::move(b))),device(c.device){}
 cache::RowSupply& value(){return *p;}
 ~OwnedRow(){try{if(p->try_close())return;hip(hipSetDevice(device));auto tokens=p->cancel_all();auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);bool pending=true;while(pending&&std::chrono::steady_clock::now()<deadline){p->poll_io(10);p->poll_device();pending=p->fill_pending();for(auto& token:tokens)if(token.owner){auto state=p->state(token);if(state==cache::RowState::Cancelled||state==cache::RowState::Done){p->take(token,{});token.owner=0;}else pending=true;}}if(p->try_close())return;std::cerr<<"fixture retains undrained owner until process exit\n";(void)p.release();}catch(...){std::cerr<<"fixture cannot prove owner drain; retained until process exit\n";(void)p.release();}}
};
void advance(cache::RowSupply& p){p.issue_reads(1,4096);p.poll_io(1);p.poll_device();}
void until(cache::RowSupply& p,cache::Token t,cache::RowState goal){auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(60);while(p.state(t)!=goal){need(std::chrono::steady_clock::now()<deadline,"fixture progress deadline");advance(p);if(p.state(t)!=goal)std::this_thread::sleep_for(std::chrono::milliseconds(1));}}
cache::RowResult finish(cache::RowSupply& p,cache::Token t,const measurement::Identity& id){auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(60);while(p.state(t)!=cache::RowState::Done&&p.state(t)!=cache::RowState::Cancelled){need(std::chrono::steady_clock::now()<deadline,"fixture result deadline");auto state=p.state(t);if(state==cache::RowState::Ready)p.launch_gather(t);else if(state==cache::RowState::Download)p.download(t);else advance(p);}return p.take(t,id);}
cache::Token enqueue(cache::RowSupply& p,const std::vector<cache::RowLookup>& rows,const measurement::Identity& id){auto t=p.enqueue(rows,id);need(bool(t),"bounded row request admission");return *t;}
void result_files(const fs::path& output,const std::string& name,const cache::RowResult& result){need(!result.cancelled,"result not cancelled");write(output/(name+"-fp32.bin"),result.fp32);write(output/(name+"-bf16.bin"),result.bf16);}
std::string stats(cache::RowStats x){std::ostringstream s;s<<"{\"logical_read\":"<<x.logical_read<<",\"requested_read\":"<<x.requested_read<<",\"received\":"<<x.received<<",\"weight_h2d\":"<<x.weight_h2d<<",\"index_h2d\":"<<x.index_h2d<<",\"output_d2h\":"<<x.output_d2h<<",\"gpu_hits\":"<<x.gpu_hits<<",\"ram_hits\":"<<x.ram_hits<<",\"ssd_misses\":"<<x.ssd_misses<<",\"dedup\":"<<x.dedup<<",\"issued\":"<<x.issued<<",\"device_owned\":"<<x.device_owned<<",\"host_payload\":"<<x.host_payload<<",\"stage_owned\":"<<x.stage_owned<<",\"pinned_subset\":"<<(x.pinned_known?std::to_string(x.pinned_subset):"null")<<",\"pinned_observed\":"<<(x.pinned_observed?"true":"false")<<",\"binding_heap\":"<<x.binding_heap<<",\"identity_heap\":"<<x.identity_heap<<",\"lookup_capacity\":"<<x.lookup_capacity<<",\"key_capacity\":"<<x.key_capacity<<",\"observed_metadata_peak\":"<<x.observed_metadata_peak<<",\"observed_host_payload_peak\":"<<x.observed_host_payload_peak<<",\"active_io_wrapper_metadata\":"<<x.active_io_wrapper_metadata<<",\"metadata_capacity\":"<<x.metadata_capacity<<",\"stages\":[";for(size_t i=0;i<x.stages.size();++i){if(i)s<<',';auto a=x.stages[i];s<<'['<<a[0]<<','<<a[1]<<','<<(a[2]<0?"null":std::to_string(a[2]))<<','<<(a[3]<0?"null":std::to_string(a[3]))<<']';}s<<"],\"physical_driver_peak\":null}";return s.str();}
std::string joint_io(int device,const fs::path& input,const Data& d,const std::string& hash){
 std::ifstream desc(input/"expert.tsv");std::string line;std::getline(desc,line);auto ef=fields(line);need(ef.size()==4,"joint expert descriptor");fs::path original=fs::u8path(ef[0]),reference=fs::u8path(ef[3]);uint64_t original_size=std::stoull(ef[1]),base=std::stoull(ef[2]);
 std::array<void*,2> source{},stage{},device_buffers{},io_raw{};std::array<bool,2> pinned{};std::vector<cache::Buffer> declared;std::vector<io::Buffer> readbuffers;
 for(unsigned i=0;i<2;++i){source[i]=_aligned_malloc(65536,4096);io_raw[i]=_aligned_malloc(65536,4096);need(source[i]&&io_raw[i],"joint source allocation");readbuffers.push_back({io_raw[i],65536});
  if(!std::getenv("STRATA_TEST_PAGEABLE")&&hipHostMalloc(&stage[i],65536)==hipSuccess)pinned[i]=true;else{(void)hipGetLastError();stage[i]=_aligned_malloc(65536,4096);}need(stage[i]!=nullptr,"joint stage allocation");hip(hipMalloc(&device_buffers[i],65536));
  declared.push_back({cache::Pool::Source,reinterpret_cast<uintptr_t>(source[i]),65536});declared.push_back({cache::Pool::Stage,reinterpret_cast<uintptr_t>(stage[i]),65536});declared.push_back({cache::Pool::Device,reinterpret_cast<uintptr_t>(device_buffers[i]),65536});
 }
 const uint64_t owner=reinterpret_cast<uintptr_t>(&declared);cache::LeaseQueue queue(owner,declared.data(),uint32_t(declared.size()),{8,262144,65536,1});std::array<measurement::Identity,12> identities;
 hipStream_t stream;hipEvent_t dma,consumer;hip(hipStreamCreateWithFlags(&stream,hipStreamNonBlocking));hip(hipEventCreateWithFlags(&dma,hipEventDisableTiming));hip(hipEventCreateWithFlags(&consumer,hipEventDisableTiming));
 uint64_t logical=0,requested=0,received=0;std::ostringstream order;std::vector<uint8_t> actual(65536),expected(65536);
 for(unsigned round=0;round<4;++round){for(unsigned kind=0;kind<3;++kind){auto& id=identities[round*3+kind];id=identity(hash);id.request_id="joint-"+std::to_string(round)+"-"+std::to_string(kind);}
  auto pref=queue.enqueue(identities[round*3+2],cache::Kind::Prefetch,264);auto expert=queue.enqueue(identities[round*3],cache::Kind::Expert,65536);auto row=queue.enqueue(identities[round*3+1],cache::Kind::Row,264);need(pref&&expert&&row,"both demand backlogs and lower prefetch");
  for(unsigned kind=0;kind<2;++kind){auto token=queue.issue();need(token&&token->index==(kind?row->index:expert->index),"actual fair issue alternates Expert then Row");auto view=queue.view(*token);auto& id=identities[round*3+kind];uint64_t bytes=kind?264:65536;
   std::vector<artifact::FixtureView> views;std::vector<io::Span> spans;
   if(kind){auto bound=d.bindings[round];views={bound.physical};spans={{0,bound.logical.absolute_offset,264,0}};std::ifstream f(bound.physical.path,std::ios::binary);f.read(reinterpret_cast<char*>(expected.data()),264);need(bool(f),"joint row reference");}
   else{views={{original,0,original_size}};spans={{0,base+round*65536,65536,0}};std::ifstream f(reference,std::ios::binary);f.seekg(round*65536);f.read(reinterpret_cast<char*>(expected.data()),65536);need(bool(f),"joint fixed expert reference");}
   io::Config c;c.max_outstanding=1;c.max_outstanding_bytes=65536;c.max_chunk=65536;c.request_slots=1;io::SpanProvider provider(views,readbuffers,c);auto ticket=provider.enqueue(spans,{reinterpret_cast<void*>(view.source.address),65536},id,*token);need(bool(ticket),"joint read before actual copy");
   while(!provider.done(*ticket)){provider.issue();provider.poll(10);}auto result=provider.take(*ticket,id);need(result.ok&&result.bytes==bytes&&provider.try_close(),"joint actual bounded read");auto count=provider.stats();logical+=count.logical_delivered;requested+=count.read_requested;received+=count.received;
   std::memcpy(reinterpret_cast<void*>(view.stage.address),reinterpret_cast<void*>(view.source.address),bytes);queue.stage_copied(*token);queue.begin_dma(*token,owner);hip(hipMemcpyAsync(reinterpret_cast<void*>(view.device.address),reinterpret_cast<void*>(view.stage.address),bytes,hipMemcpyHostToDevice,stream));hip(hipEventRecord(dma,stream));hip(hipEventSynchronize(dma));need(queue.complete_dma(*token,owner,true,id),"joint DMA real event");
   queue.begin_kernel(*token,owner);hip(hipMemcpyAsync(actual.data(),reinterpret_cast<void*>(view.device.address),bytes,hipMemcpyDeviceToHost,stream));hip(hipEventRecord(consumer,stream));hip(hipEventSynchronize(consumer));need(std::memcmp(actual.data(),expected.data(),bytes)==0&&queue.complete_kernel(*token,owner,true,id),"joint byte consumer event/readback");if(order.tellp()>0)order<<',';order<<quote(kind?"Row":"Expert");
  }
  queue.cancel(identities[round*3+2]);need(queue.live_jobs()==0&&queue.queued_bytes()==0&&queue.leased_bytes()==0,"cancelled prefetch returns credits");
 }
 hip(hipEventDestroy(consumer));hip(hipEventDestroy(dma));hip(hipStreamDestroy(stream));uint64_t pinned_bytes=0;for(unsigned i=0;i<2;++i){if(pinned[i]){pinned_bytes+=65536;hip(hipHostFree(stage[i]));}else _aligned_free(stage[i]);hip(hipFree(device_buffers[i]));_aligned_free(source[i]);_aligned_free(io_raw[i]);}
 std::ostringstream out;out<<"{\"order\":["<<order.str()<<"],\"logical\":"<<logical<<",\"requested\":"<<requested<<",\"received\":"<<received<<",\"weight_h2d\":"<<logical<<",\"readback\":"<<logical<<",\"host_pool\":524288,\"device_pool\":131072,\"pinned_subset\":"<<pinned_bytes<<",\"remaining_jobs\":"<<queue.live_jobs()<<",\"remaining_credits\":"<<queue.queued_bytes()<<",\"physical_path\":null}";return out.str();
}
void gpu(const std::string& pci,const fs::path& input,const fs::path& output,const std::string& hash){int device=-1,count=0;hip(hipGetDeviceCount(&count));for(int i=0;i<count;++i){char actual[64];hip(hipDeviceGetPCIBusId(actual,sizeof(actual),i));if(pci==actual)device=i;}need(device>=0,"exact PCI");hip(hipSetDevice(device));hipDeviceProp_t prop;hip(hipGetDeviceProperties(&prop,device));size_t free=0,total=0;auto memory=hipMemGetInfo(&free,&total);if(memory==hipSuccess)need(free>16*1024*1024,"small allocation budget");Data data(input);auto id=identity(hash);std::string joint=joint_io(device,input,data,hash);std::ostringstream capacities,trace;std::vector<float> all_fp;std::vector<uint16_t> all_bf;
 {OwnedRow guard({8,16,8,8,device},*data.artifact,data.bindings);auto& p=guard.value();for(size_t i=0;i<data.lookups.size();i+=8){std::vector<cache::RowLookup> rows(data.lookups.begin()+i,data.lookups.begin()+i+8);auto t=enqueue(p,rows,id);auto before=p.stats();need(p.issue_reads(0,4096)==0&&p.issue_reads(1,4095)==0,"no grant no read");for(unsigned poll=0;poll<3;++poll){p.poll_io();p.poll_device();}need(p.stats().issued==before.issued,"poll never starts read");auto r=finish(p,t,id);all_fp.insert(all_fp.end(),r.fp32.begin(),r.fp32.end());all_bf.insert(all_bf.end(),r.bf16.begin(),r.bf16.end());}write(output/"all-fp32.bin",all_fp);write(output/"all-bf16.bin",all_bf);capacities<<stats(p.stats());need(p.try_close(),"all rows real drain");}
 for(size_t slots:{2u,1u}){
 OwnedRow guard({slots,16,8,8,device},*data.artifact,data.bindings);auto& p=guard.value();auto A=data.lookups[0],B=data.lookups[1],C=data.lookups[2];
 auto step=[&](const std::string& name,const std::vector<cache::RowLookup>& rows,uint64_t expected_read,uint64_t expected_h2d){auto before=p.stats();auto r=finish(p,enqueue(p,rows,id),id);auto after=p.stats();need(after.logical_read-before.logical_read==expected_read&&after.weight_h2d-before.weight_h2d==expected_h2d,"manual trace exact deltas");result_files(output,"S"+std::to_string(slots)+"-"+name,r);if(trace.tellp()>0)trace<<',';trace<<"{\"slots\":"<<slots<<",\"case\":"<<quote(name)<<",\"read\":"<<after.logical_read-before.logical_read<<",\"H2D\":"<<after.weight_h2d-before.weight_h2d<<'}';};
 step("coldA",{A,A,A},264,264);step("GPU-A",{A},0,0);if(slots==2){step("coldB",{B},264,264);step("GPU-ABA",{A,B,A},0,0);}need(p.evict(A),"idle row evict");step("RAM-A",{A},0,264);need(p.evict(A),"idle evict SSD trace");p.evict_ram();step("SSD-A",{A},264,264);
 // A shared fill owns storage independently of its first/cancelled waiter.
 for(unsigned phase=0;phase<3;++phase){need(p.evict(A),"dedup setup evict");p.evict_ram();cache::Token first,second;auto before=p.stats();{
  auto caller=id;caller.request_id="first-owned-storage";std::vector<cache::RowLookup> caller_rows{A};first=enqueue(p,caller_rows,caller);p.issue_reads(1,4096);auto other=id;other.request_id="remaining-waiter";second=enqueue(p,{A},other);
  if(phase==1)p.poll_io(10);if(phase==2){auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(60);while(!p.fill_dma()){need(std::chrono::steady_clock::now()<deadline,"DMA fixture deadline");p.issue_reads(1,4096);p.poll_io(10);}}
  p.cancel(first);need(p.take(first,caller).cancelled,"cancelled waiter can leave scope");caller.request_id.assign(4096,'X');caller_rows.assign(128,C);
 }auto other=id;other.request_id="remaining-waiter";auto r=finish(p,second,other);result_files(output,"S"+std::to_string(slots)+"-shared-"+std::to_string(phase),r);auto after=p.stats();need(after.logical_read-before.logical_read==264&&after.weight_h2d-before.weight_h2d==264,"shared fill one read/H2D after caller destruction");}
 need(p.evict(A),"cancelall setup");p.evict_ram();auto a=enqueue(p,{A},id);p.issue_reads(1,4096);auto b=enqueue(p,{A},id);p.cancel(a);p.take(a,id);p.cancel(b);p.take(b,id);auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(60);while(p.fill_pending()){need(std::chrono::steady_clock::now()<deadline,"cancelall drain deadline");p.poll_io(10);p.poll_device();}auto next=id;++next.epoch;result_files(output,"S"+std::to_string(slots)+"-next",finish(p,enqueue(p,{A},next),next));
 if(slots==2){auto a=enqueue(p,{A},id);p.poll_device();need(p.state(a)==cache::RowState::Ready,"Ready row state");auto before=p.progress(a);if(count>1){hip(hipSetDevice(device==0?1:0));rejects([&]{p.launch_gather(a);});hip(hipSetDevice(device));}need(before.readers==1&&!p.evict(A)&&!p.try_close(),"Ready lease blocks evict/free");auto b=enqueue(p,{C},id);p.issue_reads(1,4096);auto fill_deadline=std::chrono::steady_clock::now()+std::chrono::seconds(60);while(p.fill_pending()){need(std::chrono::steady_clock::now()<fill_deadline,"Ready spare fill deadline");p.issue_reads(1,4096);p.poll_io(10);p.poll_device();}auto after=p.progress(a);need(after.address==before.address&&after.generation==before.generation&&after.readers==1,"Ready A held while another slot fills");p.launch_gather(a);rejects([&]{p.launch_gather(a);});rejects([&]{p.download(a);});need(!p.evict(A),"actual kernel reader lease held until event poll");result_files(output,"S2-ready-A",finish(p,a,id));result_files(output,"S2-ready-C",finish(p,b,id));}
 capacities<<','<<stats(p.stats());need(p.try_close(),"row owner drained all leases");
