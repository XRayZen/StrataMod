// Reuse the accepted original-source fixture loader and independent host checks.
#define main historical_t20_main
#include "../core/core_fixture.cpp"
#undef main
#include "../../models/deepseek41/execution/layer_split.hpp"
#include <set>
struct LayerCapture final:DeviceAudit {
 fs::path directory;uint64_t position=0;uint32_t layer=0;std::set<std::string>names;std::ofstream index;uint64_t bytes=0;
 explicit LayerCapture(fs::path p):directory(std::move(p)),index(directory/"stages.tsv"){}
 void frame(uint64_t p,uint32_t l)override{position=p;layer=l;}
 void stage(const std::string&name,const DeviceView&v,void*stream)override{
  auto key=std::to_string(position)+"-layer"+std::to_string(layer)+"-"+name;must(names.insert(key).second,"duplicate native stage");
  auto logical_rows=name=="attention_window"?std::min<uint64_t>(position+1,128):v.rows;must(logical_rows<=v.rows,"valid audit prefix");const auto n=logical_rows*v.columns*scalar_bytes(v.scalar);std::vector<uint8_t>data(static_cast<size_t>(n));hip_ok(hipMemcpyAsync(data.data(),v.data,size_t(n),hipMemcpyDeviceToHost,reinterpret_cast<hipStream_t>(stream)));hip_ok(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream)));write_file(directory/(key+".bin"),data);
  index<<position<<'\t'<<layer<<'\t'<<name<<'\t'<<logical_rows<<'\t'<<v.columns<<'\t'<<int(v.scalar)<<'\t'<<n<<'\t'<<key+".bin"<<'\n';index.flush();bytes+=n;
 }
};

template<class T>struct SplitFixtureClose {void operator()(T*p)const noexcept{if(!p)return;try{if(p->try_close())delete p;}catch(...){}};};
struct SplitTrace:LayerSplitAudit {
 fs::path directory;std::ofstream boundaries,transfers,events;uint64_t sequence=0;
 explicit SplitTrace(const fs::path&p):directory(p),boundaries(p/"boundaries.tsv"),transfers(p/"transfers.tsv"),events(p/"events.tsv"){}
 void event(uint64_t pos,const char*name)override{events<<sequence++<<'\t'<<pos<<'\t'<<name<<'\n';events.flush();}
 void transfer(const PartitionBoundary&boundary,uint64_t ordinal,const strata_ext::device::TransferStats&s)override{transfers<<boundary.identity.request_id<<'\t'<<boundary.identity.epoch<<'\t'<<boundary.generation<<'\t'<<boundary.position<<'\t'<<ordinal<<'\t'<<s.bytes<<'\t'<<s.path<<'\t'<<s.peer_bytes<<'\t'<<s.bounce_d2h<<'\t'<<s.bounce_h2d<<'\t'<<s.capability_status<<'\t'<<s.can_access<<'\t'<<s.enable_status<<'\t'<<s.peer_copy_status<<'\t'<<s.disable_status<<'\t'<<s.return_record_status<<'\t'<<s.return_drain_status<<'\t'<<s.cancelled<<'\n';transfers.flush();}
 void boundary(const PartitionBoundary&source,const PartitionBoundary&target)override{
  auto record=[&](const std::string&name,const DeviceView&view){auto n=view.rows*view.columns*scalar_bytes(view.scalar);std::vector<uint8_t>data(size_t(n),0);if(n){hip_ok(hipSetDevice(view.device));hip_ok(hipMemcpy(data.data(),view.data,n,hipMemcpyDeviceToHost));}auto file=std::to_string(source.position)+"-boundary-"+name+".bin";write_file(directory/file,data);boundaries<<source.identity.request_id<<'\t'<<source.identity.epoch<<'\t'<<source.position<<'\t'<<source.generation<<'\t'<<source.next_layer<<'\t'<<name<<'\t'<<view.rows<<'\t'<<view.columns<<'\t'<<int(view.scalar)<<'\t'<<n<<'\t'<<file<<'\n';};
  int previous=-1;hip_ok(hipGetDevice(&previous));try{record("residual",target.residual);record("pre",target.pre);for(auto&item:target.shared)record(std::to_string(int(item.kind))+"-"+std::to_string(item.writer),item.value);hip_ok(hipSetDevice(previous));}catch(...){hipSetDevice(previous);throw;}boundaries.flush();
 }
};
void split_stats(const fs::path&output,const LayerSplitStats&s){std::ofstream f(output/"split-stats.tsv");f<<"payload\t"<<s.boundary_payload<<'\t'<<s.new_kv<<'\t'<<s.new_keys<<'\t'<<s.selected<<'\t'<<s.candidates<<'\n';f<<"actual_transfer\t"<<s.peer_bytes<<'\t'<<s.bounce_d2h<<'\t'<<s.bounce_h2d<<'\n';f<<"requested_logits_d2h\t"<<s.requested_logits_d2h<<'\n';f<<"owned\t"<<s.primary_device_owned<<'\t'<<s.secondary_device_owned<<'\t'<<s.bounce_host_owned<<'\n';for(auto pair:{std::make_pair("primary",&s.primary),std::make_pair("secondary",&s.secondary)}){auto&c=*pair.second;f<<pair.first<<"_core\t"<<c.storage_device_owned<<'\t'<<c.constant_source_bytes<<'\t'<<c.storage_upload_bytes<<'\t'<<c.requested_output_or_fixture_download_bytes<<'\n';f<<pair.first<<"_positions";for(auto x:c.state_positions)f<<'\t'<<x;f<<'\n'<<pair.first<<"_compressed";for(auto x:c.compressed_rows)f<<'\t'<<x;f<<'\n'<<pair.first<<"_keys";for(auto x:c.key_rows)f<<'\t'<<x;f<<'\n';}}

void fixture_copy(const DeviceView&source,const DeviceView&destination,void*ss,void*ds,uint64_t offset,uint64_t bytes,std::ofstream&trace,uint64_t id,strata_ext::device::Policy policy){
 using namespace strata_ext;must(bytes&&offset<=source.bytes&&bytes<=source.bytes-offset&&offset<=destination.bytes&&bytes<=destination.bytes-offset,"small actual copy extent");std::vector<uint8_t>bounce(bytes);auto sp=static_cast<char*>(source.data)+offset,dp=static_cast<char*>(destination.data)+offset;cache::ResidentSlot src{reinterpret_cast<uintptr_t>(sp),bytes,id*2+1,1,0,false,true,false},dst{reinterpret_cast<uintptr_t>(dp),bytes,id*2+2,0,0,false,false,false};hip_ok(hipSetDevice(destination.device));device::CopyTask copy({sp,bytes,source.device,reinterpret_cast<hipStream_t>(ss),&src,src.owner,src.generation},{dp,bytes,destination.device,reinterpret_cast<hipStream_t>(ds),&dst,dst.owner,dst.generation},bounce.data(),bounce.size(),policy);
 try{copy.submit(bytes);while(copy.phase()!=device::Phase::Ready){copy.poll();must(copy.phase()!=device::Phase::Quarantined,"small copy completion");}must(!copy.try_close(),"Ready early close rejected");must(!cache::reserve_fill(dst,dst.owner,bytes),"Ready early reuse rejected");std::vector<uint8_t>consumer(bytes);hip_ok(hipMemcpyAsync(consumer.data(),dp,bytes,hipMemcpyDeviceToHost,reinterpret_cast<hipStream_t>(ds)));if(id==0)copy.cancel();copy.consumer_done_on(reinterpret_cast<hipStream_t>(ds));while(copy.phase()!=device::Phase::Done){copy.poll();must(copy.phase()!=device::Phase::Quarantined,"small consumer completion");}must(copy.try_close(),"small actual copy close");auto reuse=cache::reserve_fill(dst,dst.owner,bytes);must(bool(reuse)&&dst.generation==2,"actual next generation after event");cache::complete_resident(*reuse,dst.owner,true,false);auto c=copy.stats();trace<<id<<'\t'<<bytes<<'\t'<<c.path<<'\t'<<c.peer_bytes<<'\t'<<c.bounce_d2h<<'\t'<<c.bounce_h2d<<'\t'<<c.capability_status<<'\t'<<c.can_access<<'\t'<<c.enable_status<<'\t'<<c.peer_copy_status<<'\t'<<c.disable_status<<'\t'<<c.return_record_status<<'\t'<<c.return_drain_status<<'\t'<<c.cancelled<<'\n';}
 catch(...){copy.cancel();while(copy.phase()!=device::Phase::Done){if(copy.phase()==device::Phase::Ready)copy.consumer_done_on(reinterpret_cast<hipStream_t>(ds));else copy.poll();if(copy.phase()==device::Phase::Quarantined)std::terminate();}if(!copy.try_close())std::terminate();throw;}
}
int transport_fixture(const fs::path&out,const strata_ext::device::Roles&roles,strata_ext::device::Policy policy){
 using namespace strata_ext;CoreStorage p(roles.primary.ordinal),s(roles.secondary->ordinal);hip_ok(hipSetDevice(roles.primary.ordinal));auto kv=p.allocate("source-kv",2,512,DeviceScalar::Bfloat16InFloat32),key=p.allocate("source-key",2,128,DeviceScalar::Bfloat16InFloat32),selected=p.allocate("source-selected",1,2,DeviceScalar::Int32);hip_ok(hipSetDevice(roles.secondary->ordinal));auto kvs=s.allocate("mirror-kv",2,512,DeviceScalar::Bfloat16InFloat32),keys=s.allocate("mirror-key",2,128,DeviceScalar::Bfloat16InFloat32),sels=s.allocate("mirror-selected",1,2,DeviceScalar::Int32);hip_ok(hipMemset(kvs.data,0xcd,kvs.bytes));hip_ok(hipMemset(keys.data,0xcd,keys.bytes));hip_ok(hipMemset(sels.data,0xcd,sels.bytes));std::vector<float>kvdata(1024),keydata(256);for(size_t i=0;i<kvdata.size();++i)kvdata[i]=float(int(i%29)-14);for(size_t i=0;i<keydata.size();++i)keydata[i]=float(int(i%13)-6);int32_t selection[2]={129,128};hip_ok(hipSetDevice(roles.primary.ordinal));p.upload(kv,kvdata.data(),kv.bytes);p.upload(key,keydata.data(),key.bytes);p.upload(selected,selection,sizeof(selection));auto identity=fixture_identity();identity.request_id="T45-controlled-transport";identity.epoch=3;unsigned rejects=0;auto reject=[&](const std::function<void()>&f){bool bad=false;try{f();}catch(const std::exception&){bad=true;}must(bad,"small invalid accepted");++rejects;};std::ofstream trace(out/"small-transfers.tsv"),meta(out/"small-metadata.tsv");uint64_t ordinal=0,mirrored=0;
 for(uint64_t position=0;position<4;++position){auto rows=(position+1)/2;selection[0]=rows<2?128:129;hip_ok(hipSetDevice(roles.primary.ordinal));p.upload(selected,selection,sizeof(selection));for(auto kind:{PartitionDataKind::Compressed,PartitionDataKind::IndexKeys,PartitionDataKind::Selection}){PartitionShared item;item.kind=kind;item.writer=item.compressor=2;item.ratio=2;item.position=position;item.epoch=identity.epoch;item.published_rows=rows;item.valid=true;item.value=kind==PartitionDataKind::Compressed?kv:kind==PartitionDataKind::IndexKeys?key:selected;auto target=kind==PartitionDataKind::Compressed?kvs:kind==PartitionDataKind::IndexKeys?keys:sels;if(kind==PartitionDataKind::Selection){item.value.columns=rows;target.columns=rows;}else{item.value.rows=rows;target.rows=rows;}validate_split_shared(item,identity,position,3);auto bad=item;++bad.epoch;reject([&]{validate_split_shared(bad,identity,position,3);});bad=item;bad.writer=8;reject([&]{validate_split_shared(bad,identity,position,3);});bad=item;++bad.published_rows;reject([&]{validate_split_shared(bad,identity,position,3);});bad=item;bad.value.generation=0;reject([&]{validate_split_shared(bad,identity,position,3);});
  auto offset=kind==PartitionDataKind::Selection?0:mirrored*item.value.columns*4;auto bytes=kind==PartitionDataKind::Selection?rows*4:(rows-mirrored)*item.value.columns*4;if(bytes)fixture_copy(item.value,target,p.stream(),s.stream(),offset,bytes,trace,ordinal++,policy);auto n=target.rows*target.columns*4;std::vector<uint8_t>data(size_t(n),0);hip_ok(hipSetDevice(roles.secondary->ordinal));if(n)s.download(target,data.data(),n);auto file=std::to_string(position)+"-small-"+std::to_string(int(kind))+".bin";write_file(out/file,data);meta<<position<<'\t'<<int(kind)<<'\t'<<item.writer<<'\t'<<item.ratio<<'\t'<<identity.epoch<<'\t'<<rows<<'\t'<<bytes<<'\t'<<n<<'\t'<<file<<'\n';}mirrored=rows;}
 // Synthetic typed tap is the accepted HC0->1->2->3 host arithmetic contract,
 // not an actual target-layer extraction or draft producer.
 hip_ok(hipSetDevice(roles.secondary->ordinal));auto tap=s.allocate("tap-source",1,15360,DeviceScalar::Bfloat16InFloat32);hip_ok(hipSetDevice(roles.primary.ordinal));auto tap_dest=p.allocate("tap-destination",1,15360,DeviceScalar::Bfloat16InFloat32);hip_ok(hipMemset(tap_dest.data,0xff,tap_dest.bytes));std::vector<float>data(15360);for(size_t i=0;i<data.size();++i){auto tag=(i/5120+i%3)%3;float hc[4];for(unsigned j=0;j<4;++j)hc[j]=tag==0?-0.f:tag==1?float(j+1):(j%2?.50390625f:.5f);float v=hc[0];for(unsigned j=1;j<4;++j)v=v+hc[j];v=v*.25f;uint32_t bits;std::memcpy(&bits,&v,4);bits=(bits+0x7fff+((bits>>16)&1))&0xffff0000;std::memcpy(&data[i],&bits,4);}hip_ok(hipSetDevice(roles.secondary->ordinal));s.upload(tap,data.data(),tap.bytes);LayerTapView t{identity,tap,{0},1,1,tap.generation,{37,38,39},s.stream()};validate_layer_tap(t,identity,{0},tap.device);auto bad=t;std::swap(bad.layers[0],bad.layers[1]);reject([&]{validate_layer_tap(bad,identity,{0},tap.device);});bad=t;bad.value.scalar=DeviceScalar::Float32;reject([&]{validate_layer_tap(bad,identity,{0},tap.device);});bad=t;++bad.generation;reject([&]{validate_layer_tap(bad,identity,{0},tap.device);});bad=t;bad.positions={1};reject([&]{validate_layer_tap(bad,identity,{0},tap.device);});bad=t;bad.producer_stream=p.stream();reject([&]{validate_layer_tap(bad,identity,{0},tap.device);});fixture_copy(tap,tap_dest,s.stream(),p.stream(),0,tap.bytes,trace,ordinal++,policy);hip_ok(hipSetDevice(roles.primary.ordinal));std::vector<float>got(15360);p.download(tap_dest,got.data(),tap_dest.bytes);write_file(out/"tap.bin",got);std::ofstream controls(out/"small-controls.tsv");controls<<"rejections\t"<<rejects<<"\ncopy_count\t"<<ordinal<<"\nactual_consumer_d2h\t66576\nlease_early_checks\t16\n";return 0;
}
namespace strata_ext::deepseek41 {void t45_fail_next_publication();}
int api_fixture(const fs::path&input,const fs::path&out,const strata_ext::device::Roles&roles){
 using namespace strata_ext;auto artifact=load_artifact(input);std::ifstream pf(input/"prefixes.tsv");std::string line;must(bool(std::getline(pf,line)),"metadata");auto e=engram::inspect_metadata(fs::u8path(fields(line).at(1)));auto src=artifact.source_tensor("per_layer_token_embd.weight").source;auto views=[&]{return cache::RowSourceViews({{src,{src.original_path,0,src.original_size}}});};hip_ok(hipSetDevice(roles.primary.ordinal));std::unique_ptr<cache::PrimarySupply,SplitFixtureClose<cache::PrimarySupply>> p(new cache::PrimarySupply({2,2,2097152,4,4,roles.primary.ordinal,true}));hip_ok(hipSetDevice(roles.secondary->ordinal));std::unique_ptr<cache::PrimarySupply,SplitFixtureClose<cache::PrimarySupply>> s(new cache::PrimarySupply({2,2,2097152,4,4,roles.secondary->ordinal,true}));std::unique_ptr<cache::RowSupply,SplitFixtureClose<cache::RowSupply>> r(new cache::RowSupply({24,24,1,1,roles.secondary->ordinal},artifact,views()));CoreConfig pc,sc;pc.device=roles.primary.ordinal;sc.device=roles.secondary->ordinal;auto id=fixture_identity();id.request_id="T45-api";unsigned rejects=0,positive=0;auto reject=[&](const std::function<void()>&f){bool bad=false;try{f();}catch(const std::exception&){bad=true;}must(bad,"invalid partition API accepted");++rejects;};
 {CorePartition first(artifact,e,*p,nullptr,id,pc,3,{0,1});CorePartition last(artifact,e,*s,r.get(),id,sc,3,{1,40},&first);auto b=first.advance(3,0,false,nullptr,false);auto target=last.targets(b);++positive;auto stale=b;++stale.generation;reject([&]{last.targets(stale);});first.invalidate_and_drain();reject([&]{last.targets(b);});first.retire_boundary(b.generation,b.stream);++positive;}
 {CorePartition failed(artifact,e,*p,nullptr,id,pc,3,{0,1});t45_fail_next_publication();bool rejected=false;try{failed.advance(3,0,false,nullptr,false);}catch(const std::bad_alloc&){rejected=true;}must(rejected,"exact controlled boundary publication bad_alloc");++rejects;reject([&]{failed.advance(3,0,false,nullptr,false);});++positive;}
 {CorePartition failed(artifact,e,*p,nullptr,id,pc,3,{0,1});bool rejected=false;try{failed.advance(3,0,false,nullptr,false,[]{throw std::runtime_error("fixture layer boundary failure");});}catch(const std::exception&x){must(std::string(x.what())=="fixture layer boundary failure","original layer failure preserved");rejected=true;}must(rejected,"actual layer callback failure");++rejects;reject([&]{failed.advance(3,0,false,nullptr,false);});++positive;}
 {CorePartition fresh(artifact,e,*p,nullptr,id,pc,3,{0,1});auto b=fresh.advance(3,0,false,nullptr,false);std::vector<float>value(20480),pre(4);hip_ok(hipSetDevice(pc.device));hip_ok(hipMemcpy(value.data(),b.residual.data,value.size()*4,hipMemcpyDeviceToHost));hip_ok(hipMemcpy(pre.data(),b.pre.data,16,hipMemcpyDeviceToHost));write_file(out/"fresh-layer0.bin",value);write_file(out/"fresh-pre.bin",pre);fresh.retire_boundary(b.generation,b.stream);++positive;}
 hip_ok(hipSetDevice(roles.secondary->ordinal));must(s->try_close()&&r->try_close(),"API secondary owner close");hip_ok(hipSetDevice(roles.primary.ordinal));must(p->try_close(),"API primary owner close");std::ofstream controls(out/"api-controls.tsv");controls<<"rejections\t"<<rejects<<"\npositive\t"<<positive<<'\n';return 0;
}

struct CancelTrace final:SplitTrace {using SplitTrace::SplitTrace;void event(uint64_t p,const char*name)override{SplitTrace::event(p,name);if(std::string(name)=="boundary-copy-ready")throw std::runtime_error("fixture cancel at ready boundary");}};
int cancel_fixture(const fs::path&input,const fs::path&out,const strata_ext::device::Roles&roles){
 using namespace strata_ext;auto artifact=load_artifact(input);std::ifstream pf(input/"prefixes.tsv");std::string line;must(bool(std::getline(pf,line)),"metadata");auto e=engram::inspect_metadata(fs::u8path(fields(line).at(1)));auto src=artifact.source_tensor("per_layer_token_embd.weight").source;hip_ok(hipSetDevice(roles.primary.ordinal));std::unique_ptr<cache::PrimarySupply,SplitFixtureClose<cache::PrimarySupply>> p(new cache::PrimarySupply({2,2,2097152,4,4,roles.primary.ordinal,true}));std::unique_ptr<cache::RowSupply,SplitFixtureClose<cache::RowSupply>> r(new cache::RowSupply({24,24,1,1,roles.primary.ordinal},artifact,cache::RowSourceViews({{src,{src.original_path,0,src.original_size}}})));hip_ok(hipSetDevice(roles.secondary->ordinal));std::unique_ptr<cache::PrimarySupply,SplitFixtureClose<cache::PrimarySupply>> s(new cache::PrimarySupply({2,2,2097152,4,4,roles.secondary->ordinal,true}));LayerSplitConfig cfg;cfg.roles=roles;cfg.primary.device=roles.primary.ordinal;cfg.secondary.device=roles.secondary->ordinal;auto id=fixture_identity();id.request_id="T45-cancel";unsigned rejects=0,positive=0;
 {LayerSplit before(artifact,e,*p,r.get(),*s,nullptr,id,cfg,3);auto result=before.prefill({3,37},0,{},[](uint64_t,uint64_t){return false;});auto stats=before.stats();must(result.cancelled&&!result.rows&&!result.processed&&result.logits.empty()&&!stats.boundary_payload&&!stats.requested_logits_d2h,"before-issue cancel without payload/head");must(before.try_close(),"before-issue close");++positive;}
 {CancelTrace trace(out);cfg.audit=&trace;LayerSplit active(artifact,e,*p,r.get(),*s,nullptr,id,cfg,3);bool failed=false;try{active.step(3,0);}catch(const std::exception&x){must(std::string(x.what())=="fixture cancel at ready boundary","original known callback failure preserved");failed=true;}must(failed,"Ready boundary failure must propagate");++rejects;must(active.position()==0,"failed paired position uncommitted");bool late=false;try{active.step(37,0);}catch(const std::exception&){late=true;}must(late,"cancelled paired request rejects late next");++rejects;split_stats(out,active.stats());must(active.try_close(),"Ready cancelled copies/partitions drain");++positive;}
 {CoreConfig c;c.device=roles.primary.ordinal;id.request_id="T45-fresh-after-boundary";++id.epoch;CorePartition fresh(artifact,e,*p,nullptr,id,c,3,{0,1});auto b=fresh.advance(3,0,false,nullptr,false);std::vector<float>value(20480),pre(4);hip_ok(hipSetDevice(c.device));hip_ok(hipMemcpy(value.data(),b.residual.data,value.size()*4,hipMemcpyDeviceToHost));hip_ok(hipMemcpy(pre.data(),b.pre.data,16,hipMemcpyDeviceToHost));write_file(out/"fresh-layer0.bin",value);write_file(out/"fresh-pre.bin",pre);fresh.retire_boundary(b.generation,b.stream);++positive;}
 hip_ok(hipSetDevice(roles.secondary->ordinal));must(s->try_close(),"cancel secondary supply close");hip_ok(hipSetDevice(roles.primary.ordinal));must(p->try_close()&&r->try_close(),"cancel/fresh primary supplies close");std::ofstream controls(out/"cancel-controls.tsv");controls<<"rejections\t"<<rejects<<"\npositive\t"<<positive<<'\n';return 0;
}
static bool check_final_head=false;static uint64_t final_head_guard_checks=0;
namespace strata_ext::deepseek41 {void t45_check_last_output_guard(CorePartition&partition,const PartitionBoundary&boundary){if(!check_final_head||boundary.position!=2)return;partition.invalidate_and_drain();bool rejected=false;try{partition.download_logits(boundary);}catch(const std::exception&){rejected=true;}must(rejected,"invalidated final borrowed head output accepted");++final_head_guard_checks;}}

void fixture_finish(const fs::path&out,const strata_ext::device::Roles&roles){std::ofstream identity(out/"roles.tsv");for(auto*role:{&roles.primary,&*roles.secondary})identity<<role->ordinal<<'\t'<<role->pci<<'\t'<<role->arch<<'\n';HMODULE handles[2048];DWORD needed=0;must(EnumProcessModules(GetCurrentProcess(),handles,sizeof(handles),&needed)&&needed<=sizeof(handles),"runtime modules");std::ofstream modules(out/"loaded-modules.txt");for(size_t i=0;i<needed/sizeof(HMODULE);++i){char path[32768]{};must(GetModuleFileNameA(handles[i],path,sizeof(path))>0,"module path");modules<<path<<'\n';}std::cout<<"{\"source_id\":\""<<T20_SOURCE_ID<<"\",\"caller_comparison_required\":true,\"whole_t45_qualified\":false}\n";}
int main(int argc,char**argv){try{
 if(argc==2&&std::string(argv[1])=="--host")return historical_t20_main(argc,argv);
 must(argc==7,"usage --full|--transport|--api input output primaryPCI secondaryPCI auto|bounce");auto input=fs::u8path(argv[2]),output=fs::u8path(argv[3]);fs::create_directories(output);auto roles=strata_ext::device::resolve(strata_ext::device::inventory(),argv[4],std::string(argv[5]));must(std::string(argv[6])=="auto"||std::string(argv[6])=="bounce","copy policy");if(std::string(argv[1])=="--transport"){transport_fixture(output,roles,std::string(argv[6])=="bounce"?strata_ext::device::Policy::HostBounce:strata_ext::device::Policy::Auto);fixture_finish(output,roles);return 0;}if(std::string(argv[1])=="--api"){api_fixture(input,output,roles);fixture_finish(output,roles);return 0;}if(std::string(argv[1])=="--cancel"){cancel_fixture(input,output,roles);fixture_finish(output,roles);return 0;}must(std::string(argv[1])=="--full","fixture mode");fs::create_directories(output/"cancel-prefix");cancel_fixture(input,output/"cancel-prefix",roles);hip_ok(hipSetDevice(roles.primary.ordinal));auto artifact=load_artifact(input);std::ifstream pf(input/"prefixes.tsv");std::string line;must(bool(std::getline(pf,line)),"Engram metadata");auto engram_config=engram::inspect_metadata(fs::u8path(fields(line).at(1)));auto source=artifact.source_tensor("per_layer_token_embd.weight").source;
 std::unique_ptr<strata_ext::cache::PrimarySupply,SplitFixtureClose<strata_ext::cache::PrimarySupply>> p(new strata_ext::cache::PrimarySupply({2,2,2097152,4,4,roles.primary.ordinal,true}));
 std::unique_ptr<strata_ext::cache::RowSupply,SplitFixtureClose<strata_ext::cache::RowSupply>> rows(new strata_ext::cache::RowSupply({24,24,1,1,roles.primary.ordinal},artifact,strata_ext::cache::RowSourceViews({{source,{source.original_path,0,source.original_size}}})));
 hip_ok(hipSetDevice(roles.secondary->ordinal));std::unique_ptr<strata_ext::cache::PrimarySupply,SplitFixtureClose<strata_ext::cache::PrimarySupply>> s(new strata_ext::cache::PrimarySupply({2,2,2097152,4,4,roles.secondary->ordinal,true}));
 auto id=fixture_identity();id.request_id="T45-full40";LayerCapture audit(output);SplitTrace trace(output);LayerSplitConfig config;config.roles=roles;config.primary.device=roles.primary.ordinal;config.secondary.device=roles.secondary->ordinal;config.primary.audit=config.secondary.audit=&audit;config.primary.full_logits=config.secondary.full_logits=true;config.audit=&trace;must(std::string(argv[6])=="auto"||std::string(argv[6])=="bounce","copy policy");config.copy_policy=std::string(argv[6])=="bounce"?strata_ext::device::Policy::HostBounce:strata_ext::device::Policy::Auto;
 check_final_head=true;auto split=std::make_unique<LayerSplit>(artifact,engram_config,*p,rows.get(),*s,nullptr,id,config,3);auto first=split->prefill({3,37},0);must(!first.cancelled&&first.processed==2&&first.rows==2,"finite split prefill");write_file(output/"prefill2-logits.bin",first.logits);auto last=split->step(1024,2);write_file(output/"append-logits.bin",last);must(final_head_guard_checks==1,"actual existing final head guard check");{std::ofstream controls(output/"full-controls.tsv");controls<<"invalid_head_rejections\t"<<final_head_guard_checks<<'\n';}split_stats(output,split->stats());{std::ofstream counters(output/"supply-stats.tsv");for(auto pair:{std::make_pair("primary",p.get()),std::make_pair("secondary",s.get())}){auto c=pair.second->stats();counters<<pair.first<<'\t'<<c.weight_read<<'\t'<<c.weight_h2d<<'\t'<<c.aligned_read<<'\t'<<c.issued_reads<<'\t'<<c.gpu_hits<<'\t'<<c.ram_hits<<'\t'<<c.ssd_misses<<'\t'<<c.input_h2d<<'\t'<<c.output_d2h<<'\n';}auto r=rows->stats();counters<<"row\t"<<r.logical_read<<'\t'<<r.weight_h2d<<'\n';std::ofstream memory(output/"owner-memory.tsv"),stages(output/"owner-stages.tsv");for(auto pair:{std::make_pair("primary",p.get()),std::make_pair("secondary",s.get())}){auto c=pair.second->stats();memory<<pair.first<<'\t'<<c.host_owned<<'\t'<<c.metadata<<'\t'<<c.pinned_subset<<'\t'<<c.pinned_known<<'\t'<<c.pinned_observed<<'\n';for(size_t i=0;i<c.stages.size();++i){auto v=c.stages[i];stages<<pair.first<<'\t'<<i<<'\t'<<v.address<<'\t'<<v.capacity<<'\t'<<v.attempted<<'\t'<<v.status<<'\t'<<v.type<<'\n';}}memory<<"row\t"<<r.host_payload<<'\t'<<r.metadata_capacity<<'\t'<<r.pinned_subset<<'\t'<<r.pinned_known<<'\t'<<r.pinned_observed<<'\n';for(size_t i=0;i<r.stages.size();++i){auto v=r.stages[i];stages<<"row\t"<<i<<'\t'<<v[0]<<'\t'<<v[1]<<'\t'<<(v[0]!=0)<<'\t'<<v[2]<<'\t'<<v[3]<<'\n';}}must(split->try_close(),"partition actual close");split.reset();hip_ok(hipSetDevice(roles.secondary->ordinal));must(s->try_close(),"secondary supply after partition close");hip_ok(hipSetDevice(roles.primary.ordinal));must(p->try_close()&&rows->try_close(),"primary supplies after partition close");
 fixture_finish(output,roles);return 0;
