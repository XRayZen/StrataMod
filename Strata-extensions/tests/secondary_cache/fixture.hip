#include "../../native/cache/secondary_cache.hpp"
#include <strata/core/device.hpp>
#define main historical_t20_main
#include "../core/core_fixture.cpp"
#undef main
namespace {
struct RamSlotAccounting {std::vector<uint8_t>bytes;std::string key;bool valid=false,busy=false;};
unsigned construction_policy_checks(){using namespace strata_ext::cache;unsigned n=0;auto initial=std::make_exception_ptr(std::bad_alloc{});auto source=std::make_exception_ptr(std::runtime_error("original source"));for(unsigned i=0;i<2;++i){try{secondary_construction_result(i?source:initial,true,std::exception_ptr{});}catch(const std::bad_alloc&){must(i==0,"known cleanup preserves allocation type");++n;}catch(const std::runtime_error&e){must(i==1&&std::string(e.what())=="original source","known cleanup preserves original source message");++n;}}
 auto cuda=std::make_exception_ptr(strata::core::CudaError("controlled cleanup OOM",int(hipErrorOutOfMemory)));
 for(auto cleanup:{std::exception_ptr{},initial,source,cuda}){try{secondary_construction_result(initial,false,cleanup);must(false,"unknown cleanup returned");}catch(const SecondaryConstructionUnknown&e){must(e.initialization_error()==initial,"initial cause retained");must(e.cleanup_error()==cleanup,"cleanup cause retained");must(std::string(e.what()).find("construction completion unknown")!=std::string::npos,"unknown classification precedes OOM retry");n+=3;}}
 return n;
}
struct Trace final:strata_ext::cache::CacheAudit {
 std::ofstream file;
 explicit Trace(const fs::path&p):file(p){}
 void event(const strata_ext::cache::CacheTrace&e)noexcept override {
  const auto&t=e.transfer;
  file<<e.identity.request_id<<'\t'<<e.identity.epoch<<'\t'<<e.operation<<'\t'<<e.slot<<'\t'<<e.generation<<'\t'<<e.event<<'\t'<<e.source_device<<'\t'<<e.destination_device<<'\t'<<t.bytes<<'\t'<<t.local_d2d<<'\t'<<t.peer_bytes<<'\t'<<t.bounce_d2h<<'\t'<<t.bounce_h2d<<'\t'<<t.path<<'\t'<<t.capability_status<<'\t'<<t.can_access<<'\t'<<t.enable_status<<'\t'<<t.peer_copy_status<<'\t'<<t.disable_status<<'\t'<<t.return_record_status<<'\t'<<t.return_drain_status<<'\t'<<int(t.cancelled)<<'\t'<<e.key<<'\n';file.flush();
 }
};
int select_pci(const std::string&pci){int count=0;hip_ok(hipGetDeviceCount(&count));for(int d=0;d<count;++d){char id[64]{};hip_ok(hipDeviceGetPCIBusId(id,sizeof(id),d));if(pci==id)return d;}throw std::runtime_error("fixture actual PCI absent");}
void memory_sample(std::ofstream&out,const std::string&phase,uint64_t cache_payload){MEMORYSTATUSEX g{};g.dwLength=sizeof(g);auto gok=GlobalMemoryStatusEx(&g);auto ge=gok?0:GetLastError();PROCESS_MEMORY_COUNTERS_EX2 p{};p.cb=sizeof(p);auto pok=GetProcessMemoryInfo(GetCurrentProcess(),reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&p),sizeof(p));auto pe=pok?0:GetLastError();out<<phase<<'\t'<<GetTickCount64()<<'\t'<<GetCurrentProcessId()<<'\t'<<ge<<'\t'<<(gok?std::to_string(g.ullAvailPhys):"null")<<'\t'<<pe<<'\t'<<(pok?std::to_string(p.WorkingSetSize):"null")<<'\t'<<(pok?std::to_string(p.PrivateWorkingSetSize):"null")<<'\t'<<(pok?std::to_string(p.PrivateUsage):"null")<<'\t'<<cache_payload<<"\tnull\n";out.flush();}
void loaded_modules(const fs::path&output){HMODULE handles[2048];DWORD needed=0;must(EnumProcessModules(GetCurrentProcess(),handles,sizeof(handles),&needed)&&needed<=sizeof(handles),"module inventory");std::ofstream modules(output/"loaded-modules.txt");for(size_t i=0;i<needed/sizeof(HMODULE);++i){char path[32768]{};must(GetModuleFileNameA(handles[i],path,sizeof(path))>0,"module path");modules<<path<<'\n';}}
// Preserve the logical three-row accepted input. CoreProjection consumes one
// supported kernel wave, exactly as the existing tiled_projection coordinator.
void finite_project(strata_ext::deepseek41::CoreProjection&projection,const strata_ext::deepseek41::SourceTile&tile,const strata_ext::deepseek41::DeviceView&input,const strata_ext::deepseek41::DeviceView&output,void*stream){
 using namespace strata_ext::deepseek41;uint64_t from=0;
 for(auto n:batch_waves(3,8)){auto x=input,y=output;auto dx=from*x.columns*4,dy=from*y.columns*4;x.data=static_cast<uint8_t*>(x.data)+dx;x.bytes-=dx;x.rows=n;y.data=static_cast<uint8_t*>(y.data)+dy;y.bytes-=dy;y.rows=n;projection(tile,x,y,n,stream);from+=n;}
}
int unit_fixture(const fs::path&input,const fs::path&output,const std::string&primary,const std::string&secondary,size_t slots,bool bounce,uint64_t ram_payload,bool measure,bool unknown){
 using namespace strata_ext;
 const int p=select_pci(primary),s=select_pci(secondary);must(p!=s,"distinct role devices");hip_ok(hipSetDevice(p));fs::create_directories(output);
 auto artifact=load_artifact(input);Trace trace(output/"events.tsv");
 must(ram_payload>=2*65536&&ram_payload/65536<=SIZE_MAX,"fixture explicit RAM working minimum");const size_t ram_slots=size_t(ram_payload/65536);
 cache::PrimarySupply weight({2,ram_slots,65536,4,4,p,true});
 cache::SecondaryCache secondary_cache({p,s,slots,65536,bounce?device::Policy::HostBounce:device::Policy::Auto,true,&trace});
 CoreStorage storage(p);auto x=storage.allocate("input",3,5120,DeviceScalar::Float32);auto yspace=storage.allocate("output",3,2304,DeviceScalar::Float32);
 std::ofstream memory(output/"dram.tsv");memory_sample(memory,"owners-constructed",ram_slots*65536);
 if(measure){auto w=weight.stats();auto c=secondary_cache.stats();std::ofstream observation(output/"measurement.tsv");observation<<ram_slots<<'\t'<<ram_slots*65536<<'\t'<<w.host_owned<<'\t'<<w.metadata<<'\t'<<c.host_owned<<'\t'<<c.metadata<<'\n';loaded_modules(output);must(secondary_cache.try_close()&&weight.try_close(),"measurement no-operation close");std::cout<<"{\"source_id\":\""<<T20_SOURCE_ID<<"\",\"measurement_only\":true,\"model_kernel_executed\":false,\"cache_payload_zero_initialized_bytes\":"<<ram_slots*65536<<"}\n";return 0;}
 auto identity=fixture_identity();identity.request_id=unknown?"T22-controlled-unknown":"T22-packed-storage-unit";if(unknown)identity.epoch=2;
 CoreProjection baseline(weight,identity,{1,weight.read_window_capacity()});
 CoreProjection cached(weight,identity,{1,weight.read_window_capacity()},&secondary_cache);
 if(unknown){
  auto original=artifact.source_tensor("blk.0.ffn_gate_exps.weight");auto tile=source_tile(original,38,0,8);auto host=read_file<float>(input/"p0-x.bin");must(host.size()==3*5120,"controlled sealed input");storage.upload(x,host.data(),x.bytes);
  auto save_result=[&](const std::string&name,bool launch){memory_sample(memory,name+"-before",ram_slots*65536);if(launch){hip_ok(hipMemsetAsync(yspace.data,255,yspace.bytes,reinterpret_cast<hipStream_t>(storage.stream())));finite_project(cached,tile,x,yspace,storage.stream());}storage.drain();std::vector<float> result(24);hip_ok(hipMemcpy2DAsync(result.data(),32,yspace.data,2304*4,32,3,hipMemcpyDeviceToHost,reinterpret_cast<hipStream_t>(storage.stream())));storage.drain();write_file(output/(name+".bin"),result);memory_sample(memory,name+"-after",ram_slots*65536);};
  save_result("unknown-warmup",true);auto initial=secondary_cache.test_state();std::vector<uint8_t> before(tile.bytes),after(tile.bytes);hip_ok(hipMemcpyAsync(before.data(),reinterpret_cast<void*>(initial.working),before.size(),hipMemcpyDeviceToHost,reinterpret_cast<hipStream_t>(storage.stream())));storage.drain();
  for(size_t i=0;i<2;++i)must(weight.evict_device(i),"controlled primary eviction");weight.evict_ram();cache::test_unknown_hit_ready_once();save_result("unknown-fallback",true);auto held=secondary_cache.test_state();auto count=secondary_cache.stats();must(held.retained&&held.disabled&&held.jobs==1&&held.readers==1&&held.disjoint&&!secondary_cache.try_close(),"unknown retains actual working reader/bundle with separate fallback");
  secondary_cache.test_late_complete();auto late=secondary_cache.test_state();must(late.retained&&late.disabled&&late.jobs==0&&late.readers==0&&!secondary_cache.try_close(),"late completion does not republish retained cache");save_result("unknown-after-late",false);save_result("unknown-next",true);hip_ok(hipMemcpyAsync(after.data(),reinterpret_cast<void*>(late.working),after.size(),hipMemcpyDeviceToHost,reinterpret_cast<hipStream_t>(storage.stream())));storage.drain();must(before==after,"retained packed working bytes stable across fallback/late/next");write_file(output/"retained-before.bytes",before);write_file(output/"retained-after.bytes",after);
  std::ofstream control(output/"unknown.tsv");control<<"held\t"<<held.working<<'\t'<<held.working_capacity<<'\t'<<held.fallback<<'\t'<<held.fallback_capacity<<'\t'<<held.readers<<'\t'<<held.jobs<<'\t'<<held.retained<<'\t'<<held.disabled<<'\t'<<held.disjoint<<'\n';control<<"late\t"<<late.working<<'\t'<<late.working_capacity<<'\t'<<late.readers<<'\t'<<late.jobs<<'\t'<<late.retained<<'\t'<<late.disabled<<'\n';control<<"retained\t"<<count.retained_device_bytes<<'\t'<<count.retained_host_bytes<<'\t'<<count.primary_drain_status<<'\t'<<count.secondary_drain_status<<'\n';control<<"RAM\t"<<ram_slots<<'\t'<<ram_slots*65536<<'\n';control<<"actual_driver_fault\t0\n";
  loaded_modules(output);secondary_cache.test_cleanup_proven_idle();must(weight.try_close(),"controlled actual owner close");std::cout<<"{\"source_id\":\""<<T20_SOURCE_ID<<"\",\"controlled_unknown\":true,\"outputs\":4,\"actual_driver_fault\":false,\"whole_task_qualified\":false}\n";return 0;
 }
 std::ofstream stats(output/"stats.tsv");
 auto snapshot=[&](const std::string&name,const cache::SupplyStats&before,const cache::SecondaryStats&cb){auto a=weight.stats();auto c=secondary_cache.stats();stats<<name<<'\t'<<a.weight_read-before.weight_read<<'\t'<<a.weight_h2d-before.weight_h2d<<'\t'<<a.issued_reads-before.issued_reads<<'\t'<<a.gpu_hits-before.gpu_hits<<'\t'<<a.ram_hits-before.ram_hits<<'\t'<<c.hits-cb.hits<<'\t'<<c.fills-cb.fills<<'\t'<<c.snapshot_d2d-cb.snapshot_d2d<<'\t'<<c.fill_bytes-cb.fill_bytes<<'\t'<<c.hit_bytes-cb.hit_bytes<<'\t'<<c.peer_bytes-cb.peer_bytes<<'\t'<<c.bounce_d2h-cb.bounce_d2h<<'\t'<<c.bounce_h2d-cb.bounce_h2d<<'\n';stats.flush();};
 auto evict_primary=[&](bool ram){for(size_t i=0;i<2;++i)must(weight.evict_device(i),"idle Primary eviction");if(ram)weight.evict_ram();};
 struct Case{const char*id;const char*tensor;uint64_t matrix;};
 for(auto job:{Case{"p0","blk.0.ffn_gate_exps.weight",38},Case{"p16","blk.0.attn_kv.weight",0}}){
  auto original=artifact.source_tensor(job.tensor);const auto n=original.span.dims_ggml.at(1);auto y=yspace;y.rows=3;y.columns=n;y.bytes=3*n*4;auto host=read_file<float>(input/(std::string(job.id)+"-x.bin"));must(host.size()==3*5120,"sealed input geometry");storage.upload(x,host.data(),x.bytes);
  auto run=[&](const std::string&name,CoreProjection&projection,uint64_t first){auto label=std::string(job.id)+"-"+name;memory_sample(memory,label+"-before",ram_slots*65536);auto tile=source_tile(original,job.matrix,first,8);hip_ok(hipMemsetAsync(y.data,255,y.bytes,reinterpret_cast<hipStream_t>(storage.stream())));auto w=weight.stats();auto c=secondary_cache.stats();finite_project(projection,tile,x,y,storage.stream());storage.drain();std::vector<float> got(3*8);hip_ok(hipMemcpy2DAsync(got.data(),8*4,(char*)y.data+first*4,n*4,8*4,3,hipMemcpyDeviceToHost,reinterpret_cast<hipStream_t>(storage.stream())));storage.drain();write_file(output/(std::string(job.id)+"-"+name+".bin"),got);snapshot(label,w,c);memory_sample(memory,label+"-after",ram_slots*65536);};
  evict_primary(true);run("ssd",baseline,0);run("local",baseline,0);evict_primary(false);run("ram",baseline,0);
  evict_primary(true);run("fill",cached,0);evict_primary(true);run("secondary",cached,0);
  secondary_cache.cancel_and_drain();run("after-cancel",cached,0);
  evict_primary(true);cache::test_fail_hit_ready_once();run("copy-failed-fallback",cached,0);
  evict_primary(true);run("next-tile",cached,8);evict_primary(true);run("first-again",cached,0);
 }
 auto c=secondary_cache.stats();auto w=weight.stats();stats<<"owned\t"<<storage.explicit_owned_bytes()<<'\t'<<w.device_owned<<'\t'<<c.primary_device_owned<<'\t'<<c.secondary_device_owned<<'\t'<<c.host_owned<<'\t'<<c.metadata<<'\t'<<c.slots<<'\t'<<c.slot_capacity<<'\t'<<c.valid_slots<<'\t'<<c.created_streams<<'\t'<<c.created_events<<'\t'<<w.host_owned<<'\t'<<w.metadata<<'\t'<<ram_slots<<'\t'<<ram_slots*65536<<'\n';
 must(weight.state()==cache::SupplyState::Idle&&secondary_cache.try_close()&&weight.try_close(),"finite actual close");
 HMODULE handles[2048];DWORD needed=0;must(EnumProcessModules(GetCurrentProcess(),handles,sizeof(handles),&needed)&&needed<=sizeof(handles),"module inventory");std::ofstream modules(output/"loaded-modules.txt");for(size_t i=0;i<needed/sizeof(HMODULE);++i){char path[32768]{};must(GetModuleFileNameA(handles[i],path,sizeof(path))>0,"module path");modules<<path<<'\n';}
 std::cout<<"{\"source_id\":\""<<T20_SOURCE_ID<<"\",\"primary\":"<<p<<",\"secondary\":"<<s<<",\"slots\":"<<slots<<",\"outputs\":18,\"GPU_executed\":true,\"whole_task_qualified\":false}\n";return 0;
}
}
int main(int argc,char**argv){try{if(argc==2&&std::string(argv[1])=="--host")return historical_t20_main(1,argv);if(argc==2&&std::string(argv[1])=="--policy"){using namespace strata_ext::cache;unsigned checks=0;for(auto f:{CacheFailure::Allocation,CacheFailure::CopyDrained}){must(cache_recovery(f,0,false,true)==CacheRecovery::Bypass,"safe fallback");++checks;must(cache_recovery(f,-1,false,true)==CacheRecovery::ErrorRetain,"primary unknown");++checks;}for(bool held:{false,true})for(bool separate:{false,true}){must(cache_recovery(CacheFailure::CrossUnknown,0,held,separate)==(held&&separate?CacheRecovery::BypassRetained:CacheRecovery::ErrorRetain),"retained separate buffer");++checks;}for(auto f:{CacheFailure::Source,CacheFailure::Shape,CacheFailure::Primary}){must(cache_recovery(f,0,true,true)==CacheRecovery::Error,"original model error preserved");++checks;}must(cache_recovery(CacheFailure::CrossUnknown,-1,true,true)==CacheRecovery::ErrorRetain,"unknown primary no fallback");++checks;checks+=construction_policy_checks();std::cout<<"{\"ram_slot_metadata_bytes\":"<<sizeof(RamSlotAccounting)<<",\"policy_checks\":"<<checks<<",\"GPU_executed\":false,\"actual_driver_fault\":false}\n";return 0;}must(argc==8||(argc==9&&(std::string(argv[8])=="--measure"||std::string(argv[8])=="--unknown")),"input output primaryPCI secondaryPCI slots auto|bounce RAMpayloadBytes [--measure]");std::string policy=argv[6];must(policy=="auto"||policy=="bounce","copy policy");return unit_fixture(fs::u8path(argv[1]),fs::u8path(argv[2]),argv[3],argv[4],std::stoull(argv[5]),policy=="bounce",std::stoull(argv[7]),argc==9&&std::string(argv[8])=="--measure",argc==9&&std::string(argv[8])=="--unknown");}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}
