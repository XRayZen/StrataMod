unsigned assertions=0;bool retain_owners=false;
template<class T>struct KeepOnFailure {void operator()(T* p)const{if(!retain_owners)delete p;}};
struct OwnedTask {
 std::unique_ptr<d::CopyTask> p;hipStream_t cleanup_stream=nullptr;
 OwnedTask(d::Endpoint a,d::Endpoint b,void* host,uint64_t cap,d::Policy policy):p(new d::CopyTask(a,b,host,cap,policy)),cleanup_stream(b.stream){}
 d::CopyTask& value(){return *p;}
 ~OwnedTask(){if(!p)return;try{if(p->try_close())return;p->cancel();if(p->phase()==d::Phase::Ready)p->consumer_done_on(cleanup_stream);auto end=std::chrono::steady_clock::now()+std::chrono::seconds(5);while(p->phase()!=d::Phase::Done&&p->phase()!=d::Phase::Quarantined&&std::chrono::steady_clock::now()<end){p->poll();SwitchToThread();}if(p->try_close())return;}catch(...){}retain_owners=true;p.release();std::cerr<<"fixture retains undrained task and endpoint owners until child exit\n";}
};
void need(bool b,const char*s){++assertions;if(!b)throw std::runtime_error(s);}
void hip(hipError_t e){if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));}
template<class F>void rejects(F f){try{f();}catch(const std::exception&){++assertions;return;}throw std::runtime_error("expected rejection");}
std::string quote(const std::string& s){std::ostringstream o;o<<'"';for(char x:s){if(x=='"'||x=='\\')o<<'\\';if(x=='\n')o<<"\\n";else o<<x;}o<<'"';return o.str();}
std::vector<uint8_t> read(const fs::path&p){std::ifstream f(p,std::ios::binary);need(bool(f),"expected input open");return {std::istreambuf_iterator<char>(f),{}};}
void write(const fs::path&p,const std::vector<uint8_t>&a,size_t n){std::ofstream f(p,std::ios::binary);f.write(reinterpret_cast<const char*>(a.data()),n);need(bool(f),"actual output write");}
std::string modules(){HMODULE handles[512]{};DWORD bytes=0;need(EnumProcessModules(GetCurrentProcess(),handles,sizeof(handles),&bytes),"loaded module inventory");std::ostringstream o;o<<'[';bool comma=false;for(unsigned i=0;i<bytes/sizeof(HMODULE)&&i<512;++i){wchar_t p[32768]{};if(GetModuleFileNameW(handles[i],p,32768)){if(comma)o<<',';comma=true;o<<quote(fs::path(p).u8string());}}o<<']';return o.str();}
void host(){std::vector<d::Physical> devices(2);devices[0].ordinal=5;devices[0].pci="physical-A";devices[1].ordinal=19;devices[1].pci="physical-B";auto r=d::resolve(devices,"physical-B",std::optional<std::string>{"physical-A"});need(r.primary.ordinal==19&&r.secondary->ordinal==5,"generic role resolution");need(!d::resolve(devices,"physical-A",{}).secondary,"zero secondary");rejects([&]{d::resolve(devices,"missing",{});});rejects([&]{d::resolve(devices,"physical-A",std::optional<std::string>{"physical-A"});});devices.push_back(devices[0]);rejects([&]{d::resolve(devices,"physical-A",{});});for(auto n:{0u,1u,65536u}){d::check_extent(n,65536);++assertions;}rejects([&]{d::check_extent(65537,65536);});rejects([&]{d::check_extent(UINT64_MAX,65536);});c::ResidentSlot slot{4096,65536,123};auto w=c::reserve_fill(slot,123,264);need(bool(w),"slot writer");c::quarantine_resident(*w,123);need(slot.quarantined&&slot.writer&&!c::reserve_fill(slot,123,264)&&!c::borrow_resident(slot,123),"synthetic undrainable slot retains capacity");need(d::return_disposition(0,-1)==d::ReturnDisposition::Recorded,"recorded return adapter");need(d::return_disposition(1,0)==d::ReturnDisposition::Drained,"record failed but actual drain succeeded");need(d::return_disposition(1,1)==d::ReturnDisposition::Retain,"record/drain failed retain");need(d::return_disposition(-1,-1)==d::ReturnDisposition::Retain,"unknown completion retain");std::cout<<"{\"source_id\":"<<quote(T21_SOURCE_ID)<<",\"assertions\":"<<assertions<<",\"metadata_bytes\":"<<d::CopyTask::metadata_bytes()<<",\"GPU_used\":false}";}
struct DeviceOwner {
 int device;std::unique_ptr<strata::core::DeviceArena> arena;strata::core::PinnedRing ring;hipStream_t stream=nullptr,return_stream=nullptr;std::array<c::ResidentSlot,2> slots;uint64_t pinned=0,stage=0,uploaded=0;bool known=true,ring_ready=false;int memory_status=-1;size_t free_bytes=0,total_bytes=0;std::array<std::array<int64_t,4>,4> observations{};
 explicit DeviceOwner(int ordinal):device(ordinal){hip(hipSetDevice(device));memory_status=int(hipMemGetInfo(&free_bytes,&total_bytes));if(memory_status==0)need(free_bytes>2*1024*1024,"small fixture allocation budget");else hipGetLastError();arena=std::make_unique<strata::core::DeviceArena>(131072,device);for(auto& s:slots)s={reinterpret_cast<uintptr_t>(arena->alloc(65536)),65536,reinterpret_cast<uintptr_t>(this)};hip(hipStreamCreateWithFlags(&stream,hipStreamNonBlocking));hip(hipStreamCreateWithFlags(&return_stream,hipStreamNonBlocking));ring.reserve(65536);for(auto& x:observations){void* p=ring.acquire(65536);x={0,0,-1,-1};if(p){x[0]=reinterpret_cast<intptr_t>(p);x[1]=65536;stage+=65536;hipPointerAttribute_t a{};auto status=hipPointerGetAttributes(&a,p);x[2]=int(status);if(status==hipSuccess){x[3]=int(a.type);if(a.type==hipMemoryTypeHost)pinned+=65536;}else{known=false;hipGetLastError();}hip(ring.submit(reinterpret_cast<void*>(slots[0].address),p,0,stream));}}hip(hipStreamSynchronize(stream));ring_ready=stage==262144;}
 d::Endpoint endpoint(unsigned index){auto& s=slots[index];return {reinterpret_cast<void*>(s.address),s.capacity,device,stream,&s,s.owner,s.generation};}
 void upload(const std::vector<uint8_t>& bytes,size_t n){hip(hipSetDevice(device));auto w=c::reserve_fill(slots[0],slots[0].owner,n);need(bool(w),"fixture source upload writer");hip(ring_ready?ring.h2d(reinterpret_cast<void*>(slots[0].address),bytes.data(),n,stream):strata::core::PinnedRing::direct(reinterpret_cast<void*>(slots[0].address),bytes.data(),n,stream));hip(hipStreamSynchronize(stream));need(c::complete_resident(*w,slots[0].owner,true,true),"fixture source upload event");uploaded+=n;}
 ~DeviceOwner(){hipSetDevice(device);ring.release();if(return_stream)hipStreamDestroy(return_stream);if(stream)hipStreamDestroy(stream);arena.reset();}
};
void until(d::CopyTask& t,d::Phase target){auto end=std::chrono::steady_clock::now()+std::chrono::seconds(30);while(t.phase()!=target){need(std::chrono::steady_clock::now()<end,"fixture completion deadline");t.poll();SwitchToThread();}}
std::string properties(const d::Physical&p){std::ostringstream o;o<<"{\"ordinal\":"<<p.ordinal<<",\"pci\":"<<quote(p.pci)<<",\"property_status\":"<<p.property_status<<",\"name\":"<<(p.property_status?"null":quote(p.name))<<",\"arch\":"<<(p.property_status?"null":quote(p.arch))<<",\"uuid_status\":"<<p.uuid_status<<",\"uuid\":"<<(p.uuid_status?"null":quote(p.uuid))<<",\"luid_status\":"<<p.luid_status<<",\"luid\":"<<(p.luid_status?"null":quote(p.luid))<<'}';return o.str();}
void gpu(const std::string&primary,const std::string&secondary,const fs::path& input,const fs::path&output,const std::string&binding){auto roles=d::resolve(d::inventory(),primary,secondary=="none"?std::optional<std::string>{}:std::optional<std::string>{secondary});std::unique_ptr<std::vector<uint8_t>,KeepOnFailure<std::vector<uint8_t>>> expected_owner(new std::vector<uint8_t>(read(input/"q/expected.bin"))),actual_owner(new std::vector<uint8_t>(65536));auto& expected=*expected_owner;auto& actual=*actual_owner;need(expected.size()==65536,"fixed expected extent");std::vector<std::unique_ptr<DeviceOwner,KeepOnFailure<DeviceOwner>>> owners;owners.emplace_back(new DeviceOwner(roles.primary.ordinal));if(roles.secondary)owners.emplace_back(new DeviceOwner(roles.secondary->ordinal));
 bool forced=std::getenv("STRATA_TEST_PAGEABLE")&&std::getenv("STRATA_TEST_PAGEABLE")[0]=='1';void* bounce=nullptr;bool bounce_pinned=false;int bounce_status=-1,bounce_query_status=-1,bounce_type=-1;if(owners.size()==2&&!forced&&(bounce_status=int(hipHostMalloc(&bounce,65536,hipHostMallocPortable)))==hipSuccess)bounce_pinned=true;else if(owners.size()==2){hipGetLastError();bounce=_aligned_malloc(65536,4096);need(bounce!=nullptr,"pageable bounce allocation");}
 if(bounce){hipPointerAttribute_t attr{};bounce_query_status=int(hipPointerGetAttributes(&attr,bounce));if(bounce_query_status==0)bounce_type=int(attr.type);else hipGetLastError();}
 std::ostringstream cases;unsigned count=0;uint64_t readback=0,upload=0,control_transfer=0,control_d2h=0,control_h2d=0,control_local=0,control_readback=0;const size_t lengths[]={0,1,3,264,4095,4096,65535,65536};
 for(unsigned direction=0;direction<(owners.size()==2?2u:1u);++direction)for(unsigned policy=0;policy<(owners.size()==2?2u:1u);++policy)for(auto n:lengths){auto& src=*owners[direction];auto& dst=*owners[owners.size()==2?1-direction:0];src.upload(expected,std::max(size_t(1),n));upload+=std::max(size_t(1),n);hip(hipSetDevice(dst.device));OwnedTask guard(src.endpoint(0),dst.endpoint(1),bounce,owners.size()==2?65536:0,policy?d::Policy::HostBounce:d::Policy::Auto);auto& task=guard.value();task.submit(n);
  if(n){need(!c::reserve_fill(src.slots[0],src.slots[0].owner,1)&&!c::reserve_fill(dst.slots[1],dst.slots[1].owner,1)&&!task.try_close(),"copy leases prohibit early reuse/close");until(task,d::Phase::Ready);if(owners.size()==2)rejects([&]{task.consumer_done_on(src.stream);});need(!c::reserve_fill(dst.slots[1],dst.slots[1].owner,1),"destination consumer lease");hip(hipMemcpyAsync(actual.data(),reinterpret_cast<void*>(dst.slots[1].address),n,hipMemcpyDeviceToHost,dst.stream));readback+=n;task.consumer_done_on(dst.stream);rejects([&]{task.consumer_done_on(dst.stream);});need(!task.try_close(),"consumer return event retained");until(task,d::Phase::Done);need(std::memcmp(actual.data(),expected.data(),n)==0,"fixture actual arrival byte equality");}
  else need(task.phase()==d::Phase::Done,"zero transfer no traffic");need(task.try_close(),"completed task closed");auto s=task.stats();std::string name="d"+std::to_string(direction)+"p"+std::to_string(policy)+"n"+std::to_string(n);write(output/(name+".bin"),actual,n);if(count++)cases<<',';cases<<"{\"name\":"<<quote(name)<<",\"direction\":"<<direction<<",\"policy\":"<<policy<<",\"bytes\":"<<s.bytes<<",\"path\":"<<quote(s.path)<<",\"peer_bytes\":"<<s.peer_bytes<<",\"local_d2d\":"<<s.local_d2d<<",\"bounce_d2h\":"<<s.bounce_d2h<<",\"bounce_h2d\":"<<s.bounce_h2d<<",\"capability_status\":"<<s.capability_status<<",\"can_access\":"<<s.can_access<<",\"enable_status\":"<<s.enable_status<<",\"peer_copy_status\":"<<s.peer_copy_status<<",\"disable_status\":"<<s.disable_status<<",\"return_record_status\":"<<s.return_record_status<<",\"return_drain_status\":"<<s.return_drain_status<<'}';
 }
 // Cancel before issue and after issue; completion still drains original leases.
 auto& src=*owners[0];auto& dst=*owners[owners.size()-1];src.upload(expected,264);hip(hipSetDevice(dst.device));{OwnedTask guard(src.endpoint(0),dst.endpoint(1),bounce,owners.size()==2?65536:0,d::Policy::HostBounce);auto& t=guard.value();t.cancel();need(t.phase()==d::Phase::Done&&t.stats().cancelled&&t.try_close(),"unissued cancel");}
 OwnedTask cancelled_guard(src.endpoint(0),dst.endpoint(1),bounce,owners.size()==2?65536:0,d::Policy::HostBounce);auto& cancelled=cancelled_guard.value();cancelled.submit(264);cancelled.cancel();until(cancelled,d::Phase::Done);need(cancelled.stats().cancelled&&cancelled.try_close()&&!dst.slots[1].valid,"issued cancel drains without publication");{auto s=cancelled.stats();control_transfer+=s.bytes;control_d2h+=s.bounce_d2h;control_h2d+=s.bounce_h2d;control_local+=s.local_d2d;}
 src.upload(expected,264);hip(hipSetDevice(dst.device));{OwnedTask guard(src.endpoint(0),dst.endpoint(1),bounce,owners.size()==2?65536:0,d::Policy::HostBounce);auto& t=guard.value();t.submit(264);auto live_generation=dst.slots[1].generation;cancelled.poll();need(dst.slots[1].writer&&dst.slots[1].generation==live_generation,"old cancelled completion cannot alter new writer");until(t,d::Phase::Ready);cancelled.poll();need(dst.slots[1].readers==1,"old cancelled completion cannot release new reader");hip(hipMemcpyAsync(actual.data(),reinterpret_cast<void*>(dst.slots[1].address),264,hipMemcpyDeviceToHost,dst.stream));t.consumer_done_on(dst.stream);until(t,d::Phase::Done);need(t.try_close()&&std::memcmp(actual.data(),expected.data(),264)==0,"cancel then exact next operation");auto s=t.stats();control_transfer+=s.bytes;control_d2h+=s.bounce_d2h;control_h2d+=s.bounce_h2d;control_local+=s.local_d2d;control_readback+=264;}
 // Ready cancellation must return the actual (separate same-device) consumer
 // stream even if no new output is wanted. Cancel alone cannot invent completion.
 src.upload(expected,264);hip(hipSetDevice(dst.device));{OwnedTask guard(src.endpoint(0),dst.endpoint(1),bounce,owners.size()==2?65536:0,d::Policy::HostBounce);guard.cleanup_stream=dst.return_stream;auto& t=guard.value();t.submit(264);until(t,d::Phase::Ready);hip(hipMemcpyAsync(actual.data(),reinterpret_cast<void*>(dst.slots[1].address),264,hipMemcpyDeviceToHost,dst.return_stream));t.cancel();need(t.phase()==d::Phase::Ready&&dst.slots[1].readers==1&&!c::reserve_fill(dst.slots[1],dst.slots[1].owner,1)&&!t.try_close(),"Ready cancel retains unknown consumer last use");t.consumer_done_on(dst.return_stream);need(!t.try_close(),"cancelled consumer actual return event retained");until(t,d::Phase::Done);need(t.try_close()&&std::memcmp(actual.data(),expected.data(),264)==0,"Ready cancellation real consumer drain");auto s=t.stats();control_transfer+=s.bytes;control_d2h+=s.bounce_d2h;control_h2d+=s.bounce_h2d;control_local+=s.local_d2d;control_readback+=264;}
 // Distinct descriptors are not proof of physical disjointness. Check actual n
 // bytes, while permitting adjacent bytes despite overlapping capacities.
 hip(hipSetDevice(src.device));for(uint64_t delta:{0u,1u}){auto fake=src.slots[0];fake.address+=delta;fake.capacity-=delta;auto destination=src.endpoint(0);destination.pointer=reinterpret_cast<void*>(fake.address);destination.capacity=fake.capacity;destination.slot=&fake;OwnedTask guard(src.endpoint(0),destination,bounce,65536,d::Policy::Auto);auto& t=guard.value();rejects([&]{t.submit(264);});t.cancel();need(t.try_close(),"overlap rejected before lease/launch");}
 {c::ResidentSlot fake{src.slots[0].address+264,65536,src.slots[0].owner};auto destination=src.endpoint(0);destination.pointer=reinterpret_cast<void*>(fake.address);destination.slot=&fake;destination.generation=fake.generation;OwnedTask guard(src.endpoint(0),destination,bounce,65536,d::Policy::Auto);guard.cleanup_stream=src.return_stream;auto& t=guard.value();t.submit(264);until(t,d::Phase::Ready);hip(hipMemcpyAsync(actual.data(),destination.pointer,264,hipMemcpyDeviceToHost,src.return_stream));t.consumer_done_on(src.return_stream);until(t,d::Phase::Done);need(t.try_close()&&std::memcmp(actual.data(),expected.data(),264)==0,"adjacent actual bytes legal with overlapping capacities");auto s=t.stats();control_transfer+=s.bytes;control_local+=s.local_d2d;control_readback+=264;}
 hip(hipSetDevice(dst.device));
 rejects([&]{auto fake=src.slots[0];fake.capacity=UINT64_MAX;auto bad=src.endpoint(0);bad.capacity=UINT64_MAX;bad.slot=&fake;d::CopyTask t(bad,dst.endpoint(1),bounce,65536,d::Policy::Auto);});rejects([&]{auto bad=src.endpoint(0);bad.generation++;d::CopyTask t(bad,dst.endpoint(1),bounce,65536,d::Policy::Auto);});if(owners.size()==2){rejects([&]{auto bad=src.endpoint(0);bad.stream=dst.stream;d::CopyTask t(bad,dst.endpoint(1),bounce,65536,d::Policy::Auto);});rejects([&]{auto bad=src.endpoint(0);bad.pointer=reinterpret_cast<void*>(dst.slots[0].address);bad.slot=&dst.slots[0];bad.owner=bad.slot->owner;bad.generation=bad.slot->generation;d::CopyTask t(bad,dst.endpoint(1),bounce,65536,d::Policy::Auto);});OwnedTask guard(src.endpoint(0),dst.endpoint(1),bounce,65536,d::Policy::HostBounce);auto& t=guard.value();hip(hipSetDevice(src.device));rejects([&]{t.submit(1);});hip(hipSetDevice(dst.device));t.cancel();need(t.try_close(),"wrong current device then safe close");}
 std::ostringstream pools;for(size_t i=0;i<owners.size();++i){if(i)pools<<',';auto& o=*owners[i];pools<<"{\"device\":"<<o.device<<",\"memory_status\":"<<o.memory_status<<",\"free_bytes\":"<<(o.memory_status==0?std::to_string(o.free_bytes):"null")<<",\"device_bytes\":"<<o.arena->capacity()<<",\"stage_bytes\":"<<o.stage<<",\"pinned_subset\":"<<(o.known?std::to_string(o.pinned):"null")<<",\"stages\":[";for(unsigned j=0;j<4;++j){if(j)pools<<',';auto x=o.observations[j];pools<<'['<<x[0]<<','<<x[1]<<','<<(x[2]<0?"null":std::to_string(x[2]))<<','<<(x[3]<0?"null":std::to_string(x[3]))<<']';}pools<<"]}";}
 if(bounce&&!retain_owners){if(bounce_pinned)hip(hipHostFree(bounce));else _aligned_free(bounce);}std::cout<<"{\"source_id\":"<<quote(T21_SOURCE_ID)<<",\"binding\":"<<quote(binding)<<",\"primary\":"<<properties(roles.primary)<<",\"secondary\":"<<(roles.secondary?properties(*roles.secondary):"null")<<",\"cases\":["<<cases.str()<<"],\"pools\":["<<pools.str()<<"],\"fixture_readback\":"<<readback<<",\"fixture_upload\":"<<upload<<",\"bounce_bytes\":"<<(owners.size()==2?65536:0)<<",\"bounce_pinned\":"<<(bounce_pinned?"true":"false")<<",\"bounce_allocation_status\":"<<bounce_status<<",\"bounce_query_status\":"<<(bounce_query_status<0?"null":std::to_string(bounce_query_status))<<",\"bounce_memory_type\":"<<(bounce_type<0?"null":std::to_string(bounce_type))<<",\"host_expected_readback\":131072,\"copy_metadata_bytes\":"<<d::CopyTask::metadata_bytes()<<",\"control_fixture_upload\":"<<(owners[0]->uploaded+(owners.size()==2?owners[1]->uploaded:0)-upload)<<",\"control_transfer_bytes\":"<<control_transfer<<",\"control_bounce_d2h\":"<<control_d2h<<",\"control_bounce_h2d\":"<<control_h2d<<",\"control_local_d2d\":"<<control_local<<",\"control_readback\":"<<control_readback<<",\"cancel_drain_next\":true,\"late_completion_next\":true,\"Ready_cancel_last_use\":true,\"overlap_actual_bytes_checked\":true,\"loaded_modules\":"<<modules()<<",\"physical_driver_peak\":null,\"assertions\":"<<assertions<<'}';
