int main(int argc,char**argv){try{if(argc==2&&std::string(argv[1])=="--identity"){std::cout<<"{\"source_id\":"<<quote(T21_SOURCE_ID)<<'}';return 0;}if(argc==2&&std::string(argv[1])=="--host"){host();return 0;}if(argc==7&&std::string(argv[1])=="--gpu"){fs::create_directories(fs::u8path(argv[5]));gpu(argv[2],argv[3],fs::u8path(argv[4]),fs::u8path(argv[5]),argv[6]);return 0;}throw std::runtime_error("explicit mode required");}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}
