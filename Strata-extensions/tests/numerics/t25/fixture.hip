#include "engram_forward.hpp"
#include "core.hpp"
#include "engram.hpp"
#include <hip/hip_runtime.h>
#include <windows.h>
#include <psapi.h>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <sstream>
#include <memory>
#include <numeric>
using namespace strata_ext;
using namespace deepseek41;
namespace fs=std::filesystem;
void need(bool v,const char*s){if(!v)throw std::runtime_error(s);}
void hip(hipError_t e){if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));}
std::vector<std::string> split(const std::string&line){std::stringstream s(line);std::string x;std::vector<std::string> out;while(std::getline(s,x,'\t'))out.push_back(x);return out;}
std::vector<uint8_t> read(const fs::path&p){std::ifstream f(p,std::ios::binary|std::ios::ate);need(bool(f),"input absent");auto n=f.tellg();need(n>=0,"input size");std::vector<uint8_t> b(size_t(n),0);f.seekg(0);f.read((char*)b.data(),n);need(bool(f),"short read");return b;}
void write(const fs::path&p,const void*x,size_t n){std::ofstream f(p,std::ios::binary);f.write((const char*)x,n);need(bool(f),"output short");}
std::string quote(std::string s){std::string r="\"";for(char c:s){if(c=='\\'||c=='\"')r+='\\';r+=c;}return r+'\"';}
std::string modules(){HMODULE h[2048];DWORD n;need(EnumProcessModules(GetCurrentProcess(),h,sizeof(h),&n)&&n<=sizeof(h),"module query");std::ostringstream s;s<<'[';for(unsigned i=0;i<n/sizeof(HMODULE);++i){char p[32768];need(GetModuleFileNameA(h[i],p,sizeof(p))!=0,"module path");if(i)s<<',';s<<quote(p);}return s.str()+']';}
Artifact index(const fs::path&p){SourceSet set;std::ifstream sf(p/"sources.tsv");std::string line;while(std::getline(sf,line)){auto v=split(line);need(v.size()==5,"source fields");SourceFile s;s.shard_index=std::stoul(v[0]);s.original_size=std::stoull(v[1]);s.lfs_sha256=v[2];s.revision=v[3];s.original_path=fs::u8path(v[4]);if(set.root.empty())set.root=s.original_path.parent_path();set.files.push_back(s);}std::vector<artifact::PrefixIndex> ps;std::ifstream pf(p/"prefixes.tsv");fs::path first;while(std::getline(pf,line)){auto v=split(line);need(v.size()==2,"prefix fields");auto path=fs::u8path(v[1]);if(first.empty())first=path;ps.push_back(artifact::inspect_prefix(path,std::stoull(v[0])));}return {artifact::merge_prefixes(ps),inspect_metadata(first),set};}
struct Buffer {void*p=nullptr;size_t bytes;quant::ProjectionLease lease;int device;Buffer(size_t n,int d):bytes(n),device(d){hip(hipMalloc(&p,n));}~Buffer(){if(p)hipFree(p);}DeviceView view(uint64_t r,uint64_t c,DeviceScalar t){return checked_device_view(p,bytes,r,c,t,device,lease);}};
struct Pool {int device;hipStream_t stream;std::vector<std::unique_ptr<Buffer>> buffers;uint64_t bytes=0;~Pool(){if(hipStreamSynchronize(stream)!=hipSuccess){for(auto&b:buffers)(void)b.release();}}Buffer&make(size_t n){auto b=std::make_unique<Buffer>(n,device);bytes+=n;buffers.push_back(std::move(b));return *buffers.back();}};
void upload(Buffer&b,const fs::path&p,hipStream_t s){auto x=read(p);need(x.size()==b.bytes,"upload exact bytes");hip(hipMemcpyAsync(b.p,x.data(),x.size(),hipMemcpyHostToDevice,s));hip(hipStreamSynchronize(s));}
void download(const fs::path&p,const void*x,size_t n,hipStream_t s){std::vector<uint8_t>b(n);hip(hipMemcpyAsync(b.data(),x,n,hipMemcpyDeviceToHost,s));hip(hipStreamSynchronize(s));write(p,b.data(),n);}
// Fixture-only logical payload observer; unfilled ring tail remains unread.
struct ActualAudit:DeviceAudit {
 fs::path dir;uint64_t pos=0,bytes=0,frames=0;uint32_t layer=0;std::vector<std::string> records,names;
 void frame(uint64_t p,uint32_t l)override{pos=p;layer=l;++frames;names.clear();fs::create_directories(dir/("P"+std::to_string(pos))/("L"+std::to_string(layer)));}
 void stage(const std::string&n,const DeviceView&v,void*s)override{
  need(std::find(names.begin(),names.end(),n)==names.end(),"duplicate stage");names.push_back(n);auto r=n=="attention_window"?std::min<uint64_t>(pos+1,128):v.rows;auto count=r*v.columns*scalar_bytes(v.scalar);need(r<=v.rows&&count<=v.bytes,"logical audit extent");download(dir/("P"+std::to_string(pos))/("L"+std::to_string(layer))/(n+".bin"),v.data,count,reinterpret_cast<hipStream_t>(s));bytes+=count;
  std::ostringstream j;j<<"{\"position\":"<<pos<<",\"layer\":"<<layer<<",\"name\":"<<quote(n)<<",\"rows\":"<<r<<",\"columns\":"<<v.columns<<",\"scalar\":"<<int(v.scalar)<<",\"bytes\":"<<count<<",\"capacity\":"<<v.bytes<<'}';records.push_back(j.str());
 }
};
std::vector<float> floats(const fs::path&p){auto b=read(p);need(b.size()%4==0,"float bytes");std::vector<float>r(b.size()/4);std::memcpy(r.data(),b.data(),b.size());return r;}
int restore_run(const fs::path&in,const fs::path&out,const std::string&physical,Artifact&a){
 int count=0,dev=-1;hip(hipGetDeviceCount(&count));for(int i=0;i<count;++i){char p[64];hip(hipDeviceGetPCIBusId(p,sizeof(p),i));if(physical==p)dev=i;}need(dev>=0,"restore PCI");hip(hipSetDevice(dev));hipDeviceProp_t prop{};hip(hipGetDeviceProperties(&prop,dev));
 CoreStorage owner(dev);auto stream=owner.stream();auto hs=reinterpret_cast<hipStream_t>(stream);CoreConfig cfg;cfg.device=dev;cfg.active_batch=1;cfg.tile_rows=64;cfg.tile_bytes=2*1024*1024;
 auto make=[&](const std::string&n,uint64_t r,uint64_t c,DeviceScalar t=DeviceScalar::Float32){return owner.allocate(n,r,c,t);};auto input=make("restore-input",1,5120,DeviceScalar::Bfloat16InFloat32);auto norm=make("restore-norm",1,512);auto raw=make("restore-packed",1,2*1024*1024,DeviceScalar::UInt8);
 auto constant=a.source_tensor("blk.2.attn_compressor_norm.weight");artifact::FixtureView cv{constant.source.original_path,0,constant.source.original_size};auto nw=cv.read_exact(constant.span.absolute_offset,constant.span.bytes);owner.upload(norm,nw.data(),nw.size());CoreConstant nc{constant,norm};
 CompressionWorkspace w;w.kv_dot=make("restore-kv",1,512);w.gate_dot=make("restore-score",1,512);w.pooled=make("restore-pool",1,512);w.pooled_bf16=make("restore-pool-bf",1,512,DeviceScalar::Bfloat16InFloat32);w.latent=make("restore-latent",1,512,DeviceScalar::Bfloat16InFloat32);w.position=make("restore-position",1,1,DeviceScalar::Int64);w.frequencies=make("restore-frequency",1,32);w.rotated=make("restore-rotated",1,512,DeviceScalar::Bfloat16InFloat32);w.quantized=make("restore-quantized",1,512,DeviceScalar::Bfloat16InFloat32);
 CompressionState state;state.writer=2;state.ratio=2;state.epoch=1;state.pending_kv=make("restore-pending-kv",1,1024);state.pending_score=make("restore-pending-score",1,1024);state.cache=make("restore-cache",2,512,DeviceScalar::Bfloat16InFloat32);
 uint64_t readbytes=0;DeviceProject project=[&](const SourceTile&t,const DeviceView&x,const DeviceView&y,uint64_t batch,void*s){auto expected=source_tile(t.original,t.matrix,t.row_first,t.row_count);need(t.absolute_offset==expected.absolute_offset&&t.bytes==expected.bytes&&t.bytes<=raw.bytes,"restore original rowtile");artifact::FixtureView view{t.original.source.original_path,0,t.original.source.original_size};auto bytes=view.read_exact(t.absolute_offset,t.bytes);owner.upload(raw,bytes.data(),bytes.size());auto p=quant::checked_projection_strided({(uint8_t*)raw.data,t.original.span.type_id,size_t(t.row_count),size_t(x.columns),size_t(t.bytes),dev},(float*)x.data,x.bytes,(float*)y.data+t.row_first,y.bytes-t.row_first*4,y.columns,s,owner.lease());quant::project_into(p,batch);readbytes+=t.bytes;};
 auto A=floats(in/"A.bin"),B=floats(in/"B.bin");need(A.size()==4*5120&&B.size()==A.size(),"restore inputs");
 auto bytes=[&](const DeviceView&v,uint64_t n){std::vector<uint8_t>b(n);if(n)owner.download(v,b.data(),n);return b;};
 auto advance=[&](const std::vector<float>&v,unsigned start,const fs::path&dir){fs::create_directories(dir);std::vector<uint8_t>latent,rotated;for(unsigned p=start;p<4;++p){owner.upload(input,v.data()+p*5120,5120*4);if(compression_latent_device(a,input,state,w,nc,1,cfg,stream,project)){auto b=bytes(w.latent,2048);latent.insert(latent.end(),b.begin(),b.end());compression_publish_device(state,w,1,stream);b=bytes(w.rotated,2048);rotated.insert(rotated.end(),b.begin(),b.end());}}owner.drain();auto cache=bytes(state.cache,state.published_rows*2048);write(dir/"cache.bin",cache.data(),cache.size());write(dir/"latent.bin",latent.data(),latent.size());write(dir/"rotated.bin",rotated.data(),rotated.size());need(state.position==4&&state.published_rows==2,"restore final state");return cache;};
 struct Snapshot{CompressionState metadata;std::vector<uint8_t>kv,score,cache;uint64_t offset=0;};unsigned negatives=0;uint64_t saved_total=0;std::ostringstream cases;cases<<'[';
 for(unsigned checkpoint:{1,2}){state.position=state.published_rows=0;state.valid=true;for(auto v:{state.pending_kv,state.pending_score,state.cache})hip(hipMemsetAsync(v.data,0,v.bytes,hs));for(unsigned p=0;p<checkpoint;++p){owner.upload(input,A.data()+p*5120,5120*4);if(compression_latent_device(a,input,state,w,nc,1,cfg,stream,project))compression_publish_device(state,w,1,stream);}owner.drain();Snapshot snap{state,{},{},{},0};if(checkpoint%2){snap.kv=bytes(state.pending_kv,2048);snap.score=bytes(state.pending_score,2048);}if(state.published_rows)snap.cache=bytes(state.cache,state.published_rows*2048);saved_total+=snap.kv.size()+snap.score.size()+snap.cache.size();auto dir=out/("cp"+std::to_string(checkpoint));fs::create_directories(dir);write(dir/"snapshot-kv.bin",snap.kv.data(),snap.kv.size());write(dir/"snapshot-score.bin",snap.score.data(),snap.score.size());write(dir/"snapshot-cache.bin",snap.cache.data(),snap.cache.size());
  auto same_view=[&](const DeviceView&v,const DeviceView&expected){need(v.data==expected.data&&v.bytes==expected.bytes&&v.rows==expected.rows&&v.columns==expected.columns&&v.scalar==expected.scalar&&v.device==expected.device&&v.owner==expected.owner&&v.generation==expected.generation,"restore exact operational descriptor");validate_device_view(v,dev);};
  auto validate=[&](const Snapshot&s){need(s.metadata.writer==2&&s.metadata.ratio==2&&s.metadata.epoch==1&&s.metadata.valid&&s.metadata.position==checkpoint&&s.metadata.published_rows==checkpoint/2&&s.offset==0,"restore metadata/source/extent");need(s.kv.size()==(checkpoint%2?2048:0)&&s.score.size()==s.kv.size()&&s.cache.size()==(checkpoint/2)*2048,"restore required exact payload");same_view(s.metadata.pending_kv,snap.metadata.pending_kv);same_view(s.metadata.pending_score,snap.metadata.pending_score);same_view(s.metadata.cache,snap.metadata.cache);};
  auto restore=[&](const Snapshot&s,bool payload=true){validate(s);owner.drain();state=s.metadata;if(payload){if(!s.kv.empty()){owner.upload(state.pending_kv,s.kv.data(),s.kv.size());owner.upload(state.pending_score,s.score.data(),s.score.size());}if(!s.cache.empty())owner.upload(state.cache,s.cache.data(),s.cache.size());}owner.drain();};
  for(unsigned n=0;n<10;++n){auto wrong=snap;if(n==0)wrong.metadata.writer=8;if(n==1)wrong.metadata.ratio=1;if(n==2)wrong.metadata.epoch=2;if(n==3)++wrong.metadata.position;if(n==4)++wrong.metadata.published_rows;if(n==5)wrong.metadata.valid=false;if(n==6)wrong.offset=4;if(n==7){if(checkpoint==1)wrong.kv.clear();else wrong.cache.clear();}if(n==8)wrong.score.push_back(0);if(n==9)wrong.metadata.cache.data=(char*)wrong.metadata.cache.data+4;bool rejected=false;try{restore(wrong);}catch(const std::exception&){rejected=true;}need(rejected,"restore bad snapshot accepted");++negatives;}
  for(unsigned view=0;view<3;++view)for(unsigned field=0;field<8;++field){auto wrong=snap;auto&v=view==0?wrong.metadata.pending_kv:view==1?wrong.metadata.pending_score:wrong.metadata.cache;if(field==0)v.data=(char*)v.data+4;if(field==1)--v.bytes;if(field==2)++v.rows;if(field==3)--v.columns;if(field==4)v.scalar=DeviceScalar::UInt8;if(field==5)++v.device;if(field==6)v.owner=nullptr;if(field==7)++v.generation;bool rejected=false;try{restore(wrong);}catch(const std::exception&){rejected=true;}need(rejected,"restore changed descriptor accepted");++negatives;}
  auto direct=advance(A,checkpoint,dir/"direct");restore(snap);auto branch=advance(B,checkpoint,dir/"branch");need(direct!=branch,"restore divergent branch");
  if(checkpoint==1){hip(hipMemsetAsync(state.pending_kv.data,0,2048,hs));hip(hipMemsetAsync(state.pending_score.data,0,2048,hs));need(bytes(state.pending_kv,2048)!=snap.kv&&bytes(state.pending_score,2048)!=snap.score,"pending live mutation");}else{hip(hipMemsetAsync(state.cache.data,0,2048,hs));need(bytes(state.cache,2048)!=snap.cache,"cache live mutation");}
  restore(snap,false);auto omitted=advance(A,checkpoint,dir/"metadata-only");need(omitted!=direct,"payload omission must be numeric");restore(snap);auto restored=advance(A,checkpoint,dir/"restored");need(restored==direct,"deep restored continuation");if(checkpoint>1)cases<<',';cases<<"{\"checkpoint\":"<<checkpoint<<",\"saved_bytes\":"<<(snap.kv.size()+snap.score.size()+snap.cache.size())<<",\"live_mutated\":true,\"metadata_only_differs\":true,\"branch_differs\":true,\"restored_equal\":true}";
 }cases<<']';owner.drain();std::cout<<"{\"source_id\":"<<quote(T25_SOURCE_ID)<<",\"PCI\":"<<quote(physical)<<",\"ordinal\":"<<dev<<",\"arch\":"<<quote(prop.gcnArchName)<<",\"cases\":"<<cases.str()<<",\"native_rejections\":"<<negatives<<",\"snapshot_total_bytes\":"<<saved_total<<",\"explicit_device_owned\":"<<owner.explicit_owned_bytes()<<",\"weight_read\":"<<readbytes<<",\"loaded_modules\":"<<modules()<<",\"normal_snapshot_API_added\":false}";return 0;
}
int actual_run(const fs::path&in,const fs::path&out,const std::string&physical,Artifact&a){
 int devices=0,dev=-1;hipDeviceProp_t prop{};hip(hipGetDeviceCount(&devices));for(int i=0;i<devices;++i){char p[64];hip(hipDeviceGetPCIBusId(p,sizeof(p),i));if(physical==p){dev=i;hip(hipGetDeviceProperties(&prop,i));}}need(dev>=0,"actual exact PCI");hip(hipSetDevice(dev));size_t free=0,total=0;auto status=hipMemGetInfo(&free,&total);
 std::ifstream prefix(in/"prefixes.tsv");std::string line;need(bool(std::getline(prefix,line)),"metadata prefix");auto ec=engram::inspect_metadata(fs::u8path(split(line).at(1)));std::ifstream jobs(in/"actual-jobs.tsv");std::ostringstream receipts;receipts<<'[';unsigned cases=0,calls=0,frames=0,rejections=0;uint64_t peak=0;
 while(std::getline(jobs,line)){
  auto v=split(line);need(v.size()==6,"actual case fields");unsigned first=std::stoul(v[1]),end=std::stoul(v[2]);std::vector<unsigned>tokens;std::stringstream ts(v[4]);std::string token;while(std::getline(ts,token,','))tokens.push_back(std::stoul(token));need(tokens.size()==3,"three positions");auto dir=out/v[0];fs::create_directories(dir);ActualAudit audit;audit.dir=dir;
  cache::SupplyConfig wc;wc.device=dev;wc.weight_capacity=2*1024*1024;wc.input_capacity=32768*4;wc.output_capacity=32768*4;wc.permit_only=true;auto weight=std::make_unique<cache::PrimarySupply>(wc);cache::RowConfig rc;rc.device_slots=2;rc.ram_slots=2;rc.request_slots=4;rc.wave_requests=1;rc.device=dev;auto source=a.source_tensor("per_layer_token_embd.weight").source;cache::RowSourceViews views({{source,{source.original_path,0,source.original_size}}});auto rows=std::make_unique<cache::RowSupply>(rc,a,std::move(views));measurement::Identity id;id.fixture_sha256=T25_SOURCE_ID;id.asset_sha256=T25_SOURCE_ID;id.bundle_sha256=T25_SOURCE_ID;id.request_id=v[0];id.epoch=cases+1;CoreConfig cfg;cfg.device=dev;cfg.active_batch=1;cfg.audit=&audit;auto sequence=std::make_unique<CoreSequence>(a,ec,*weight,*rows,id,cfg,3);unsigned rejected=0;
  auto reject=[&](auto call){bool no=false;try{call();}catch(const std::exception&){no=true;}need(no,"malformed boundary accepted");++rejected;};
  try{
   auto h=floats(in/(v[5]+"-P0-h.bin")),pre=floats(in/(v[5]+"-P0-pre.bin"));reject([&]{sequence->audit_layers(first,end,tokens[0],1,h,pre);});auto short_h=h;short_h.pop_back();reject([&]{sequence->audit_layers(first,end,tokens[0],0,short_h,pre);});auto nonbf=h;uint32_t bits;std::memcpy(&bits,&nonbf[0],4);bits|=1;std::memcpy(&nonbf[0],&bits,4);reject([&]{sequence->audit_layers(first,end,tokens[0],0,nonbf,pre);});auto badpre=pre;badpre[0]=std::numeric_limits<float>::infinity();reject([&]{sequence->audit_layers(first,end,tokens[0],0,h,badpre);});
   for(unsigned p=0;p<3;++p){h=floats(in/(v[5]+"-P"+std::to_string(p)+"-h.bin"));pre=floats(in/(v[5]+"-P"+std::to_string(p)+"-pre.bin"));if(p==1)reject([&]{sequence->audit_layers(first,end-1,tokens[p],p,h,pre);});auto capture=sequence->audit_layers(first,end,tokens[p],p,h,pre);need(capture.position==p&&capture.first==first&&capture.end==end&&sequence->position()==p+1,"returned state");auto pd=dir/("P"+std::to_string(p));write(pd/"capture-residual.bin",capture.residual.data(),capture.residual.size()*4);write(pd/"capture-pre.bin",capture.pre.data(),capture.pre.size()*4);++calls;peak=std::max(peak,sequence->explicit_device_owned());}
   reject([&]{sequence->audit_layers(first,end,tokens.back(),3,h,pre);});hip(hipDeviceSynchronize());need(weight->try_close()&&rows->try_close(),"owners not drained");
  }catch(...){(void)sequence.release();(void)weight.release();(void)rows.release();throw;} // keep owners alive when completion is unknown
  auto ws=weight->stats();auto rs=rows->stats();if(cases)receipts<<',';receipts<<"{\"name\":"<<quote(v[0])<<",\"calls\":3,\"frames\":"<<audit.frames<<",\"rejections\":"<<rejected<<",\"device_owned\":"<<sequence->explicit_device_owned()<<",\"weight_device_owned\":"<<ws.device_owned<<",\"row_device_owned\":"<<rs.device_owned<<",\"weight_read\":"<<ws.weight_read<<",\"weight_H2D\":"<<ws.weight_h2d<<",\"row_read\":"<<rs.logical_read<<",\"row_H2D\":"<<rs.weight_h2d<<",\"audit_D2H\":"<<audit.bytes<<",\"stages\":[";for(size_t i=0;i<audit.records.size();++i){if(i)receipts<<',';receipts<<audit.records[i];}receipts<<"]}";frames+=audit.frames;rejections+=rejected;++cases;
 }
 receipts<<']';need(cases==9&&calls==27&&frames==81&&rejections==54,"finite coverage");std::cout<<"{\"source_id\":"<<quote(T25_SOURCE_ID)<<",\"PCI\":"<<quote(physical)<<",\"ordinal\":"<<dev<<",\"arch\":"<<quote(prop.gcnArchName)<<",\"meminfo_status\":"<<int(status)<<",\"meminfo_free\":"<<(status==hipSuccess?std::to_string(free):"null")<<",\"cases\":"<<cases<<",\"calls\":"<<calls<<",\"frames\":"<<frames<<",\"rejections\":"<<rejections<<",\"explicit_device_peak\":"<<peak<<",\"jobs\":"<<receipts.str()<<",\"loaded_modules\":"<<modules()<<",\"normal_audit_D2H\":false,\"whole_T25\":false}";return 0;
}
int main(int argc,char**argv){try{
 need(argc>=2,"mode");std::string mode=argv[1];if(mode=="--identity"){std::cout<<"{\"source_id\":"<<quote(T25_SOURCE_ID)<<"}";return 0;}
 need(argc>=4,"inputs outputs");auto in=fs::u8path(argv[2]),out=fs::u8path(argv[3]);fs::create_directories(out);auto a=index(in);
 if(mode=="--restore"){need(argc==5,"restore args");return restore_run(in,out,argv[4],a);}
 if(mode=="--actual"){need(argc==5,"actual args");return actual_run(in,out,argv[4],a);}
 if(mode=="--host"){unsigned checks=0;for(auto l:{1,14}){auto s=a.source_tensor("blk."+std::to_string(l)+".engram_kv.weight");need(s.span.type_id==8&&s.span.dims_ggml==std::vector<uint64_t>({6144,25600})&&s.span.bytes==167116800,"original KV");++checks;auto g=a.source_tensor("blk."+std::to_string(l)+".engram_gate.weight");need(g.span.type_id==0&&g.span.bytes==81920,"original gate");++checks;auto row=a.engram_row(l,0,0);need(row.bytes==264&&row.original.source.shard_index==8,"original row");++checks;}std::cout<<"{\"assertions\":"<<checks<<",\"source_id\":"<<quote(T25_SOURCE_ID)<<",\"GPU_used\":false}";return 0;}
 need(mode=="--run"&&argc==5,"run args");int count=0;hip(hipGetDeviceCount(&count));int dev=-1;hipDeviceProp_t prop{};char pci[64]={};for(int d=0;d<count;++d){hip(hipDeviceGetPCIBusId(pci,sizeof(pci),d));if(std::string(pci)==argv[4]){dev=d;hip(hipGetDeviceProperties(&prop,d));break;}}need(dev>=0,"exact physical PCI missing");hip(hipSetDevice(dev));size_t free=0,total=0;auto memstatus=hipMemGetInfo(&free,&total);hipStream_t stream=nullptr;hip(hipStreamCreateWithFlags(&stream,hipStreamNonBlocking));
 struct StreamGuard{hipStream_t s;~StreamGuard(){if(s){hipStreamSynchronize(s);hipStreamDestroy(s);}}} guard{stream};
 std::ifstream jobs(in/"jobs.tsv");std::string line;std::ostringstream receipts;receipts<<'[';bool first=true;unsigned cases=0;uint64_t peak=0;
 while(std::getline(jobs,line)){
  auto v=split(line);need(v.size()==7,"job fields");std::string name=v[0],kind=v[1];unsigned layer=std::stoul(v[2]),b=std::stoul(v[3]);auto dir=out/name;fs::create_directory(dir);Pool pool{dev,stream};
  auto&h=pool.make(b*20480*4);auto&weight=pool.make(81920);auto&mask=pool.make(b);auto&kv=pool.make(b*25600*4);auto&g=pool.make(b*4*4);auto&output=pool.make(b*20480*4);upload(h,in/(name+"-h.bin"),stream);upload(weight,fs::u8path(v[5]),stream);upload(mask,in/(name+"-mask.bin"),stream);
  auto hv=h.view(b,20480,DeviceScalar::Bfloat16InFloat32),wv=weight.view(4,5120,DeviceScalar::Float32),mv=mask.view(b,1,DeviceScalar::UInt8),kvv=kv.view(b,25600,DeviceScalar::Bfloat16InFloat32),gv=g.view(b,4,DeviceScalar::Float32),ov=output.view(b,20480,DeviceScalar::Bfloat16InFloat32);
  EngramAuditViews audit;DeviceView*traces[]={&audit.inverse_h,&audit.inverse_key,&audit.dot,&audit.signed_sqrt,&audit.sum_h,&audit.sum_key,&audit.weighted_dot};const char*names[]={"inverse_h","inverse_key","z","root","sum_h","sum_key","weighted_dot"};for(auto*t:traces)*t=pool.make(b*4*4).view(b,4,DeviceScalar::Float32);
  uint64_t readbytes=0,h2d=0;unsigned tiles=0;
  if(kind=="real"){
